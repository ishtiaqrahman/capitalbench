---
interface Props {
  profile: any;
  closestPeerLabel?: string | null;
}

const { profile, closestPeerLabel = null } = Astro.props;
const behavior = profile.behavior;
const behaviorV2 = behavior?.behavior_v2;
const behaviorPills = Array.isArray(behaviorV2?.pills) ? behaviorV2.pills : [];
const decisionProcess = behaviorV2?.decision_process ?? {};
const hasDecisionProcess = Number(decisionProcess.structured_candidate_coverage_count ?? 0) > 0;
const riskAppetite = profile.fingerprint.riskAppetite;

function pct(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  return `${value.toFixed(Math.abs(value) >= 1 ? 1 : 2)}%`;
}

function number(value: number | null | undefined): string {
  return value === null || value === undefined || !Number.isFinite(value) ? "n/a" : value.toFixed(1);
}

function score100(value: number | null | undefined): string {
  return value === null || value === undefined || !Number.isFinite(value) ? "n/a" : `${value.toFixed(1)} / 100`;
}

function similarity(value: number | null | undefined): string {
  return value === null || value === undefined || !Number.isFinite(value) ? "n/a" : pct(value * 100);
}

function ratioPct(value: number | null | undefined): string {
  return value === null || value === undefined || !Number.isFinite(value) ? "n/a" : pct(value * 100);
}

function coverage(count: number | null | undefined, total: number | null | undefined): string {
  return typeof count === "number" && Number.isFinite(count) && typeof total === "number" && Number.isFinite(total)
    ? `${count}/${total}`
    : "n/a";
}

function riskScore(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  const rounded = Math.round((value + Number.EPSILON * Math.abs(value)) * 100) / 100;
  return `${rounded.toFixed(2)} / 5`;
}

function riskScoreShort(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  const rounded = Math.round((value + Number.EPSILON * Math.abs(value)) * 100) / 100;
  return rounded.toFixed(2);
}

function riskWidth(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "0%";
  return `${Math.min(100, Math.max(0, value)).toFixed(2)}%`;
}

const behaviorMetrics = behavior
  ? [
      {
        label: "Risk taking",
        value: score100(behavior.metrics.average_risk_pulse),
        detail: "0 defensive to 100 aggressive"
      },
      {
        label: "Typical largest position",
        value: pct(behavior.metrics.average_top_allocation_pct),
        detail: "average top holding"
      },
      {
        label: "Similarity to peers",
        value: similarity(behavior.peer.average_peer_similarity),
        detail: closestPeerLabel ? `closest to ${closestPeerLabel}` : "average portfolio overlap"
      },
      {
        label: "Portfolio turnover",
        value: pct(behavior.turnover.average_turnover_pct),
        detail: "average change between rounds"
      }
    ]
  : [];
---

<section class="section model-fingerprint model-pattern-priority" id="model-fingerprint" aria-labelledby="model-fingerprint-title">
  <div class="model-section-heading">
    <div>
      <span class="panel-kicker">Portfolio pattern</span>
      <h2 id="model-fingerprint-title">How Does This Model Tend To Invest?</h2>
    </div>
    <p>
      Calculated from eligible official saved portfolios using same-round peer comparisons.
      <a href="/models/patterns/#methodology">How labels and pills are determined</a>
    </p>
  </div>

  <div class="model-fingerprint-summary" aria-label={`${profile.label} portfolio pattern sample summary`}>
    <div>
      <span>Saved portfolios</span>
      <strong>{profile.fingerprint.portfolioCount}</strong>
    </div>
    <div>
      <span>Average holdings</span>
      <strong>{number(profile.fingerprint.averageHoldingCount)}</strong>
    </div>
    <div>
      <span>Average largest position</span>
      <strong>{pct(profile.fingerprint.averageTopHoldingPct)}</strong>
    </div>
    <div>
      <span>Most common top holding</span>
      <strong>{profile.fingerprint.mostCommonTopHolding?.label ?? "Not enough data"}</strong>
    </div>
  </div>

  {behavior && (
    <div class="model-strategy-overview">
      <article class="model-behavior-identity">
        <span>Typical approach</span>
        <strong>{behavior.archetype.label}</strong>
        <p>{behavior.archetype.description}</p>
        <small>{behavior.archetype.confidence_label ?? behavior.archetype.confidence} · based on {behavior.sample.portfolio_count} saved portfolios.</small>
        {behaviorPills.length > 0 && (
          <div class="model-behavior-pill-row" aria-label={`${profile.label} behavior evidence`}>
            {behaviorPills.map((pill: any) => <em title={pill.evidence}>{pill.label}</em>)}
          </div>
        )}
      </article>

      <article class="model-behavior-metrics" aria-label={`${profile.label} defining portfolio metrics`}>
        {behaviorMetrics.map((item) => (
          <div>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            <small>{item.detail}</small>
          </div>
        ))}
      </article>

      <article class="model-behavior-comparison">
        <div>
          <span class="metric-label">Compared with other models</span>
          <h3>{closestPeerLabel ? `Most similar to ${closestPeerLabel}` : "Peer comparison building"}</h3>
          <p>
            Average portfolio overlap is {similarity(behavior.peer.average_peer_similarity)} on matching rounds.
            {behavior.peer.outlier_round_count > 0
              ? ` It made an unusually different allocation in ${behavior.peer.outlier_round_count} round${behavior.peer.outlier_round_count === 1 ? "" : "s"}.`
              : " It has not repeatedly stood apart from the group."}
          </p>
        </div>
        <a href="/models/patterns/">Compare every model's pattern</a>
      </article>

      {hasDecisionProcess && (
        <article class="model-decision-process">
          <span class="metric-label">Structured decision process</span>
          <h3>How the model builds its shortlist</h3>
          <p>
            Candidate-ledger evidence is available for {decisionProcess.structured_candidate_coverage_count} of
            {` ${decisionProcess.eligible_portfolio_count}`} eligible portfolios. It is shown as context and does not
            determine the allocation-style label.
          </p>
          <div>
            <span><em>Avg candidates</em><strong>{number(decisionProcess.average_candidate_count)}</strong></span>
            <span><em>SPY included</em><strong>{pct(decisionProcess.sp500_candidate_inclusion_rate_pct)}</strong></span>
            <span><em>Forecast spread</em><strong>{pct(decisionProcess.average_candidate_forecast_range_pct)}</strong></span>
            <span><em>Stated confidence</em><strong>{ratioPct(decisionProcess.average_submission_confidence)}</strong></span>
          </div>
          <small class="model-decision-coverage">
            Coverage — forecasts {coverage(decisionProcess.candidate_forecast_coverage_count, decisionProcess.eligible_portfolio_count)} ·
            confidence {coverage(decisionProcess.submission_confidence_coverage_count, decisionProcess.eligible_portfolio_count)} ·
            key risks {coverage(decisionProcess.key_risk_coverage_count, decisionProcess.eligible_portfolio_count)}
          </small>
        </article>
      )}
    </div>
  )}

  <div class="model-fingerprint-grid model-fingerprint-grid-priority">
    <article class={`model-risk-panel model-risk-${profile.provider}`}>
      <div class="model-risk-copy">
        <span class="metric-label">Overall risk appetite</span>
        <h3>{riskAppetite.label}</h3>
        <p>{riskAppetite.description}</p>
      </div>
      <div class="model-risk-visual" aria-label={`${profile.label} cumulative risk appetite scale`}>
        <div>
          <strong>{riskScore(riskAppetite.score)}</strong>
          <span>allocation-weighted score</span>
        </div>
        <div class="risk-scale-stage risk-scale-stage-compact" style={`--risk-position: ${riskWidth(riskAppetite.percentile)};`}>
          <div class="risk-axis-rail" aria-hidden="true"></div>
          <a
            class={`risk-axis-marker risk-axis-marker-${profile.provider}`}
            href="#model-fingerprint"
            aria-label={`${profile.label}: ${riskScore(riskAppetite.score)}, ${riskAppetite.label}`}
            title={`${profile.label}: ${riskScore(riskAppetite.score)}, ${riskAppetite.label}`}
            style={`--risk-position: ${riskWidth(riskAppetite.percentile)}; --risk-lane-offset: 0px; --risk-mobile-lane: 76px;`}
          >
            <span class="risk-axis-logo">
              {(profile.iconSrc ?? profile.logoSrc) && <img src={profile.iconSrc ?? profile.logoSrc} alt="" loading="lazy" />}
            </span>
            <span class="risk-axis-marker-label"><strong>{profile.label}</strong><em>{riskScoreShort(riskAppetite.score)}</em></span>
          </a>
          <div class="risk-axis-ticks" aria-hidden="true">
            <span><b>1</b> Defensive</span>
            <span><b>2</b></span>
            <span><b>3</b> Balanced</span>
            <span><b>4</b> Growth</span>
            <span><b>5</b> Aggressive</span>
          </div>
        </div>
      </div>
      <div class="model-risk-breakdown" aria-label="Risk appetite inputs">
        <span><strong>{pct(riskAppetite.highRiskPct)}</strong> high-risk exposure</span>
        <span><strong>{pct(riskAppetite.techPct)}</strong> technology exposure</span>
        <span><strong>{pct(riskAppetite.defensivePct)}</strong> defensive holdings</span>
      </div>
    </article>

    <div class="model-pattern-lists">
      <article class="model-fingerprint-list">
        <span class="metric-label">Most frequently held assets</span>
        {profile.fingerprint.assets.slice(0, 7).map((asset: any) => (
          <div>
            <span><strong>{asset.label}</strong><small>{asset.group}</small></span>
            <em>{pct(asset.frequencyPct)} held</em>
            <b>{pct(asset.averageAllocationPct)} avg</b>
          </div>
        ))}
      </article>

      <article class="model-fingerprint-list compact">
        <span class="metric-label">Average allocation by category</span>
        {profile.fingerprint.categories.slice(0, 7).map((category: any) => (
          <div><span><strong>{category.group}</strong></span><b>{pct(category.averageAllocationPct)}</b></div>
        ))}
      </article>
    </div>
  </div>
</section>
