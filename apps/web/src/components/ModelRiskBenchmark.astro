---
import { ArrowRight, Info } from "lucide-react";
import { buildModelRiskBenchmark } from "../lib/modelRiskBenchmark.js";
import { longMonthDayYear } from "../lib/riskFormatting.js";
import { providerLogoSrc } from "../lib/scoreReturnChart";

interface Props {
  modelBehavior: any;
  variant?: "home" | "full";
}

const { modelBehavior, variant = "home" } = Astro.props;
const benchmark = buildModelRiskBenchmark(modelBehavior);
const hasRows = benchmark.views.some((view) => view.rows.length > 0);
const updatedLabel = longMonthDayYear(benchmark.dataAsOf, "latest official portfolios");

function score(value: number): string {
  return value.toFixed(1);
}

function pct(value: number | null): string {
  return value === null ? "n/a" : `${value.toFixed(1)}%`;
}
---

{hasRows && (
  <section
    class:list={["model-risk-benchmark", `model-risk-benchmark-${variant}`]}
    id="model-risk-benchmark"
    aria-labelledby="model-risk-benchmark-title"
    data-model-risk-benchmark
  >
    <header class="model-risk-benchmark-heading">
      <span class="panel-kicker">Model Risk Benchmark</span>
      <div class="model-risk-benchmark-title-row">
        <h2 id="model-risk-benchmark-title">Which AI models take the most risk?</h2>
        <span
          class="home-info-tip"
          tabindex="0"
          aria-label="This benchmark measures risk in model allocations. A higher score means more risk-seeking, not better performance."
        >
          <Info size={15} aria-hidden="true" />
        </span>
      </div>
      <p>Compare how aggressively each model allocates capital across its official portfolios.</p>
      <div class="model-risk-benchmark-freshness">
        <span>Updated through {updatedLabel}</span>
        <span aria-hidden="true">/</span>
        <strong>Higher means more risk-seeking, not better.</strong>
      </div>
    </header>

    <div class="model-risk-benchmark-tabs" role="tablist" aria-label="Risk benchmark time horizon">
      {benchmark.views.map((view, index) => (
        <button
          type="button"
          role="tab"
          id={`model-risk-tab-${view.key}`}
          aria-controls={`model-risk-panel-${view.key}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-model-risk-tab={view.key}
        >
          {view.label}
        </button>
      ))}
    </div>

    <div class="model-risk-benchmark-board">
      {benchmark.views.map((view, index) => (
        <div
          class="model-risk-benchmark-panel"
          id={`model-risk-panel-${view.key}`}
          role="tabpanel"
          aria-labelledby={`model-risk-tab-${view.key}`}
          hidden={index !== 0}
          data-model-risk-panel={view.key}
        >
          <div class="model-risk-benchmark-axis" aria-hidden="true">
            <span>Model</span>
            <div>
              <span>0 Defensive</span>
              <span>50 Balanced</span>
              <span>100 Aggressive</span>
            </div>
            <span>Risk score</span>
            <span>Allocation evidence</span>
          </div>

          <div class="model-risk-benchmark-rows">
            {view.rows.map((row: any) => (
              <article class="model-risk-benchmark-row">
                <a class="model-risk-benchmark-model" href={row.href}>
                  <span class:list={["model-risk-benchmark-logo", row.provider && `is-${row.provider}`]}>
                    {providerLogoSrc(row.provider) ? (
                      <img src={providerLogoSrc(row.provider)} alt="" width="28" height="28" loading="lazy" />
                    ) : (
                      <span aria-hidden="true">{row.label.slice(0, 1)}</span>
                    )}
                  </span>
                  <span>
                    <strong>{row.label}</strong>
                    <small>{row.providerLabel}</small>
                  </span>
                  {row.earlySample && <em>Early sample</em>}
                </a>

                <div class="model-risk-benchmark-spectrum">
                  <div
                    class="model-risk-benchmark-track"
                    aria-label={`${row.label}: ${score(row.score)} out of 100, ${row.riskLabel}`}
                  >
                    <span class="is-defensive"></span>
                    <span class="is-cautious"></span>
                    <span class="is-balanced"></span>
                    <span class="is-seeking"></span>
                    <span class="is-aggressive"></span>
                    <i style={`--risk-position: ${row.position}%`} aria-hidden="true"><b></b></i>
                  </div>
                  <div class="model-risk-benchmark-mobile-axis" aria-hidden="true">
                    <span>Defensive</span>
                    <span>Balanced</span>
                    <span>Aggressive</span>
                  </div>
                </div>

                <div class="model-risk-benchmark-score">
                  <strong>{score(row.score)}<small>/100</small></strong>
                  <span>{row.riskLabel}</span>
                </div>

                <div class="model-risk-benchmark-evidence">
                  <span>
                    <strong>{row.portfolioCount}</strong>
                    <small>{row.portfolioCount === 1 ? "portfolio" : "portfolios"}</small>
                  </span>
                  <span>
                    <strong>{pct(row.averageTopAllocation)}</strong>
                    <small>largest position</small>
                  </span>
                  <span>
                    <strong>{pct(row.defensiveAllocation)}</strong>
                    <small>defensive assets</small>
                  </span>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <footer class="model-risk-benchmark-footer">
      <p>
        Scores average the risk of each model's official allocations. Largest position and defensive assets show all-portfolio context.
      </p>
      {variant === "home" ? (
        <a class="home-primary-cta" href="/risk-appetite/#model-risk-benchmark">
          Explore the full risk benchmark
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      ) : (
        <a class="home-secondary-cta" href={benchmark.methodologyHref}>Read the risk methodology</a>
      )}
    </footer>
  </section>
)}

<script>
  function bindModelRiskBenchmarks() {
    document.querySelectorAll("[data-model-risk-benchmark]").forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.tabsBound === "true") return;
      root.dataset.tabsBound = "true";

      const tabs = Array.from(root.querySelectorAll("[data-model-risk-tab]"));
      const panels = Array.from(root.querySelectorAll("[data-model-risk-panel]"));

      function activate(key: string, focus = false) {
        tabs.forEach((tab) => {
          if (!(tab instanceof HTMLButtonElement)) return;
          const active = tab.dataset.modelRiskTab === key;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          if (active && focus) tab.focus();
        });
        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.hidden = panel.dataset.modelRiskPanel !== key;
        });
      }

      tabs.forEach((tab, tabIndex) => {
        if (!(tab instanceof HTMLButtonElement)) return;
        tab.addEventListener("click", () => activate(tab.dataset.modelRiskTab ?? "overall"));
        tab.addEventListener("keydown", (event) => {
          let nextIndex = tabIndex;
          if (event.key === "ArrowRight") nextIndex = (tabIndex + 1) % tabs.length;
          else if (event.key === "ArrowLeft") nextIndex = (tabIndex - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = tabs.length - 1;
          else return;

          event.preventDefault();
          const nextTab = tabs[nextIndex];
          if (nextTab instanceof HTMLButtonElement) activate(nextTab.dataset.modelRiskTab ?? "overall", true);
        });
      });
    });
  }

  bindModelRiskBenchmarks();
  document.addEventListener("astro:page-load", bindModelRiskBenchmarks);
</script>
