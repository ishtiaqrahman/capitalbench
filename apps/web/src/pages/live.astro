---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActiveExposureMap from "../components/ActiveExposureMap";
import LivePerformanceChart from "../components/LivePerformanceChart";
import { ArrowRight, BarChart3, BriefcaseBusiness, CalendarClock, Layers3, Radar } from "lucide-react";
import {
  modelLabel,
  providerLabel,
  type RoundRecord,
  type SubmissionRecord,
  type UniverseOption
} from "../data/fallback";
import apiReadModel from "../generated/apiReadModel.js";
import {
  allocationThemeClass,
  decisionAllocations,
  formatAllocationPct,
  optionDisplayName
} from "../lib/allocations";
import { dateOnly } from "../lib/format";
import {
  staticAllWeeklyPerformance,
  staticOfficialSubmissions,
  staticRoundRecords,
  staticUniverseOptions
} from "../lib/localRoundRecords";
import { staticModelProfiles } from "../lib/modelProfiles";
import { signedPulseChangeLabel } from "../lib/riskFormatting.js";
import { providerLogoSrc } from "../lib/scoreReturnChart";
import {
  latestRoundForTrack,
  roundTrack,
  roundsForTrack,
  type BenchmarkTrack
} from "../lib/tracks";
import { buildRunConcentration, type ConcentrationAsset, type RunConcentration } from "../lib/runConcentration";

type TrackLiveState = {
  key: BenchmarkTrack;
  label: string;
  horizonLabel: string;
  round?: RoundRecord;
  submissions: SubmissionRecord[];
  options: UniverseOption[];
  optionsById: Record<string, UniverseOption | undefined>;
  concentration: RunConcentration;
  exposures: ConcentrationAsset[];
  topExposure?: ConcentrationAsset;
  latestHref: string;
  roundHref?: string;
};

const roundRows = staticRoundRecords();
const latestWeeklyRound = latestRoundForTrack(roundRows, "weekly");
const latestMonthlyRound = latestRoundForTrack(roundRows, "monthly");
const weeklyRounds = roundsForTrack(roundRows, "weekly");
const monthlyRounds = roundsForTrack(roundRows, "monthly");
const modelProfiles = staticModelProfiles();

function buildTrackState(
  key: BenchmarkTrack,
  label: string,
  horizonLabel: string,
  round: RoundRecord | undefined
): TrackLiveState {
  const submissions = round ? staticOfficialSubmissions(round.round_id, round.official_run_id) : [];
  const options = round ? staticUniverseOptions(round.round_id) : [];
  const optionsById = Object.fromEntries(options.map((option) => [option.option_id, option]));
  const concentration = buildRunConcentration(submissions, optionsById);
  const exposures = concentration.assets.slice(0, 6);
  return {
    key,
    label,
    horizonLabel,
    round,
    submissions,
    options,
    optionsById,
    concentration,
    exposures,
    topExposure: concentration.topAsset,
    latestHref: `/leaderboards/latest-${key}`,
    roundHref: round ? `/rounds/${round.round_id}/` : undefined
  };
}

const trackStates = [
  buildTrackState("monthly", "Monthly", "One-month test", latestMonthlyRound),
  buildTrackState("weekly", "Weekly", "One-week test", latestWeeklyRound)
];
const activeExposureRounds = roundRows
  .filter((round) => round.status === "pending" && round.official_run_id)
  .map((round) => {
    const track = roundTrack(round);
    return {
      round,
      track,
      submissions: staticOfficialSubmissions(round.round_id, round.official_run_id),
      options: staticUniverseOptions(round.round_id)
    };
  })
  .filter((item) => (item.track === "weekly" || item.track === "monthly") && item.submissions.length > 0);
const livePerformanceRows = staticAllWeeklyPerformance(roundRows).filter((row) => row.status === "pending");
const openRoundCounts = {
  all: activeExposureRounds.length,
  weekly: activeExposureRounds.filter((item) => item.track === "weekly").length,
  monthly: activeExposureRounds.filter((item) => item.track === "monthly").length
};
const liveRiskSnapshot = apiReadModel.risk_appetite;
const currentRiskPulse = liveRiskSnapshot.current_decision_pulse;
const outstandingBookRisk = liveRiskSnapshot.outstanding_live_book;
const riskPulseTopAssets = currentRiskPulse.top_assets.slice(0, 6);
const riskPulseRegimes = currentRiskPulse.regime_exposure.slice(0, 5);
const livePortfolioCount = activeExposureRounds.reduce((total, item) => total + item.submissions.length, 0);
const liveHeldAssetCount = new Set(
  activeExposureRounds.flatMap((item) =>
    item.submissions.flatMap((submission) => decisionAllocations(submission).map((allocation) => allocation.option_id))
  )
).size;
const latestCloseDate = livePerformanceRows
  .map((row) => row.price_date)
  .filter(Boolean)
  .sort()
  .at(-1);
const nextScoreDate = activeExposureRounds
  .map((item) => item.round.score_eta_utc || item.round.exit_date)
  .filter(Boolean)
  .sort()[0];
const currentDecisionDateLabel = pairedPulseFullDateLabel(
  currentRiskPulse.weekly?.decision_date,
  currentRiskPulse.monthly?.decision_date
);
const currentDecisionSummary = currentDecisionDateLabel ? `As of ${currentDecisionDateLabel}` : "Latest open portfolios";
const riskPreviousDateLabel = pairedPulseDateLabel(
  dateFromRoundId(currentRiskPulse.previous_round_ids?.weekly),
  dateFromRoundId(currentRiskPulse.previous_round_ids?.monthly)
);
const riskChangeLabel = riskPreviousDateLabel ? `Change vs ${riskPreviousDateLabel} portfolios` : "Change vs earlier portfolios";
const modelLiveRows = modelProfiles
  .filter((profile) => profile.live.all.portfolioCount > 0)
  .sort(
    (left, right) =>
      right.live.all.portfolioCount - left.live.all.portfolioCount ||
      (right.live.all.topThreePct ?? 0) - (left.live.all.topThreePct ?? 0) ||
      left.label.localeCompare(right.label)
  );

function statusClass(round?: RoundRecord): string {
  return round ? `status-${round.status}` : "status-archived";
}

function statusLabel(round?: RoundRecord): string {
  if (!round) return "Not started";
  if (round.status === "resolved") return "Scored";
  if (round.status === "overdue") return "Resolution due";
  if (round.status === "archived") return "Archived";
  return "Waiting for result";
}

function calendarStatusLabel(round?: RoundRecord): string {
  if (!round) return "Awaiting next test";
  if (round.status === "resolved") return "Scores published";
  if (round.status === "overdue") return "Score due";
  return "Live now";
}

function windowLabel(round?: RoundRecord): string {
  if (!round) return "Awaiting first round";
  return `${dateOnly(round.entry_date)} to ${dateOnly(round.exit_date)}`;
}

function shortMonthDay(value?: string): string {
  if (!value) return "n/a";
  const [year, month, day] = value.slice(0, 10).split("-").map(Number);
  if (!year || !month || !day) return dateOnly(value);
  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" }).format(
    new Date(Date.UTC(year, month - 1, day))
  );
}

function longMonthDayYear(value?: string): string {
  if (!value) return "";
  const [year, month, day] = value.slice(0, 10).split("-").map(Number);
  if (!year || !month || !day) return dateOnly(value);
  return new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(
    new Date(Date.UTC(year, month - 1, day))
  );
}

function dateFromRoundId(roundId?: string | null): string {
  const match = roundId?.match(/^CB-(\d{4}-\d{2}-\d{2})-/);
  return match?.[1] ?? "";
}

function pairedPulseDateLabel(weeklyDate?: string, monthlyDate?: string): string {
  const weekly = shortMonthDay(weeklyDate);
  const monthly = shortMonthDay(monthlyDate);
  if (weekly !== "n/a" && monthly !== "n/a" && weekly === monthly) return weekly;
  if (weekly !== "n/a" && monthly !== "n/a") return `${monthly} monthly + ${weekly} weekly`;
  return monthly !== "n/a" ? monthly : weekly !== "n/a" ? weekly : "";
}

function pairedPulseFullDateLabel(weeklyDate?: string, monthlyDate?: string): string {
  const weekly = longMonthDayYear(weeklyDate);
  const monthly = longMonthDayYear(monthlyDate);
  if (weekly && monthly && weekly === monthly) return weekly;
  if (weekly && monthly) return `${monthly} monthly + ${weekly} weekly`;
  return monthly || weekly || "";
}

function lockDateLabel(round?: RoundRecord): string {
  return round ? shortMonthDay(round.decision_deadline_utc || round.decision_date) : "Pending";
}

function marketWindowCalendarLabel(round?: RoundRecord): string {
  if (!round) return "No window declared";
  return `${shortMonthDay(round.entry_date)} close to ${shortMonthDay(round.exit_date)} close`;
}

function calendarScoreDateLabel(round?: RoundRecord): string {
  if (!round) return "Not scheduled";
  if (round.status === "resolved") return `Published after ${shortMonthDay(round.exit_date)} close`;
  if (round.status === "overdue") return `Due after ${shortMonthDay(round.exit_date)} close`;
  return `After ${shortMonthDay(round.exit_date)} close`;
}

function pctValue(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  if (Math.abs(value) >= 10) return `${value.toFixed(1)}%`;
  if (Math.abs(value) >= 1) return `${value.toFixed(1)}%`;
  return `${value.toFixed(2)}%`;
}

function pulseScore(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  return value.toFixed(1);
}

function signedPulseChange(value: number | null | undefined): string {
  return signedPulseChangeLabel(value);
}

function riskWidth(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "0%";
  return `${Math.min(100, Math.max(0, value)).toFixed(2)}%`;
}

function assetLabelWithTicker(asset: { label?: string; ticker?: string; option_id?: string } | null | undefined): string {
  if (!asset) return "n/a";
  const label = asset.label || asset.option_id || "n/a";
  return asset.ticker ? `${label} (${asset.ticker})` : label;
}

function liveTestDescription(track: BenchmarkTrack): string {
  if (track === "weekly") return "Short-term test of AI positioning over one market week.";
  return "Longer test of AI allocation over one month.";
}

function liveTestStateLabel(round?: RoundRecord): string {
  if (!round) return "Awaiting next test.";
  if (round.status === "resolved") return "Official scores are published.";
  if (round.status === "overdue") return "Portfolios are locked and the official score is due.";
  return "Portfolios locked; scoring pending.";
}

function liveTrackRiskScore(track: BenchmarkTrack): string {
  const pulse = track === "weekly" ? currentRiskPulse.weekly : currentRiskPulse.monthly;
  return pulseScore(pulse?.score);
}

function topConsensusLabel(track: TrackLiveState): string {
  return track.topExposure ? optionDisplayName(track.topExposure.optionId, track.optionsById) : "No consensus yet";
}

function modelProfileHref(modelId: string): string {
  return `/models/${modelId}/#live-holdings`;
}
---

<BaseLayout
  title="Live AI Portfolio Positions And Returns"
  description="CapitalBench live dashboard for open AI model portfolio rounds, live positions, mark-to-market returns, current risk appetite, and audit packet links."
>
  <section class="live-dashboard-hero" aria-labelledby="live-dashboard-title">
    <div class="live-dashboard-hero-copy">
      <span class="panel-kicker">Live dashboard</span>
      <h1 id="live-dashboard-title">Live Positions & Returns</h1>
      <p>
        Open CapitalBench rounds before final scoring. This page shows frozen model portfolios, current exposure,
        mark-to-market returns, and the score dates still waiting on final closing prices.
      </p>
      <div class="live-dashboard-actions" aria-label="Live dashboard sections">
        <a class="action-link action-primary" href="#live-positions">
          Open live positions
          <ArrowRight size={15} aria-hidden="true" />
        </a>
        <a class="action-link" href="#live-returns">See mark-to-market returns</a>
        <a class="action-link" href="#open-tests">Review open tests</a>
      </div>
    </div>

    <aside class="live-dashboard-status-card" aria-label="Current live dashboard status">
      <span>Current live book</span>
      <strong class="risk-score-with-unit">{pulseScore(outstandingBookRisk.score)}<small>/100</small></strong>
      <em>{outstandingBookRisk.label}</em>
      <dl>
        <div>
          <dt>Open rounds</dt>
          <dd>{activeExposureRounds.length}</dd>
        </div>
        <div>
          <dt>Frozen portfolios</dt>
          <dd>{livePortfolioCount}</dd>
        </div>
        <div>
          <dt>Latest close</dt>
          <dd>{shortMonthDay(latestCloseDate)}</dd>
        </div>
        <div>
          <dt>Next final score</dt>
          <dd>{shortMonthDay(nextScoreDate)}</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="live-dashboard-kpis" aria-label="Live dashboard snapshot">
    <article>
      <span><Layers3 size={18} aria-hidden="true" /></span>
      <em>Open monthly rounds</em>
      <strong>{openRoundCounts.monthly}</strong>
      <small>{monthlyRounds.filter((round) => round.status === "pending").length} waiting for results</small>
    </article>
    <article>
      <span><CalendarClock size={18} aria-hidden="true" /></span>
      <em>Open weekly rounds</em>
      <strong>{openRoundCounts.weekly}</strong>
      <small>{weeklyRounds.filter((round) => round.status === "pending").length} waiting for results</small>
    </article>
    <article>
      <span><BriefcaseBusiness size={18} aria-hidden="true" /></span>
      <em>Frozen live portfolios</em>
      <strong>{livePortfolioCount}</strong>
      <small>{liveHeldAssetCount} assets currently held</small>
    </article>
    <article>
      <span><Radar size={18} aria-hidden="true" /></span>
      <em>Current risk appetite</em>
      <strong class="risk-score-with-unit">{pulseScore(currentRiskPulse.score)}<small>/100</small></strong>
      <small>{currentRiskPulse.label}</small>
    </article>
  </section>

  <section class="home-section-heading home-section-heading-with-action" id="live-returns" aria-labelledby="live-returns-title">
    <div>
      <span class="panel-kicker">Live tests</span>
      <h2 id="live-returns-title">Mark-To-Market Portfolio Returns</h2>
      <p>
        Open rounds priced to the latest available close. These are interim portfolio returns, not official benchmark
        scores.
      </p>
    </div>
    <a class="section-profile-link" href="/leaderboards/latest">Official results</a>
  </section>

  <LivePerformanceChart client:visible rows={livePerformanceRows} openRoundCounts={openRoundCounts} />

  <section class="home-section-heading home-section-heading-with-action" id="live-positions" aria-labelledby="live-positions-title">
    <div>
      <span class="panel-kicker">Live positions</span>
      <h2 id="live-positions-title">Current Frozen Model Portfolios</h2>
      <p>
        Current asset and model exposure across unresolved monthly and weekly rounds, with each frozen portfolio shown below.
      </p>
    </div>
    <a class="section-profile-link" href="/models">Model profiles</a>
  </section>

  <ActiveExposureMap client:visible rounds={activeExposureRounds} />

  <section class="decision-track-grid live-decision-track-grid" aria-label="Latest monthly and weekly model portfolios">
    {trackStates.map((track) => (
      <article class={`decision-track decision-track-${track.key}`}>
        <div class="decision-track-header">
          <div>
            <span class="panel-kicker">{track.label} model portfolios</span>
            <h3>{track.round?.round_id ?? "Awaiting round"}</h3>
            <p>{track.round ? windowLabel(track.round) : "No portfolios are locked yet."}</p>
          </div>
          <span class={`status-badge ${statusClass(track.round)}`}>{statusLabel(track.round)}</span>
        </div>

        {track.submissions.length > 0 ? (
          <>
            <div class="decision-row-list">
              {track.submissions.map((submission) => {
                const allocations = decisionAllocations(submission);
                return (
                  <div class="decision-row">
                    <div class="decision-row-meta">
                      <span class={`provider-badge provider-${submission.provider}`}>{providerLabel(submission.provider)}</span>
                      <a class="decision-model-link" href={modelProfileHref(submission.model_id)}>
                        {modelLabel(submission.model_id)}
                      </a>
                      <div class="decision-allocation-pills" aria-label={`${modelLabel(submission.model_id)} frozen allocations`}>
                        {allocations.length > 0 ? (
                          allocations.map((allocation) => (
                            <span
                              class="decision-allocation-pill"
                              title={`${optionDisplayName(allocation.option_id, track.optionsById)} ${formatAllocationPct(allocation.allocation_pct)}`}
                            >
                              <i class={allocationThemeClass(allocation.option_id)} aria-hidden="true"></i>
                              <strong>{optionDisplayName(allocation.option_id, track.optionsById)}</strong>
                              <em>{formatAllocationPct(allocation.allocation_pct)}</em>
                            </span>
                          ))
                        ) : (
                          <span class="decision-allocation-pill decision-allocation-pill-empty">No allocation</span>
                        )}
                      </div>
                    </div>
                    <div class="allocation-stack mini" aria-hidden="true">
                      {allocations.map((allocation) => (
                        <span
                          class={allocationThemeClass(allocation.option_id)}
                          style={`width: ${Math.max(3, allocation.allocation_pct)}%`}
                          title={`${optionDisplayName(allocation.option_id, track.optionsById)} ${formatAllocationPct(allocation.allocation_pct)}`}
                        />
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>

            <div class="track-exposure">
              <div>
                <span class="metric-label">Shared top pick</span>
                <strong>{track.topExposure ? optionDisplayName(track.topExposure.optionId, track.optionsById) : "None"}</strong>
                <small>Average across {track.concentration.modelCount} frozen model portfolios.</small>
              </div>
              <div>
                <div class="allocation-stack track-consensus-stack" aria-label={`${track.label} shared pick stack`}>
                  {track.concentration.assets.map((item) => (
                    <span
                      class={allocationThemeClass(item.optionId)}
                      style={`width: ${item.averagePct}%`}
                      title={`${optionDisplayName(item.optionId, track.optionsById)} ${formatAllocationPct(item.averagePct)}`}
                    />
                  ))}
                </div>
                <div class="track-consensus-stats" aria-label={`${track.label} concentration summary`}>
                  <span>Top 3 <strong>{formatAllocationPct(track.concentration.topThreeSharePct)}</strong></span>
                  <span>Spread <strong>{track.concentration.effectiveAssetCount.toFixed(1)} assets</strong></span>
                </div>
                <div class="exposure-bars compact">
                  {track.exposures.slice(0, 4).map((item) => (
                    <div class="exposure-bar-row">
                      <span>{optionDisplayName(item.optionId, track.optionsById)}</span>
                      <div class="exposure-bar-track" aria-hidden="true">
                        <span
                          class={allocationThemeClass(item.optionId)}
                          style={`width: ${track.topExposure ? Math.max(4, (item.averagePct / track.topExposure.averagePct) * 100) : 0}%`}
                        />
                      </div>
                      <strong>{formatAllocationPct(item.averagePct)}</strong>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </>
        ) : (
          <div class="pending-state compact">
            <strong>No model portfolios yet.</strong>
            <span>The latest {track.label.toLowerCase()} portfolios will appear after the round is locked.</span>
          </div>
        )}

        <div class="track-card-actions">
          <a class="small-button" href={track.latestHref}>
            {track.round?.status === "resolved" ? `Open ${track.label} Results` : `${track.label} Scores`}
          </a>
          {track.roundHref && <a class="small-button" href={track.roundHref}>Audit packet</a>}
        </div>
      </article>
    ))}
  </section>

  <section class="live-risk-pulse live-dashboard-risk" aria-labelledby="live-risk-dashboard-title">
    <div class="live-risk-pulse-head">
      <div>
        <span class="panel-kicker">Current allocation signal</span>
        <h3 id="live-risk-dashboard-title">AI Risk Appetite</h3>
        <p>
          Latest monthly and weekly portfolios, equal-weighted by track. This measures current model positioning, not
          market returns or a trading recommendation.
        </p>
      </div>
      <a class="section-profile-link" href="/risk-appetite">Historical trend and methodology</a>
    </div>

    <div class="live-risk-pulse-grid">
      <article class="live-risk-pulse-primary">
        <div class="live-risk-pulse-score">
          <span>Combined pulse</span>
          <strong class="risk-score-with-unit">{pulseScore(currentRiskPulse.score)}<small>/100</small></strong>
          <em>{currentRiskPulse.label}</em>
        </div>
        <div class="live-risk-pulse-regime">
          <span>{currentDecisionSummary}</span>
          <strong>{currentRiskPulse.regime}</strong>
          <small>
            {currentRiskPulse.monthly?.round_id} and {currentRiskPulse.weekly?.round_id}
          </small>
        </div>
        <div class="live-risk-pulse-meter" aria-label={`Current AI Risk Appetite ${pulseScore(currentRiskPulse.score)} out of 100`}>
          <span class="risk-pulse-band is-defensive"></span>
          <span class="risk-pulse-band is-cautious"></span>
          <span class="risk-pulse-band is-balanced"></span>
          <span class="risk-pulse-band is-seeking"></span>
          <span class="risk-pulse-band is-aggressive"></span>
          <i style={`--pulse-position: ${riskWidth(currentRiskPulse.score)}`}></i>
        </div>
        <div class="live-risk-pulse-ticks" aria-hidden="true">
          <span>0 Defensive</span>
          <span>50 Balanced</span>
          <span>100 Aggressive</span>
        </div>
      </article>

      <div class="live-risk-pulse-stats">
        <article>
          <span>Monthly strategic</span>
          <strong class="risk-score-with-unit">{pulseScore(currentRiskPulse.monthly?.score)}<small>/100</small></strong>
          <small>{currentRiskPulse.monthly?.label}</small>
        </article>
        <article>
          <span>Weekly tactical</span>
          <strong class="risk-score-with-unit">{pulseScore(currentRiskPulse.weekly?.score)}<small>/100</small></strong>
          <small>{currentRiskPulse.weekly?.label}</small>
        </article>
        <article>
          <span>Change</span>
          <strong class:list={{ "is-negative": Number(currentRiskPulse.change_from_previous) < 0 }}>
            {signedPulseChange(currentRiskPulse.change_from_previous)}
          </strong>
          <small>{riskChangeLabel}</small>
        </article>
        <article>
          <span>Model agreement</span>
          <strong>{currentRiskPulse.agreement.label}</strong>
          <small>{pulseScore(currentRiskPulse.agreement.standard_deviation)} point dispersion</small>
        </article>
      </div>
    </div>

    <div class="live-risk-pulse-detail">
      <div>
        <span class="metric-label">Largest current allocations</span>
        <div class="live-risk-driver-list">
          {riskPulseTopAssets.map((asset) => (
            <span>
              <strong>{assetLabelWithTicker(asset)}</strong>
              <em>{pctValue(asset.allocation_pct)}</em>
            </span>
          ))}
        </div>
      </div>
      <div>
        <span class="metric-label">Regime mix</span>
        <div class="live-risk-regime-list">
          {riskPulseRegimes.map((regime) => (
            <span>
              <strong>{regime.label}</strong>
              <i><b style={`width: ${riskWidth(regime.allocation_pct)}`}></b></i>
              <em>{pctValue(regime.allocation_pct)}</em>
            </span>
          ))}
        </div>
      </div>
      <aside>
        <span>Outstanding live book</span>
        <strong class="risk-score-with-unit">{pulseScore(outstandingBookRisk.score)}<small>/100</small></strong>
        <em>{outstandingBookRisk.label}</em>
        <p>
          All {outstandingBookRisk.portfolio_count} unresolved portfolios across {outstandingBookRisk.round_count}
          rounds. This slower exposure measure can differ from the newest monthly and weekly decisions.
        </p>
      </aside>
    </div>
  </section>

  {modelLiveRows.length > 0 && (
    <section class="live-model-snapshot" aria-labelledby="live-model-snapshot-title">
      <div class="home-section-heading">
        <span class="panel-kicker">Model live holdings</span>
        <h2 id="live-model-snapshot-title">Open Portfolios By Model</h2>
        <p>
          A compact readout of each model's unresolved CapitalBench exposure. Open the model profile for the full
          holdings breakdown.
        </p>
      </div>
      <div class="live-model-grid">
        {modelLiveRows.map((profile) => {
          const scope = profile.live.all;
          const logoSrc = profile.iconSrc ?? profile.logoSrc ?? providerLogoSrc(profile.provider);
          return (
            <a class="live-model-card" href={`/models/${profile.modelId}/#live-holdings`}>
              <span class="live-model-identity">
                <span class="live-model-logo">
                  {logoSrc ? <img src={logoSrc} alt="" width="32" height="32" loading="lazy" /> : <span>{profile.label.charAt(0)}</span>}
                </span>
                <span>
                  <strong>{profile.label}</strong>
                  <small>{profile.providerLabel}</small>
                </span>
              </span>
              <span class="live-model-top">
                <em>Top live holding</em>
                <strong>{scope.topHolding?.label ?? "No holding"}</strong>
                <small>{scope.topHolding ? pctValue(scope.topHolding.exposurePct) : "0%"} across {scope.portfolioCount} open portfolios</small>
              </span>
              <span class="live-model-metrics">
                <span>Top 3 <strong>{pctValue(scope.topThreePct)}</strong></span>
                <span>Next score <strong>{shortMonthDay(scope.nextScoreDate)}</strong></span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="home-section-heading track-summary-heading" id="open-tests" aria-labelledby="open-tests-title">
    <span class="panel-kicker">Open tests</span>
    <h2 id="open-tests-title">Live Monthly And Weekly Tests</h2>
    <p>
      These are the open tests you can inspect now. Models already submitted portfolios; official scores wait for final
      closing prices.
    </p>
  </section>

  <section class="track-summary live-test-summary" aria-label="Live monthly and weekly benchmark tests">
    {trackStates.map((track) => (
      <article class={`track-card track-card-${track.key} live-test-card`}>
        <div class="track-card-head">
          <div>
            <span class="panel-kicker">{track.label} test</span>
            <h3>{track.horizonLabel}</h3>
          </div>
          <span class={`status-badge ${statusClass(track.round)}`}>{calendarStatusLabel(track.round)}</span>
        </div>
        {track.round ? (
          <>
            <p class="live-test-description">{liveTestDescription(track.key)}</p>
            <p class="live-test-state">{liveTestStateLabel(track.round)}</p>
            <div class="track-card-grid live-test-grid">
              <span>Model portfolios <strong>{track.submissions.length}</strong></span>
              <span>Eligible assets <strong>{track.options.length}</strong></span>
              <span>Risk-taking score <strong>{liveTrackRiskScore(track.key)}<small>/100</small></strong></span>
              <span>
                Top consensus
                <strong>{topConsensusLabel(track)}</strong>
                {track.topExposure && <small>{formatAllocationPct(track.topExposure.averagePct)} average weight</small>}
              </span>
            </div>
          </>
        ) : (
          <p class="live-test-description">No {track.label.toLowerCase()} test is live yet.</p>
        )}
        <div class="track-card-actions live-test-actions">
          <a class="small-button" href="#live-positions">Live positions</a>
          <a class="small-button" href="/universe">Asset universe</a>
          {track.roundHref && <a class="small-button" href={track.roundHref}>Audit packet</a>}
        </div>
      </article>
    ))}
    <p class="live-test-footnote">Internal IDs and full reproducibility files are inside each audit packet.</p>
  </section>

  <section class="timeline-lanes scoring-calendar" id="scoring-calendar" aria-labelledby="track-timeline-title">
    <div class="home-section-heading">
      <span class="panel-kicker">Scoring calendar</span>
      <h2 id="track-timeline-title">Current Scoring Calendar</h2>
      <p>
        Models have already picked portfolios. Official scores publish only after the market window ends and final closing
        prices are available.
      </p>
    </div>
    <div class="timeline-lane-grid scoring-calendar-grid">
      {trackStates.map((track) => (
        <article class={`timeline-lane scoring-calendar-card scoring-calendar-card-${track.key}`}>
          <div class="timeline-lane-head scoring-calendar-head">
            <div>
              <span class="panel-kicker">{track.label} test</span>
              <strong>{track.horizonLabel}</strong>
            </div>
            <span class={`status-badge ${statusClass(track.round)}`}>{calendarStatusLabel(track.round)}</span>
          </div>
          {track.round ? (
            <>
              <p class="scoring-calendar-summary">
                {track.submissions.length} model portfolio{track.submissions.length === 1 ? "" : "s"} locked and waiting for official scoring.
              </p>
              <dl class="scoring-calendar-facts">
                <div>
                  <dt>Locked</dt>
                  <dd>{lockDateLabel(track.round)}</dd>
                </div>
                <div>
                  <dt>Market window</dt>
                  <dd>{marketWindowCalendarLabel(track.round)}</dd>
                </div>
                <div>
                  <dt>Official score</dt>
                  <dd>{calendarScoreDateLabel(track.round)}</dd>
                </div>
              </dl>
              <div class="track-card-actions scoring-calendar-actions">
                <a class="small-button" href="#live-positions">View current portfolios</a>
                <a class="small-button" href={track.latestHref}>See latest results</a>
                <a class="small-button" href="#score-alert-panel-home" data-score-alert-trigger>Get score alert</a>
              </div>
            </>
          ) : (
            <p class="scoring-calendar-summary">No {track.label.toLowerCase()} test is live yet.</p>
          )}
        </article>
      ))}
    </div>
    <div class="scoring-calendar-record">
      <div>
        <strong>{roundRows.length} official rounds recorded</strong>
        <span>Internal round and run IDs stay in the public audit trail.</span>
      </div>
      <a class="small-button" href="/rounds">View audit trail</a>
    </div>
  </section>

  <section class="live-dashboard-method-note" aria-label="Live data methodology note">
    <BarChart3 size={18} aria-hidden="true" />
    <div>
      <strong>Live data is interim.</strong>
      <p>
        Positions are frozen model outputs from open rounds. Returns are marked to the latest available close. Official
        benchmark scores publish only after the scheduled ending close is collected.
      </p>
    </div>
  </section>
</BaseLayout>
