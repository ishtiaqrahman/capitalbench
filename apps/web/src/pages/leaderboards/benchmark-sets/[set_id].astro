---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BenchmarkEvidencePanel from "../../../components/BenchmarkEvidencePanel.astro";
import BenchmarkSetRiskReturn from "../../../components/BenchmarkSetRiskReturn";
import PageHeader from "../../../components/PageHeader.astro";
import TrackScorecard from "../../../components/TrackScorecard.astro";
import apiReadModel from "../../../generated/apiReadModel.js";
import { buildBenchmarkSetRiskReturn } from "../../../lib/benchmarkSetRiskReturn.js";
import { benchmarkSetToScorecard, buildBenchmarkSetsData } from "../../../lib/benchmarkSets";
import {
  buildBenchmarkSetComparison,
  defaultBenchmarkSetComparison
} from "../../../lib/benchmarkSetComparison.js";
import type { TrackScorecardData } from "../../../lib/trackScorecard";

const benchmarkSets = buildBenchmarkSetsData(apiReadModel) as any;

export function getStaticPaths() {
  const sets = (buildBenchmarkSetsData(apiReadModel) as any).sets;
  return sets.map((set: any) => ({
    params: { set_id: set.set_id },
    props: { set }
  }));
}

interface Props {
  set: any;
}

const { set } = Astro.props as Props;
const scorecard = benchmarkSetToScorecard(set) as TrackScorecardData | null;
const riskReturn = scorecard ? buildBenchmarkSetRiskReturn(apiReadModel, set) : null;
const status = set.is_current ? "Current Benchmark" : set.is_qualified ? "Qualified Comparison Set" : "Benchmark Forming";
const trackLabel = set.track === "weekly" ? "Weekly" : "Monthly";
const remainingRounds = Math.max(0, set.qualification_threshold - set.comparison.comparison_round_count);
const title = `${set.label} | CapitalBench`;
const description = `${set.label} ranks ${set.models.length} AI models only on shared ${set.track} rounds that every model completed.`;
const defaultPair = defaultBenchmarkSetComparison(benchmarkSets.sets, set.track);
const detailComparisonPair = defaultPair
  ? set.is_current
    ? defaultPair
    : { baseline: defaultPair.baseline, comparison: set }
  : null;
const detailComparison =
  detailComparisonPair && detailComparisonPair.baseline.set_id !== detailComparisonPair.comparison.set_id
    ? buildBenchmarkSetComparison(apiReadModel, detailComparisonPair.baseline, detailComparisonPair.comparison)
    : null;
---

<BaseLayout title={title} description={description}>
  <PageHeader
    eyebrow={`${trackLabel} comparison set`}
    title={set.label}
    summary={set.description || "A living equal-run comparison set for CapitalBench model rankings."}
  />

  <section class="section">
    <div class="panel">
      <div class="panel-header">
        <div>
          <span class="panel-kicker">{status}</span>
          <h2>Fairness Scope</h2>
          <p>
            Every ranked model in this set is scored only on rounds that all {set.models.length} listed models completed.
            If one model misses a resolved round, that round is excluded from this set for everyone.
          </p>
        </div>
        <a class="action-link" href="/leaderboards/benchmark-sets">All comparison sets</a>
      </div>
      <div class="published-score-context" aria-label="Comparison set summary">
        <span><strong>Shared rounds</strong>{set.comparison.comparison_round_count}</span>
        <span><strong>Models</strong>{set.models.length}</span>
        <span><strong>Threshold</strong>{set.qualification_threshold}</span>
        <span><strong>Status</strong>{status}</span>
      </div>
    </div>
  </section>

  {scorecard ? (
    <section class="section">
      <BenchmarkEvidencePanel
        evidence={apiReadModel.benchmark_evidence}
        track={set.track}
        benchmarkSet={set}
        compact
        title="Evidence Behind This Comparison"
      />
      <TrackScorecard scorecard={scorecard} />
    </section>
  ) : (
    <section class="section">
      <div class="panel">
        <div class="panel-header">
          <div>
            <span class="panel-kicker">Waiting for shared results</span>
            <h2>No Shared Resolved Rounds Yet</h2>
            <p>
              This set will show a chart after the first resolved {set.track} round where every listed model has an official result.
              It becomes the Current {trackLabel} Benchmark after {set.qualification_threshold} shared resolved rounds.
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  {riskReturn && (
    <section id="risk-return-map" class="section benchmark-set-risk-return-section">
      <BenchmarkSetRiskReturn data={riskReturn} client:load />
    </section>
  )}

  {detailComparison && (
    <section class="section benchmark-set-detail-compare" aria-labelledby="benchmark-set-detail-compare-title">
      <div class={`benchmark-set-detail-compare-panel benchmark-set-detail-compare-${set.track}`}>
        <div class="benchmark-set-detail-compare-copy">
          <span class="panel-kicker">Compare model groups</span>
          <h2 id="benchmark-set-detail-compare-title">How do these results compare?</h2>
          <p>{detailComparison.summary}</p>
          <div class="benchmark-set-detail-compare-metrics">
            <span><strong>{detailComparison.models.common_count}</strong><em>models in both</em></span>
            <span><strong>{detailComparison.rounds.shared.length}</strong><em>rounds used by both</em></span>
            <span><strong>{detailComparison.ranking.similarity_label}</strong><em>change in order</em></span>
            <span>
              <strong>{detailComparison.baseline.shared_round_count > 0 && detailComparison.comparison.shared_round_count > 0 ? (detailComparison.ranking.same_leader ? "No" : "Yes") : "Not available"}</strong>
              <em>top model changed</em>
            </span>
          </div>
        </div>
        <div class="benchmark-set-detail-compare-action">
          <p>{detailComparison.trust_guidance}</p>
          <a
            class="action-link"
            href={`/leaderboards/benchmark-sets/compare/?track=${detailComparison.track}&base=${detailComparison.baseline.set_id}&compare=${detailComparison.comparison.set_id}`}
          >
            Compare these groups
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="panel">
      <div class="panel-header">
        <div>
          <span class="panel-kicker">Roster</span>
          <h2>Models In This Set</h2>
          <p>This roster stays fixed so the set can keep growing as a clean equal-run comparison.</p>
        </div>
      </div>
      <div class="results-route-grid" aria-label="Models in comparison set">
        {set.models.map((model: any) => (
          <a class="results-route-card" href={`/models/${model.model_id}/`}>
            <span class="panel-kicker">{model.provider_label}</span>
            <strong>{model.label}</strong>
            <p>{model.model_id}</p>
            <em>{set.comparison.comparison_round_count} shared rounds in this set</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="panel">
      <div class="panel-header">
        <div>
          <span class="panel-kicker">Round audit</span>
          <h2>Included And Excluded Rounds</h2>
          <p>
            Included rounds count toward the score. Excluded rounds are resolved rounds after the set started where at least
            one set model was missing.
          </p>
        </div>
        {!set.is_qualified && (
          <span class="status-badge status-pending">{remainingRounds} more to qualify</span>
        )}
      </div>
      <div class="leaderboard-lanes-status-grid">
        <div>
          <strong>Included rounds</strong>
          <span>{set.comparison.comparison_round_ids.length ? set.comparison.comparison_round_ids.join(", ") : "None yet"}</span>
        </div>
        <div>
          <strong>Excluded for fairness</strong>
          {set.excluded_rounds.length ? (
            <details class="benchmark-set-round-details">
              <summary>{set.excluded_rounds.length} resolved candidate rounds</summary>
              <span>{set.excluded_rounds.map((round: any) => `${round.round_id} missing ${round.missing_model_ids.join(", ")}`).join("; ")}</span>
            </details>
          ) : <span>None</span>}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="panel">
      <div class="panel-header">
        <div>
          <span class="panel-kicker">Calculation</span>
          <h2>How The Score Is Calculated</h2>
          <p>
            CapitalBench Score equals total model return across included shared rounds divided by total max-possible return
            across those same rounds, multiplied by 100. Max possible is the best eligible asset in each included round in hindsight.
          </p>
        </div>
        <a class="action-link" href="/scoring/#capitalbench-score">Scoring details</a>
      </div>
    </div>
  </section>
</BaseLayout>
