      .mrb-disclosure { border-radius: 0; margin-inline: -20px; }
      .mrb-disclosure > summary { grid-template-columns: minmax(0, 1fr) auto; gap: 4px 10px; padding: 14px 20px; }
      .mrb-disclosure > summary .mrb-disclosure-label { grid-column: 1; }
      .mrb-disclosure > summary strong { grid-column: 1; }
      .mrb-disclosure > summary > .mrb-disclosure-toggle { grid-column: 2; grid-row: 2; }
      .mrb-method-body,
      .mrb-disclosure-body { padding: 16px 20px; }
