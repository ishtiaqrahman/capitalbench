      .mrb-hero-question { grid-template-columns: minmax(0, 1fr); }
      .mrb-hero-question strong { font-size: 0.9rem; }
      .mrb-context-bar { top: 114px; justify-content: center; margin: 0; border-width: 0 0 1px; border-radius: 0; }
      .mrb-track-switch { width: min(100%, 320px); }
      .mrb-track-switch button { min-width: 0; }
      .mrb-section-links { display: none; }
      .mrb-section { gap: 18px; scroll-margin-top: 172px; padding: 38px 20px; }
