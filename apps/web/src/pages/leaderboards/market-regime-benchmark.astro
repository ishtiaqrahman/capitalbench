---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BenchmarkBarChart from "../../components/BenchmarkBarChart.astro";
import { ChevronDown, Info } from "lucide-react";
import { modelLabel, providerLabel } from "../../data/fallback";
import apiReadModel from "../../generated/apiReadModel.js";
import { buildBenchmarkBarDomain } from "../../lib/benchmarkBars.js";
import { dateOnly, pct } from "../../lib/format";
import { providerLogoSrc } from "../../lib/scoreReturnChart";
import type { BenchmarkTrack } from "../../lib/tracks";

type RegimeKey = "sharp_down" | "down" | "flat" | "up" | "sharp_up";
type DirectionKey = "down" | "flat" | "up";

const TRACKS = ["monthly", "weekly"] as BenchmarkTrack[];
const DEFAULT_TRACK: BenchmarkTrack = "monthly";
const marketEnvironment: any = apiReadModel.market_environment ?? { thresholds: {}, definitions: {}, tracks: {} };
const READY_ROUND_THRESHOLD = Number(marketEnvironment.thresholds?.environment_rounds ?? 3);
const BALANCED_SAMPLE_THRESHOLD = Number(marketEnvironment.thresholds?.balanced_sample_per_direction ?? 3);

function finiteNumber(value: unknown): value is number {
  return typeof value === "number" && Number.isFinite(value);
}

function signedPctText(value: unknown): string {
  if (!finiteNumber(value)) return "n/a";
  const formatted = pct(value);
  return value > 0 ? `+${formatted}` : formatted;
}

function scoreText(value: unknown): string {
  return finiteNumber(value) ? value.toFixed(1) : "n/a";
}

function pointText(value: unknown, signed = false): string {
  if (!finiteNumber(value)) return "n/a";
  const rawPoints = value * 100;
  const points = Math.abs(rawPoints) < 0.005 ? 0 : rawPoints;
  const prefix = signed && points > 0 ? "+" : "";
  return `${prefix}${points.toFixed(2)} points`;
}

function confidenceLabel(value: unknown): string {
  const label = String(value ?? "low").toLowerCase();
  if (label === "high") return "More evidence";
  if (label === "medium") return "Some evidence";
  return "Early result";
}

function stabilityText(value: unknown): string {
  return finiteNumber(value) ? `${Math.round(value * 100)}%` : "n/a";
}

function humanDate(value: unknown): string {
  if (typeof value !== "string" || !value) return "Latest resolved round";
  const parsed = new Date(`${value.slice(0, 10)}T00:00:00Z`);
  if (Number.isNaN(parsed.getTime())) return value;
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC"
  }).format(parsed);
}

function valueTone(value: unknown): "positive" | "negative" | "neutral" {
  if (!finiteNumber(value) || value === 0) return "neutral";
  return value > 0 ? "positive" : "negative";
}

function trackLabel(track: BenchmarkTrack): string {
  return track === "weekly" ? "Weekly" : "Monthly";
}

function plainMarketType(key: RegimeKey | string, fallback = "Market type"): string {
  const labels: Record<RegimeKey, string> = {
    sharp_down: "Large fall",
    down: "Small fall",
    flat: "Little change",
    up: "Small rise",
    sharp_up: "Large rise"
  };
  return labels[key as RegimeKey] ?? fallback;
}

function enrichModel(row: any) {
  return {
    ...row,
    modelId: row.model_id,
    label: row.model_label ?? modelLabel(row.model_id),
    providerName: providerLabel(row.provider),
    logoSrc: providerLogoSrc(row.provider)
  };
}

function comparisonStatement(row: any, context: string): string {
  if (!row) return `There are not enough matching results to compare models ${context}.`;
  const rawAlpha = row.average_alpha;
  const alpha = finiteNumber(rawAlpha) && Math.abs(rawAlpha) < 0.00005 ? 0 : rawAlpha;
  if (!finiteNumber(alpha)) return `${row.label} ranks first among the models ${context}.`;
  if (alpha > 0) {
    return `${row.label} ranks first here with a ${signedPctText(row.average_return)} return, beating the S&P 500 by ${pointText(alpha)}.`;
  }
  if (alpha < 0) {
    return `${row.label} ranks first among the models, but the S&P 500 did better by ${pointText(Math.abs(alpha))}.`;
  }
  return `${row.label} ranks first among the models and matches the S&P 500.`;
}

function evidenceFor(environments: any[]): string {
  const labels = environments
    .filter((environment) => environment.status === "ready")
    .map((environment) => String(environment.comparison?.confidence ?? "low").toLowerCase());
  if (!labels.length || labels.includes("low")) return "low";
  if (labels.includes("medium")) return "medium";
  return "high";
}

const trackViews = Object.fromEntries(
  TRACKS.map((track) => {
    const artifact = marketEnvironment.tracks?.[track] ?? {};
    const definitions = marketEnvironment.definitions?.[track] ?? { environments: [], directions: [] };
    const environmentDefinitions = new Map(
      (definitions.environments ?? []).map((definition: any) => [definition.key, definition])
    );
    const directionDefinitions = new Map(
      (definitions.directions ?? []).map((definition: any) => [definition.key, definition])
    );

    const environments = (artifact.environments ?? []).map((environment: any) => {
      const definition: any = environmentDefinitions.get(environment.key) ?? environment;
      const comparison = environment.comparison ?? {};
      return {
        ...environment,
        ...definition,
        plainLabel: plainMarketType(environment.key, definition.label),
        rawCount: Number(environment.count ?? 0),
        sharedCount: Number(comparison.round_count ?? 0),
        eligibleModelCount: Number(comparison.eligible_model_count ?? 0),
        confidence: comparison.confidence ?? "low",
        stability: comparison.leave_one_out_stability,
        leaderMargin: comparison.leader_margin,
        leaderCiLow: comparison.leader_ci_95_low,
        leaderCiHigh: comparison.leader_ci_95_high,
        sharedSp500Return: comparison.model_rows?.[0]?.average_sp500_return,
        modelRows: (comparison.model_rows ?? []).map(enrichModel)
      };
    });

    const directions = (artifact.directions ?? []).map((direction: any) => {
      const definition: any = directionDefinitions.get(direction.key) ?? direction;
      const comparison = direction.comparison ?? {};
      const modelRows = (comparison.model_rows ?? []).map(enrichModel);
      return {
        ...direction,
        ...definition,
        rawCount: Number(direction.count ?? 0),
        sharedCount: Number(comparison.round_count ?? 0),
        eligibleModelCount: Number(comparison.eligible_model_count ?? 0),
        confidence: comparison.confidence ?? "low",
        stability: comparison.leave_one_out_stability,
        leaderMargin: comparison.leader_margin,
        leaderCiLow: comparison.leader_ci_95_low,
        leaderCiHigh: comparison.leader_ci_95_high,
        averageSp500Return: modelRows[0]?.average_sp500_return,
        modelRows,
        best: modelRows[0]
      };
    });

    const leaderboard = (artifact.regime_leaderboard ?? []).map((row: any) => {
      const equalEnvironmentAlpha = finiteNumber(row.average_return) && finiteNumber(row.average_sp500_return)
        ? row.average_return - row.average_sp500_return
        : row.average_alpha;
      return {
        ...enrichModel(row),
        averageReturn: row.average_return,
        averageSp500Return: row.average_sp500_return,
        averageAlpha: equalEnvironmentAlpha,
        balancedScore: row.regime_balanced_score,
        sp500Score: row.sp500_regime_score,
        allRoundScore: row.all_round_score,
        hitRate: row.hit_rate,
        testsIncluded: Number(row.tests_included ?? 0),
        covered: Number(row.ready_environments_covered ?? 0),
        required: Number(row.ready_environments_required ?? 0),
        comparable: row.status === "ready" && Number(row.ready_environments_covered ?? 0) === Number(row.ready_environments_required ?? 0),
        environmentScores: row.environment_scores ?? []
      };
    });
    const comparableRows = leaderboard.filter((row: any) => row.comparable);
    const limitedRows = leaderboard.filter((row: any) => !row.comparable);
    const leader = comparableRows[0];

    const returnChartRows: any[] = comparableRows.map((row: any, index: number) => ({
      key: row.modelId,
      label: row.label,
      value: row.averageReturn,
      kind: "model",
      provider: row.provider,
      logoSrc: row.logoSrc,
      href: `/models/${row.modelId}`,
      rank: index + 1,
      meta: `${row.providerName} · ${row.covered}/${row.required} market types`,
      secondaryLabel: `${pointText(row.averageAlpha, true)} vs S&P`
    }));
    if (finiteNumber(leader?.averageSp500Return)) {
      returnChartRows.push({
        key: `${track}-sp500-return`,
        label: "S&P 500",
        value: leader.averageSp500Return,
        kind: "benchmark",
        provider: "benchmark",
        logoSrc: undefined,
        href: undefined,
        rank: undefined,
        meta: "Comparison",
        secondaryLabel: "S&P 500 return"
      });
    }

    const scoreChartRows: any[] = comparableRows.map((row: any, index: number) => ({
      key: row.modelId,
      label: row.label,
      value: row.balancedScore,
      kind: "model",
      provider: row.provider,
      logoSrc: row.logoSrc,
      href: `/models/${row.modelId}`,
      rank: index + 1,
      meta: row.providerName,
      secondaryLabel: `Rank ${index + 1} · ${signedPctText(row.averageReturn)} return`
    }));
    if (finiteNumber(leader?.sp500Score)) {
      scoreChartRows.push({
        key: `${track}-sp500-score`,
        label: "S&P 500",
        value: leader.sp500Score,
        kind: "benchmark",
        provider: "benchmark",
        logoSrc: undefined,
        href: undefined,
        rank: undefined,
        meta: "Comparison",
        secondaryLabel: "Same market-type weights"
      });
    }
    scoreChartRows.push({
      key: `${track}-max-score`,
      label: "Best possible",
      value: 100,
      kind: "reference",
      provider: "reference",
      logoSrc: undefined,
      href: undefined,
      rank: undefined,
      meta: "Known only after prices changed",
      secondaryLabel: "Reference only"
    });

    const directionChartRows = Object.fromEntries(
      directions.map((direction: any) => {
        const rows: any[] = direction.modelRows.map((row: any, index: number) => ({
          key: row.modelId,
          label: row.label,
          value: row.average_return,
          kind: "model",
          provider: row.provider,
          logoSrc: row.logoSrc,
          href: `/models/${row.modelId}`,
          rank: index + 1,
          meta: `${row.providerName} · ${row.tests} results`,
          secondaryLabel: `${pointText(row.average_alpha, true)} vs S&P`
        }));
        if (finiteNumber(direction.averageSp500Return)) {
          rows.push({
            key: `${track}-${direction.key}-sp500`,
            label: "S&P 500",
            value: direction.averageSp500Return,
            kind: "benchmark",
            provider: "benchmark",
            logoSrc: undefined,
            href: undefined,
            rank: undefined,
            meta: `${direction.sharedCount} matching dates`,
            secondaryLabel: "S&P 500 return"
          });
        }
        return [direction.key, rows];
      })
    );
    const directionDomain = buildBenchmarkBarDomain(
      ["down", "up"].flatMap((key) => (directionChartRows[key] ?? []).map((row: any) => row.value)),
      { symmetric: true, targetTicks: 4 }
    );

    const environmentChartRows = Object.fromEntries(
      environments.map((environment: any) => {
        const rows: any[] = environment.modelRows.map((row: any, index: number) => ({
          key: row.modelId,
          label: row.label,
          value: row.average_return,
          kind: "model",
          provider: row.provider,
          logoSrc: row.logoSrc,
          href: `/models/${row.modelId}`,
          rank: index + 1,
          meta: `${row.providerName} · ${row.tests} results`,
          secondaryLabel: `${pointText(row.average_alpha, true)} vs S&P`
        }));
        if (finiteNumber(environment.sharedSp500Return)) {
          rows.push({
            key: `${track}-${environment.key}-sp500`,
            label: "S&P 500",
            value: environment.sharedSp500Return,
            kind: "benchmark",
            provider: "benchmark",
            logoSrc: undefined,
            href: undefined,
            rank: undefined,
            meta: `${environment.sharedCount} matching dates`,
            secondaryLabel: "S&P 500 return"
          });
        }
        return [environment.key, rows];
      })
    );
    const environmentDomain = buildBenchmarkBarDomain(
      Object.values(environmentChartRows).flatMap((rows: any) => rows.map((row: any) => row.value)),
      { symmetric: true, targetTicks: 4 }
    );

    const matrixRows = leaderboard.map((row: any) => ({
      ...row,
      cells: environments.map((environment: any) => {
        const modelRow = environment.modelRows.find((candidate: any) => candidate.modelId === row.modelId);
        return {
          key: environment.key,
          label: environment.label,
          returnValue: modelRow?.average_return,
          alpha: modelRow?.average_alpha,
          tests: Number(modelRow?.tests ?? 0)
        };
      })
    }));

    const sample = artifact.balanced_sample ?? {};
    const balancedLeaderboard = (sample.leaderboard ?? []).map((row: any) => ({
      ...enrichModel(row),
      score: row.score,
      averageAlpha: row.average_alpha,
      hitRate: row.hit_rate,
      testsIncluded: Number(row.tests_included ?? 0),
      testsRequired: Number(row.tests_required ?? 0),
      comparable: row.status === "ready" && Number(row.tests_included ?? 0) === Number(row.tests_required ?? 0)
    }));
    const balancedSample = {
      status: sample.status === "ready" ? "ready" : "forming",
      sampleSize: Number(sample.sample_size ?? 0),
      selectedRoundIds: sample.selected_round_ids ?? [],
      categories: (sample.categories ?? []).map((category: any) => ({
        ...category,
        count: Number(category.count ?? 0),
        missing: Number(category.missing ?? 0),
        selectedCount: Number(category.selected_count ?? 0)
      })),
      comparableRows: balancedLeaderboard.filter((row: any) => row.comparable),
      limitedRows: balancedLeaderboard.filter((row: any) => !row.comparable)
    };

    const rounds = (artifact.rounds ?? []).map((round: any) => {
      const definition: any = environmentDefinitions.get(round.environment_key) ?? {};
      return {
        ...round,
        track,
        environmentLabel: plainMarketType(round.environment_key, definition.label ?? round.environment_key),
        environmentKey: round.environment_key
      };
    });

    return [
      track,
      {
        track,
        label: trackLabel(track),
        artifact,
        environments,
        directions,
        leaderboard,
        comparableRows,
        limitedRows,
        leader,
        returnChartRows,
        returnChartDomain: buildBenchmarkBarDomain(returnChartRows.map((row: any) => row.value), { targetTicks: 4 }),
        scoreChartRows,
        scoreChartDomain: buildBenchmarkBarDomain(scoreChartRows.map((row: any) => row.value), { targetTicks: 4 }),
        directionChartRows,
        directionDomain,
        environmentChartRows,
        environmentDomain,
        matrixRows,
        balancedSample,
        rounds,
        signals: (artifact.signals ?? []).filter((signal: any) => signal.kind !== "synthesis"),
        readyEnvironmentCount: environments.filter((environment: any) => environment.status === "ready").length,
        resolvedRoundCount: rounds.length,
        evidence: evidenceFor(environments)
      }
    ];
  })
) as Record<BenchmarkTrack, any>;

const thresholdCards: Array<{
  key: RegimeKey;
  label: string;
  weeklyRange: string;
  monthlyRange: string;
  weeklyCount: number;
  monthlyCount: number;
}> = (marketEnvironment.definitions?.weekly?.environments ?? []).map((weekly: any) => {
  const monthly = (marketEnvironment.definitions?.monthly?.environments ?? []).find(
    (definition: any) => definition.key === weekly.key
  );
  const weeklyEnvironment = trackViews.weekly.environments.find((environment: any) => environment.key === weekly.key);
  const monthlyEnvironment = trackViews.monthly.environments.find((environment: any) => environment.key === weekly.key);
  return {
    key: weekly.key as RegimeKey,
    label: plainMarketType(weekly.key, weekly.label),
    weeklyRange: weekly.range_label.replace("S&P ", ""),
    monthlyRange: monthly?.range_label.replace("S&P ", "") ?? "n/a",
    weeklyCount: weeklyEnvironment?.rawCount ?? 0,
    monthlyCount: monthlyEnvironment?.rawCount ?? 0
  };
});

const auditRows = TRACKS.flatMap((track) => trackViews[track].rounds).sort(
  (left: any, right: any) =>
    String(right.exit_date ?? "").localeCompare(String(left.exit_date ?? "")) ||
    String(right.round_id).localeCompare(String(left.round_id))
);

function rankChange(view: any, modelId: string, strictRank: number): string {
  const mainRank = view.comparableRows.findIndex((row: any) => row.modelId === modelId) + 1;
  if (!mainRank) return "Not comparable";
  if (mainRank === strictRank) return "No change";
  const difference = Math.abs(mainRank - strictRank);
  return strictRank < mainRank
    ? `${difference} place${difference === 1 ? "" : "s"} higher`
    : `${difference} place${difference === 1 ? "" : "s"} lower`;
}

function insightView(signal: any) {
  const status = signal.maturity === "ready" ? "Enough data" : "Early result";
  if (signal.kind === "direction_leader") {
    const model = signal.model ? enrichModel(signal.model) : undefined;
    const direction = String(signal.direction ?? "market");
    const directionText = direction === "down" ? "when the market fell" : direction === "up" ? "when the market rose" : "when the market was flat";
    if (!model) {
      return {
        tone: direction,
        status,
        eyebrow: `${trackLabel(signal.track)} · ${directionText}`,
        title: `We need more results ${directionText}.`,
        metric: "n/a",
        metricLabel: "return",
        detail: `${signal.environment_round_count ?? 0} result${Number(signal.environment_round_count ?? 0) === 1 ? " is" : "s are"} available, but not enough dates were completed by every model.`,
        stats: [
          ["Dates used", String(signal.comparison_round_count ?? 0)],
          ["Dates available", String(signal.environment_round_count ?? 0)],
          ["S&P 500 move", signal.range_label ?? "n/a"]
        ]
      };
    }
    const beatsBenchmark = finiteNumber(model.average_alpha) && model.average_alpha > 0;
    return {
      tone: direction,
      status,
      eyebrow: `${trackLabel(signal.track)} · ${directionText}`,
      title: beatsBenchmark
        ? `${model.label} beat the S&P 500 ${directionText}.`
        : `The S&P 500 beat every compared model ${directionText}.`,
      metric: signedPctText(model.average_return),
      metricLabel: "return",
      detail: `${model.label} ranked first among the models. Its difference from the S&P 500 was ${pointText(model.average_alpha, true)}.`,
      stats: [
        ["S&P 500", signedPctText(signal.average_sp500_return)],
        ["Used / available", `${signal.comparison_round_count}/${signal.environment_round_count}`],
        [
          "Leader repeated",
          stabilityText(signal.comparison?.leave_one_out_stability)
        ]
      ]
    };
  }

  if (signal.kind === "consistency") {
    const candidate = signal.candidate;
    if (!candidate?.model) {
      return {
        tone: "steady",
        status,
        eyebrow: `${trackLabel(signal.track)} · across market types`,
        title: "We need more results across different markets.",
        metric: "n/a",
        metricLabel: "average return",
        detail: "This comparison needs matching results from at least two kinds of market move.",
        stats: []
      };
    }
    const model = enrichModel(candidate.model);
    return {
      tone: "steady",
      status,
      eyebrow: `${trackLabel(signal.track)} · across market types`,
      title: `${model.label} has the best worst-case score across the tested market moves.`,
      metric: signedPctText(candidate.average_return),
      metricLabel: "average return",
      detail: `Its lowest CapitalBench Score is ${scoreText(candidate.floor_score)} across ${candidate.directions_covered} kinds of market move.`,
      stats: [
        ["S&P 500", signedPctText(candidate.average_sp500_return)],
        ["Average score", scoreText(candidate.average_score)],
        ["Market moves", `${candidate.ready_directions}/${candidate.directions_covered}`]
      ]
    };
  }

  const candidate = signal.candidate;
  if (!candidate?.model) {
    return {
      tone: "split",
      status,
      eyebrow: `${trackLabel(signal.track)} · biggest change`,
      title: "We need more falling and rising market results.",
      metric: "n/a",
      metricLabel: "return difference",
      detail: "This comparison needs matching results from both falling and rising markets.",
      stats: []
    };
  }
  const model = enrichModel(candidate.model);
  return {
    tone: "split",
    status,
    eyebrow: `${trackLabel(signal.track)} · biggest change`,
    title: `${model.label} changes the most between falling and rising markets.`,
    metric: pointText(Math.abs(candidate.return_gap)),
    metricLabel: "return difference",
    detail: `Its average return moves from ${signedPctText(candidate.down_return)} when the market fell to ${signedPctText(candidate.up_return)} when it rose.`,
    stats: [
      ["Falling-market score", scoreText(candidate.down_score)],
      ["Rising-market score", scoreText(candidate.up_score)],
      ["Results used", `${candidate.down_tests}/${candidate.up_tests}`]
    ]
  };
}

const dataAsOf = humanDate(marketEnvironment.data_as_of);
---

<BaseLayout
  title="Market Regime AI Benchmark"
  description="See which AI models perform best when the S&P 500 falls, stays flat, or rises, with simple comparisons and fully checkable results."
>
  <section class="section market-regime-page regime-dashboard">
    <header class="mrb-hero" aria-labelledby="market-regime-title">
      <div class="mrb-hero-copy">
        <span class="panel-kicker">CapitalBench benchmark</span>
        <h1 id="market-regime-title">Market Regime Benchmark</h1>
        <p>
          A market regime is simply a type of market move: falling, flat, or rising. See which AI model portfolios do
          best in each one. Every market type gets the same importance in the main ranking.
        </p>
        <div class="mrb-hero-meta" aria-label="Benchmark metadata">
          <span>Updated <strong>{dataAsOf}</strong></span>
          <span><strong>Monthly and weekly</strong> views</span>
          <span><strong>Completed tests</strong> only</span>
        </div>
      </div>
      <div class="mrb-hero-question">
        <span>How this page works</span>
        <div><small>Models are ranked by</small><strong>Average return across market types</strong></div>
        <div><small>Models are compared with</small><strong>S&amp;P 500</strong></div>
        <div><small>A model gets a rank when</small><strong>It has enough results in every market type used</strong></div>
      </div>
    </header>

    <div class="mrb-context-bar" data-mrb-context-bar>
      <div class="mrb-track-switch" role="group" aria-label="Choose monthly or weekly results">
        {TRACKS.map((track) => (
          <button
            type="button"
            data-mrb-track={track}
            aria-pressed={track === DEFAULT_TRACK ? "true" : "false"}
            class:list={[track === DEFAULT_TRACK && "is-active"]}
          >
            {trackLabel(track)}
          </button>
        ))}
      </div>
      <nav class="mrb-section-links" aria-label="Benchmark sections">
        <a href="#equal-environment-ranking">Leaderboard</a>
        <a href="#direction-performance">Falling / rising</a>
        <a href="#environment-explorer">Market types</a>
        <a href="#performance-patterns">Patterns</a>
        <a href="#benchmark-evidence">Check results</a>
      </nav>
      <span class="sr-only" aria-live="polite" data-mrb-track-announcement>Monthly results selected</span>
    </div>

    <section class="mrb-section mrb-answer-section" aria-labelledby="benchmark-answer-title">
      <div class="mrb-section-head">
        <span class="panel-kicker">Quick answer</span>
        <div class="mrb-question-title">
          <h2 id="benchmark-answer-title">Who leads, and did they beat the S&amp;P 500?</h2>
          <span class="home-info-tip mrb-info-tip" tabindex="0" aria-label="The leader has the highest average return after each market type is given the same importance. Only models with enough matching results receive a rank.">
            <Info size={15} aria-hidden="true" />
          </span>
        </div>
        <p>Start here for the result. The charts and exact numbers below explain it.</p>
      </div>
      {TRACKS.map((track) => {
        const view = trackViews[track];
        const leader = view.leader;
        const alpha = leader?.averageAlpha;
        const benchmarkVerdict = finiteNumber(alpha)
          ? alpha > 0
            ? "Yes"
            : alpha < 0
              ? "No"
              : "It matched"
          : "Not enough data";
        return (
          <div data-mrb-track-panel={track} hidden={track !== DEFAULT_TRACK}>
            <div class="mrb-answer-grid">
              <article class="mrb-answer-card mrb-answer-card-leader">
                <span>Which model leads?</span>
                <div class="mrb-model-heading">
                  {leader?.logoSrc && <img src={leader.logoSrc} alt="" />}
                  <div>
                    <h3>{leader?.label ?? "Still building"}</h3>
                    <p>{leader?.providerName ?? "Not enough matching results yet"}</p>
                  </div>
                </div>
                <strong class:list={["mrb-answer-value", `is-${valueTone(leader?.averageReturn)}`]}>
                  {signedPctText(leader?.averageReturn)}
                </strong>
                <p>Average return across every market type with enough data.</p>
              </article>
              <article class:list={["mrb-answer-card", finiteNumber(alpha) && alpha >= 0 ? "is-success" : "is-warning"]}>
                <span>Did the leader beat the S&amp;P 500?</span>
                <h3>{benchmarkVerdict}</h3>
                <strong class:list={["mrb-answer-value", `is-${valueTone(alpha)}`]}>{pointText(alpha, true)}</strong>
                <p>
                  S&amp;P 500 average return across the same market types: <strong>{signedPctText(leader?.averageSp500Return)}</strong>
                </p>
              </article>
              <article class="mrb-answer-card">
                <span>How much data supports this?</span>
                <h3>{confidenceLabel(view.evidence)}</h3>
                <strong class="mrb-answer-value">{view.readyEnvironmentCount} of 5</strong>
                <p>
                  {view.readyEnvironmentCount} market types have enough matching results. Each ranked model contributes
                  {" "}{leader?.testsIncluded ?? 0} results.
                </p>
              </article>
            </div>
            {leader && finiteNumber(alpha) && alpha < 0 && (
              <p class="mrb-benchmark-alert">
                <strong>Important:</strong> {leader.label} ranks first among the models, but the S&amp;P 500 still did
                better across the same market types.
              </p>
            )}
          </div>
        );
      })}
    </section>

    <section id="equal-environment-ranking" class="mrb-section mrb-leaderboard-section" aria-labelledby="ranking-title">
      <div class="mrb-section-head">
        <span class="panel-kicker">Model ranking</span>
        <div class="mrb-question-title">
          <h2 id="ranking-title">Which model performs best across different markets?</h2>
          <span class="home-info-tip mrb-info-tip" tabindex="0" aria-label="We average each model's return within each market type, then give every market type the same importance. The S&P 500 is shown for comparison but is not ranked as a model.">
            <Info size={15} aria-hidden="true" />
          </span>
        </div>
        <p>Models are ranked by their average return across the market types that have enough data.</p>
      </div>
      {TRACKS.map((track) => {
        const view = trackViews[track];
        const leader = view.leader;
        return (
          <div data-mrb-track-panel={track} hidden={track !== DEFAULT_TRACK}>
            <div class="mrb-benchmark-definition" aria-label={`${view.label} benchmark specification`}>
              <div><span>Models are ranked by</span><strong>Average return across market types</strong><small>Higher is better</small></div>
              <div><span>Market types used</span><strong>{view.readyEnvironmentCount} of 5</strong><small>Enough results to compare</small></div>
              <div><span>Models ranked</span><strong>{view.comparableRows.length}</strong><small>{view.limitedRows.length} need more results</small></div>
              <div><span>Results used</span><strong>{leader?.testsIncluded ?? 0} per model</strong><small>Same dates for every ranked model</small></div>
            </div>

            <div class="mrb-benchmark-charts">
              <article class="mrb-chart-panel mrb-chart-panel-primary">
                <header>
                  <div>
                    <span>Main ranking</span>
                    <div class="mrb-chart-question">
                      <h3>Who had the highest average return?</h3>
                      <span class="home-info-tip mrb-info-tip mrb-info-tip-small" tabindex="0" aria-label="This average gives every market type the same importance. Bars use actual returns, and the S&P 500 appears in gold for comparison.">
                        <Info size={14} aria-hidden="true" />
                      </span>
                    </div>
                  </div>
                  <p>Bars to the right are gains. Bars to the left are losses.</p>
                </header>
                <div class="mrb-chart-body">
                  <BenchmarkBarChart
                    rows={view.returnChartRows}
                    domain={view.returnChartDomain}
                    format="percent"
                    orientation="responsive"
                    showLegend={true}
                    ariaLabel={`${view.label} average returns across market types`}
                  />
                </div>
              </article>

              <article class="mrb-chart-panel mrb-chart-panel-score">
                <header>
                  <div>
                    <span>Score view</span>
                    <div class="mrb-chart-question">
                      <h3>How did each model score?</h3>
                      <span class="home-info-tip mrb-info-tip mrb-info-tip-small" tabindex="0" aria-label="CapitalBench Score compares each result with the S&P 500 and the best available investment after prices are known. A score of 100 matches that best-after-the-fact result.">
                        <Info size={14} aria-hidden="true" />
                      </span>
                    </div>
                  </div>
                  <p>100 is the best possible result after the fact. It is a reference, not a real portfolio.</p>
                </header>
                <BenchmarkBarChart
                  rows={view.scoreChartRows}
                  domain={view.scoreChartDomain}
                  format="score"
                  orientation="horizontal"
                  compact={true}
                  showLegend={true}
                  ariaLabel={`${view.label} CapitalBench Scores across market types`}
                />
              </article>
            </div>

            <div class="mrb-reference-banner">
              <span class="mrb-sp500-mark">S&amp;P</span>
              <p>
                <strong>S&amp;P 500 comparison:</strong> {signedPctText(leader?.averageSp500Return)} average return and
                {" "}{scoreText(leader?.sp500Score)} CapitalBench Score across the same market types.
              </p>
              <span>{view.readyEnvironmentCount} market types used</span>
            </div>

            <div class="mrb-exact-results-head">
              <div><span>Exact numbers</span><h3>What are the full {view.label.toLowerCase()} results?</h3></div>
              <p>Rank follows average return. The other columns show how the result was built.</p>
            </div>
            <div class="mrb-data-scroll" tabindex="0" aria-label={`${view.label} ranking across market types`}>
              <table class="mrb-ranking-table">
                <thead>
                  <tr>
                    <th>Rank and model</th>
                    <th>Average return</th>
                    <th>Difference from S&amp;P</th>
                    <th>CapitalBench Score</th>
                    <th>Market types</th>
                    <th>Results used</th>
                    <th>Beat S&amp;P</th>
                  </tr>
                </thead>
                <tbody>
                  {view.comparableRows.map((row: any, index: number) => (
                    <tr class:list={[index === 0 && "is-leader"]}>
                      <th scope="row">
                        <span class="mrb-row-rank">{index + 1}</span>
                        {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                        <span><a href={`/models/${row.modelId}`}>{row.label}</a><small>{row.providerName}</small></span>
                      </th>
                      <td class:list={[`is-${valueTone(row.averageReturn)}`]}><strong>{signedPctText(row.averageReturn)}</strong></td>
                      <td class:list={[`is-${valueTone(row.averageAlpha)}`]}><strong>{pointText(row.averageAlpha, true)}</strong></td>
                      <td>{scoreText(row.balancedScore)}</td>
                      <td>{row.covered}/{row.required}</td>
                      <td>{row.testsIncluded}</td>
                      <td>{finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {view.limitedRows.length > 0 && (
              <details class="mrb-limited-history">
                <summary>Models that need more results <span>{view.limitedRows.length}</span></summary>
                <p class="mrb-limited-note">These models are shown, but they do not receive a rank until they have enough matching results in every market type used.</p>
                <div class="mrb-data-scroll" tabindex="0">
                  <table class="mrb-ranking-table">
                    <thead><tr><th>Model</th><th>Return so far</th><th>Difference from S&amp;P</th><th>Market types</th><th>Results used</th></tr></thead>
                    <tbody>
                      {view.limitedRows.map((row: any) => (
                        <tr>
                          <th scope="row">{row.logoSrc && <img src={row.logoSrc} alt="" />}<span><a href={`/models/${row.modelId}`}>{row.label}</a><small>{row.providerName}</small></span></th>
                          <td>{signedPctText(row.averageReturn)}</td>
                          <td>{pointText(row.averageAlpha, true)}</td>
                          <td>{row.covered}/{row.required}</td>
                          <td>{row.testsIncluded}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            )}
          </div>
        );
      })}
    </section>

    <aside class="mrb-reading-guide" aria-label="How to read this page">
      <div><span>1</span><p><strong>Check the S&amp;P 500</strong> A model can rank first and still do worse than the market.</p></div>
      <div><span>2</span><p><strong>Use the same dates</strong> Models are compared only on dates every model shown completed.</p></div>
      <div><span>3</span><p><strong>Count each market type equally</strong> Falling, flat, and rising markets get the same importance.</p></div>
    </aside>

    <section id="direction-performance" class="mrb-section" aria-labelledby="direction-title">
      <div class="mrb-section-head">
        <span class="panel-kicker">Falling and rising markets</span>
        <div class="mrb-question-title">
          <h2 id="direction-title">Who does best when markets fall or rise?</h2>
          <span class="home-info-tip mrb-info-tip" tabindex="0" aria-label="These two charts separate falling and rising markets. Both use the same scale and only dates completed by every model shown.">
            <Info size={15} aria-hidden="true" />
          </span>
        </div>
        <p>Each chart uses the same dates for every model shown, with the S&amp;P 500 beside them.</p>
      </div>
      {TRACKS.map((track) => {
        const view = trackViews[track];
        return (
          <div data-mrb-track-panel={track} hidden={track !== DEFAULT_TRACK}>
            <div class="mrb-direction-grid">
              {(["down", "up"] as DirectionKey[]).map((key) => {
                const direction = view.directions.find((candidate: any) => candidate.key === key);
                if (!direction) return null;
                return (
                  <article class:list={["mrb-direction-panel", `is-${key}`]}>
                    <header>
                      <div>
                        <span>{key === "down" ? "Market fell" : "Market rose"}</span>
                        <h3>{key === "down" ? "When the S&P 500 fell" : "When the S&P 500 rose"}</h3>
                        <p>{direction.range_label}</p>
                      </div>
                      <span class:list={["mrb-evidence", `is-${direction.confidence}`]}>
                        {confidenceLabel(direction.confidence)}
                      </span>
                    </header>
                    <p class="mrb-direction-verdict">{comparisonStatement(direction.best, key === "down" ? "when the market fell" : "when the market rose")}</p>
                    {direction.modelRows.length ? (
                      <>
                        <BenchmarkBarChart
                          rows={view.directionChartRows[key]}
                          domain={view.directionDomain}
                          format="percent"
                          orientation="horizontal"
                          compact={true}
                          ariaLabel={`${view.label} returns ${key === "down" ? "when the market fell" : "when the market rose"}`}
                        />
                        <p class="mrb-chart-scale-note">Both charts use the same scale, with zero in the middle.</p>
                        <details class="mrb-exact-values">
                          <summary>Show exact numbers and ranks</summary>
                          <div class="mrb-compact-table-scroll">
                            <table class="mrb-direction-table">
                              <thead>
                                <tr><th>Model</th><th>Return</th><th>vs S&amp;P</th></tr>
                              </thead>
                              <tbody>
                                <tr class="mrb-reference-row">
                                  <th scope="row"><span class="mrb-inline-model"><span class="mrb-sp500-mark">S&amp;P</span> S&amp;P 500</span></th>
                                  <td>{signedPctText(direction.averageSp500Return)}</td>
                                  <td>Comparison</td>
                                </tr>
                                {direction.modelRows.map((row: any, index: number) => (
                                  <tr>
                                    <th scope="row">
                                      <span class="mrb-inline-model">
                                        <span class="mrb-row-rank">{index + 1}</span>
                                        {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                                        <a href={`/models/${row.modelId}`} title={row.label}>{row.label}</a>
                                      </span>
                                    </th>
                                    <td class:list={[`is-${valueTone(row.average_return)}`]}>{signedPctText(row.average_return)}</td>
                                    <td class:list={[`is-${valueTone(row.average_alpha)}`]}>{pointText(row.average_alpha, true)}</td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </details>
                      </>
                    ) : (
                      <p class="mrb-empty-state">
                        {direction.rawCount} result{direction.rawCount === 1 ? " is" : "s are"} available, but not
                        enough dates were completed by every model.
                      </p>
                    )}
                    <dl class="mrb-evidence-stats">
                      <div><dt>Dates used</dt><dd>{direction.sharedCount} of {direction.rawCount}</dd></div>
                      <div><dt>Models compared</dt><dd>{direction.eligibleModelCount || "n/a"}</dd></div>
                      <div><dt>Leader repeated</dt><dd>{stabilityText(direction.stability)}</dd></div>
                      <div><dt>Lead over #2</dt><dd>{pointText(direction.leaderMargin, true)}</dd></div>
                    </dl>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </section>

    <section id="environment-explorer" class="mrb-section" aria-labelledby="environment-title">
      <div class="mrb-section-head">
        <span class="panel-kicker">Market types</span>
        <div class="mrb-question-title">
          <h2 id="environment-title">How did each model perform in each type of market?</h2>
          <span class="home-info-tip mrb-info-tip" tabindex="0" aria-label="We group each completed test by how much the S&P 500 moved. The large number is model return. The smaller number is how far it was above or below the S&P 500 on the same dates.">
            <Info size={15} aria-hidden="true" />
          </span>
        </div>
        <p>The table shows model return first, followed by the difference from the S&amp;P 500.</p>
      </div>

      <div class="mrb-threshold-strip" aria-label="S&P 500 market-type ranges and result counts">
        {thresholdCards.map((environment) => (
          <article class:list={[`is-${environment.key}`]}>
            <span class="mrb-environment-swatch" aria-hidden="true"></span>
            <strong>{environment.label}</strong>
            <span>Weekly: {environment.weeklyRange}</span>
            <span>Monthly: {environment.monthlyRange}</span>
            <small>{environment.weeklyCount} weekly / {environment.monthlyCount} monthly results</small>
          </article>
        ))}
      </div>

      {TRACKS.map((track) => {
        const view = trackViews[track];
        return (
          <div data-mrb-track-panel={track} hidden={track !== DEFAULT_TRACK}>
            <div class="mrb-data-scroll mrb-matrix-scroll" tabindex="0" aria-label={`${view.label} results by market type`}>
              <table class="mrb-matrix-table">
                <thead>
                  <tr>
                    <th scope="col">Model</th>
                    {view.environments.map((environment: any) => (
                      <th scope="col">
                        <strong>{environment.plainLabel}</strong>
                        <span>{environment.range_label}</span>
                        <small>{environment.sharedCount}/{environment.rawCount} dates used</small>
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  <tr class="mrb-matrix-reference">
                    <th scope="row"><span class="mrb-sp500-mark">S&amp;P</span><span>S&amp;P 500<small>Comparison</small></span></th>
                    {view.environments.map((environment: any) => (
                      <td>
                        <strong class:list={[`is-${valueTone(environment.sharedSp500Return ?? environment.average_sp500_return)}`]}>
                          {signedPctText(environment.sharedSp500Return ?? environment.average_sp500_return)}
                        </strong>
                        <small>{finiteNumber(environment.sharedSp500Return) ? "same dates" : "all available dates"}</small>
                      </td>
                    ))}
                  </tr>
                  {view.matrixRows.map((row: any, index: number) => (
                    <tr class:list={[!row.comparable && "mrb-limited-row"]}>
                      <th scope="row">
                        <span class="mrb-row-rank">{row.comparable ? index + 1 : "-"}</span>
                        {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                        <span>{row.label}<small>{row.comparable ? `${row.covered}/${row.required} market types` : "Needs more matching results"}</small></span>
                      </th>
                      {row.cells.map((cell: any) => (
                        <td>
                          {finiteNumber(cell.returnValue) ? (
                            <>
                              <strong class:list={[`is-${valueTone(cell.returnValue)}`]}>{signedPctText(cell.returnValue)}</strong>
                              <small class:list={[`is-${valueTone(cell.alpha)}`]}>{pointText(cell.alpha, true)} vs S&amp;P</small>
                            </>
                          ) : (
                            <><strong>n/a</strong><small>Not enough matching results</small></>
