                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="mrb-environment-details">
              {view.environments.map((environment: any) => (
                <details class:list={[`is-${environment.key}`]}>
                  <summary>
                    <span class="mrb-environment-swatch" aria-hidden="true"></span>
                    <span><strong>{environment.plainLabel}</strong><small>{environment.range_label}</small></span>
                    <span><strong>{environment.sharedCount}/{environment.rawCount}</strong><small>used / available</small></span>
                    <span class:list={["mrb-evidence", `is-${environment.confidence}`]}>{confidenceLabel(environment.confidence)}</span>
                  </summary>
                  <div class="mrb-environment-detail-body">
                    {environment.modelRows.length ? (
                      <>
                        <p>{comparisonStatement(environment.modelRows[0], `during a ${environment.plainLabel.toLowerCase()}`)}</p>
                        <div class="mrb-environment-chart">
                          <BenchmarkBarChart
                            rows={view.environmentChartRows[environment.key]}
                            domain={view.environmentDomain}
                            format="percent"
                            orientation="horizontal"
                            compact={true}
                            ariaLabel={`${view.label} model and S&P 500 returns during a ${environment.plainLabel.toLowerCase()}`}
                          />
                          <p class="mrb-chart-scale-note">Every {view.label.toLowerCase()} market-type chart uses this same scale.</p>
                        </div>
                        <dl class="mrb-evidence-stats">
                          <div><dt>Models compared</dt><dd>{environment.eligibleModelCount}</dd></div>
                          <div><dt>Leader repeated</dt><dd>{stabilityText(environment.stability)}</dd></div>
                          <div><dt>Lead over #2</dt><dd>{pointText(environment.leaderMargin, true)}</dd></div>
                          <div><dt>Estimated range for #1</dt><dd>{finiteNumber(environment.leaderCiLow) ? `${signedPctText(environment.leaderCiLow)} to ${signedPctText(environment.leaderCiHigh)}` : "n/a"}</dd></div>
                        </dl>
                      </>
                    ) : (
                      <p>
                        {environment.rawCount === 0
                          ? "No completed tests fall into this market type yet."
                          : `${environment.rawCount} result${environment.rawCount === 1 ? " is" : "s are"} available. ${Math.max(0, READY_ROUND_THRESHOLD - environment.rawCount)} more needed before models can be compared here.`}
                      </p>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </div>
        );
      })}
    </section>

    <section id="performance-patterns" class="mrb-section" aria-labelledby="insights-title">
      <div class="mrb-section-head">
        <span class="panel-kicker">What the results show</span>
        <div class="mrb-question-title">
          <h2 id="insights-title">What patterns stand out?</h2>
          <span class="home-info-tip mrb-info-tip" tabindex="0" aria-label="These statements summarize the clearest patterns in the completed results. Each one shows how many dates were used and whether the same leader usually stays first when one date is removed.">
            <Info size={15} aria-hidden="true" />
          </span>
        </div>
        <p>Each statement shows the result and how much data supports it.</p>
      </div>
      {TRACKS.map((track) => {
        const view = trackViews[track];
        const primarySignals = view.signals.filter((signal: any) => signal.kind === "direction_leader");
        const secondarySignals = view.signals.filter((signal: any) => signal.kind !== "direction_leader");
        return (
          <div
            id={`market-environment-insight-${track}-synthesis`}
            data-mrb-track-panel={track}
            hidden={track !== DEFAULT_TRACK}
          >
            <div class="mrb-insight-grid">
              {primarySignals.map((signal: any) => {
                const insight = insightView(signal);
                return (
                  <article
                    id={`market-environment-insight-${signal.key}`}
                    class:list={["mrb-insight", `is-${insight.tone}`]}
                  >
                    <header><span>{insight.eyebrow}</span><strong>{insight.status}</strong></header>
                    <div class="mrb-insight-copy">
                      <h3>{insight.title}</h3>
                      <p>{insight.detail}</p>
                    </div>
                    <div class="mrb-insight-metric"><strong>{insight.metric}</strong><span>{insight.metricLabel}</span></div>
                    {insight.stats.length > 0 && (
                      <dl>
                        {insight.stats.map((stat: any[]) => (
                          <div><dt>{stat[0]}</dt><dd>{stat[1]}</dd></div>
