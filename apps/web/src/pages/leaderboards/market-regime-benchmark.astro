            {secondarySignals.length > 0 && (
              <details class="mrb-secondary-insights">
                <summary>Show more patterns across market types <span>{secondarySignals.length}</span></summary>
                <div class="mrb-insight-grid">
                  {secondarySignals.map((signal: any) => {
                    const insight = insightView(signal);
                    return (
                      <article
                        id={`market-environment-insight-${signal.key}`}
                        class:list={["mrb-insight", `is-${insight.tone}`]}
                      >
                        <header><span>{insight.eyebrow}</span><strong>{insight.status}</strong></header>
                        <div class="mrb-insight-copy">
                          <h3>{insight.title}</h3>
                          <p>{insight.detail}</p>
                        </div>
                        <div class="mrb-insight-metric"><strong>{insight.metric}</strong><span>{insight.metricLabel}</span></div>
                        {insight.stats.length > 0 && (
                          <dl>
                            {insight.stats.map((stat: any[]) => (
                              <div><dt>{stat[0]}</dt><dd>{stat[1]}</dd></div>
                            ))}
                          </dl>
                        )}
                      </article>
                    );
                  })}
                </div>
              </details>
            )}
          </div>
        );
      })}
    </section>

    <section id="benchmark-evidence" class="mrb-section mrb-evidence-section" aria-labelledby="evidence-title">
      <div class="mrb-section-head">
        <span class="panel-kicker">Check the work</span>
        <div class="mrb-question-title">
          <h2 id="evidence-title">How can you check these results?</h2>
          <span class="home-info-tip mrb-info-tip" tabindex="0" aria-label="Open these sections to see the calculation, test whether the ranking changes with equal sample sizes, and inspect every completed test used by the page.">
            <Info size={15} aria-hidden="true" />
          </span>
        </div>
        <p>The method, a second ranking check, and every included test are available below.</p>
      </div>

      <details class="mrb-disclosure">
        <summary>
          <span class="mrb-disclosure-label">Simple method</span>
          <strong>How are the results calculated?</strong>
          <em>Same dates, clear market groups, and equal importance</em>
          <span class="mrb-disclosure-toggle" aria-hidden="true"><ChevronDown size={18} /></span>
        </summary>
        <div class="mrb-method-body">
          <div class="mrb-method-steps">
            <article><span>1</span><h3>Use completed tests</h3><p>Open tests do not count. Only finished results are included.</p></article>
            <article><span>2</span><h3>Group each market move</h3><p>Each test is placed in a market type using the S&amp;P 500 return over the same dates.</p></article>
            <article><span>3</span><h3>Compare the same dates</h3><p>A chart uses only dates completed by every model shown in that chart.</p></article>
            <article><span>4</span><h3>Give each type equal importance</h3><p>A market type needs at least {READY_ROUND_THRESHOLD} results before it affects the main ranking.</p></article>
          </div>
          <dl class="mrb-metric-dictionary">
            <div><dt>Average return</dt><dd>The model portfolio's average gain or loss on the dates shown.</dd></div>
            <div><dt>Difference from S&amp;P</dt><dd>Model return minus S&amp;P 500 return on the same dates.</dd></div>
            <div><dt>Average across market types</dt><dd>First average each market type, then average those results so every type matters equally.</dd></div>
            <div><dt>CapitalBench Score</dt><dd>A score that compares the model with the S&amp;P 500 and the best available choice after the fact. <a href="/scoring">See the formula</a>.</dd></div>
            <div><dt>Beat-S&amp;P rate</dt><dd>The percentage of included tests where the model did better than the S&amp;P 500.</dd></div>
            <div><dt>Leader repeated</dt><dd>How often the same model stays first when one date is removed and the ranking is recalculated.</dd></div>
          </dl>
          <p class="mrb-method-note">
            Weekly and monthly periods can overlap, so do not add them together as if they were separate trades.
            Result-strength labels describe how much data supports a comparison; they do not promise what will happen next.
          </p>
        </div>
      </details>

      <details class="mrb-disclosure">
        <summary>
          <span class="mrb-disclosure-label">Second check</span>
          <strong>Does the ranking change with equal sample sizes?</strong>
          <em>Uses the same number of falling, flat, and rising market results</em>
          <span class="mrb-disclosure-toggle" aria-hidden="true"><ChevronDown size={18} /></span>
        </summary>
        <div class="mrb-disclosure-body">
          {TRACKS.map((track) => {
            const view = trackViews[track];
            const sample = view.balancedSample;
            return (
              <div data-mrb-track-panel={track} hidden={track !== DEFAULT_TRACK}>
                <div class="mrb-sample-head">
                  <div><span>{view.label} second check</span><h3>{sample.status === "ready" ? `${sample.sampleSize} results used for each market move` : "More results are needed for this check"}</h3></div>
                  <strong class:list={["mrb-evidence", sample.status === "ready" ? "is-medium" : "is-low"]}>{sample.status === "ready" ? "Ready" : "Not enough data"}</strong>
                </div>
                <div class="mrb-sample-progress">
                  {sample.categories.map((category: any) => (
                    <article class:list={[`is-${category.key}`]}>
                      <span>{category.label}</span>
                      <strong>{category.count}</strong>
                      <small>{sample.status === "ready" ? `${category.selectedCount} used` : category.missing ? `${category.missing} more needed` : "Enough results"}</small>
                      <i style={`--sample-width:${Math.min(100, (category.count / BALANCED_SAMPLE_THRESHOLD) * 100)}%`}></i>
                    </article>
                  ))}
                </div>
                {sample.status === "ready" ? (
                  <>
                    <div class="mrb-data-scroll" tabindex="0">
                      <table class="mrb-ranking-table">
                        <thead><tr><th>Rank and model</th><th>Score</th><th>Difference from S&amp;P</th><th>Beat S&amp;P</th><th>Results used</th><th>Change from main rank</th></tr></thead>
                        <tbody>
                          {sample.comparableRows.map((row: any, index: number) => (
                            <tr>
                              <th scope="row"><span class="mrb-row-rank">{index + 1}</span>{row.logoSrc && <img src={row.logoSrc} alt="" />}<span>{row.label}<small>{row.providerName}</small></span></th>
                              <td>{scoreText(row.score)}</td><td>{pointText(row.averageAlpha, true)}</td><td>{finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}</td><td>{row.testsIncluded}/{row.testsRequired}</td><td>{rankChange(view, row.modelId, index + 1)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    {sample.limitedRows.length > 0 && <p class="mrb-method-note">{sample.limitedRows.length} model{sample.limitedRows.length === 1 ? " does" : "s do"} not have enough matching results for this second check and {sample.limitedRows.length === 1 ? "receives" : "receive"} no rank.</p>}
                    <details class="mrb-selected-rounds">
                      <summary>View the {sample.selectedRoundIds.length} tests used</summary>
                      <div>{sample.selectedRoundIds.map((roundId: string) => <a href={`/rounds/${roundId}`}>{roundId}</a>)}</div>
                    </details>
                  </>
                ) : (
                  <p class="mrb-empty-state">
                    This check needs at least {BALANCED_SAMPLE_THRESHOLD} falling, {BALANCED_SAMPLE_THRESHOLD} flat,
                    and {BALANCED_SAMPLE_THRESHOLD} rising market results before it can rank models.
                  </p>
                )}
              </div>
            );
          })}
        </div>
      </details>

      <details class="mrb-disclosure">
        <summary>
          <span class="mrb-disclosure-label">Full list</span>
          <strong>Which completed tests are included?</strong>
          <em>{auditRows.length} tests with filters and source links</em>
          <span class="mrb-disclosure-toggle" aria-hidden="true"><ChevronDown size={18} /></span>
        </summary>
        <div class="mrb-disclosure-body">
          <div class="mrb-audit-tools">
            <label><span>Find a test</span><input type="search" placeholder="CB-2026..." data-mrb-audit-search /></label>
            <label><span>View</span><select data-mrb-audit-track><option value="all">Monthly and weekly</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></label>
            <label><span>Market type</span><select data-mrb-audit-environment><option value="all">All market types</option>{thresholdCards.map((environment) => <option value={environment.key}>{environment.label}</option>)}</select></label>
            <a class="mrb-data-link" href="/api/v1/market-environments?track=all">Open the data</a>
          </div>
          <p class="mrb-audit-count" data-mrb-audit-count>Showing 10 of {auditRows.length} tests</p>
          <div class="mrb-audit-table" role="table" aria-label="Completed tests included in this benchmark">
            <div class="mrb-audit-header" role="row"><span>Test</span><span>View</span><span>Dates</span><span>S&amp;P return</span><span>Market type</span><span>Avg. model difference</span><span>Models</span></div>
            {auditRows.map((row: any, index: number) => (
              <div
                class="mrb-audit-row"
                role="row"
                data-audit-row
                data-index={index}
                data-track={row.track}
                data-environment={row.environmentKey}
                data-round={String(row.round_id).toLowerCase()}
              >
                <span role="cell" data-label="Test"><a href={`/rounds/${row.round_id}`}>{row.round_id}</a></span>
                <span role="cell" data-label="View">{trackLabel(row.track)}</span>
                <span role="cell" data-label="Dates">{dateOnly(row.entry_date)} to {dateOnly(row.exit_date)}</span>
                <span role="cell" data-label="S&P return" class:list={[`is-${valueTone(row.sp500_return)}`]}>{signedPctText(row.sp500_return)}</span>
                <span role="cell" data-label="Market type">{row.environmentLabel}</span>
                <span role="cell" data-label="Avg. model difference" class:list={[`is-${valueTone(row.average_alpha)}`]}>{pointText(row.average_alpha, true)}</span>
                <span role="cell" data-label="Models">{row.model_count}</span>
              </div>
            ))}
          </div>
          <p class="mrb-empty-state" data-mrb-audit-empty hidden>No tests match these filters.</p>
          <button type="button" class="mrb-show-more" data-mrb-audit-more>Show all {auditRows.length} tests</button>
        </div>
      </details>
    </section>
  </section>

