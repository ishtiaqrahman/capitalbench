      .mrb-data-link { grid-column: auto; justify-self: stretch; }
      .mrb-audit-header { display: none; }
      .mrb-audit-table { overflow: visible; border: 0; background: transparent; }
      .mrb-audit-row {
        min-width: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
