            <table>
              <thead>
                <tr>
                  <th>Round</th>
                  <th>Track</th>
                  <th>Window</th>
                  <th>S&amp;P 500 return</th>
                  <th>Market type</th>
                  <th>Avg model alpha</th>
                  <th>Hit rate</th>
                  <th>Models</th>
