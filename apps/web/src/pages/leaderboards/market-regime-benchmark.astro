---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarketRegimeLineChart from "../../components/MarketRegimeLineChart.astro";
import { modelLabel, providerLabel, type RoundRecord } from "../../data/fallback";
import apiReadModel from "../../generated/apiReadModel.js";
import { dateOnly, pct } from "../../lib/format";
import { staticRoundRecords } from "../../lib/localRoundRecords";
import { providerLogoSrc } from "../../lib/scoreReturnChart";
import type { BenchmarkTrack } from "../../lib/tracks";

type RegimeKey = "sharp_down" | "down" | "flat" | "up" | "sharp_up";
type RegimeDirection = "down" | "flat" | "up";
type RegimeStatus = "Ready" | "Forming" | "No data yet";
type SampleCategoryKey = "down" | "flat" | "up";

type RegimeDefinition = {
  key: RegimeKey;
  label: string;
  rangeLabel: string;
  direction: RegimeDirection;
};

type RegimeRound = {
  round: RoundRecord;
  track: BenchmarkTrack;
  regime: RegimeDefinition;
  directionKey: SampleCategoryKey;
  sp500Return: number;
  maxPossibleReturn: number;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  modelCount: number;
};

type RegimeCoverage = RegimeDefinition & {
  count: number;
  averageSp500Return: number | undefined;
  status: RegimeStatus;
  rounds: RegimeRound[];
};

type SampleCategoryDefinition = {
  key: SampleCategoryKey;
  label: string;
  rangeLabel: string;
};

type RegimeLeaderboardRow = {
  modelId: string;
  provider: string;
  label: string;
  providerName: string;
  logoSrc: string | undefined;
  averageReturn: number | undefined;
  averageSp500Return: number | undefined;
  regimeBalancedScore: number | undefined;
  sp500RegimeScore: number | undefined;
  allRoundScore: number | undefined;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  testsIncluded: number;
  readyRegimesCovered: number;
  readyRegimesRequired: number;
  status: "Ready" | "Forming";
  regimeScores: Array<{
    key: RegimeKey;
    label: string;
    score: number | undefined;
    averageReturn: number | undefined;
    averageSp500Return: number | undefined;
    tests: number;
  }>;
};

type BalancedSampleCategory = SampleCategoryDefinition & {
  count: number;
  missing: number;
  selectedCount: number;
};

type BalancedSampleLeaderboardRow = {
  modelId: string;
  provider: string;
  label: string;
  providerName: string;
  logoSrc: string | undefined;
  score: number | undefined;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  testsIncluded: number;
  testsRequired: number;
  status: "Ready" | "Forming";
};

type BalancedSampleTrack = {
  track: BenchmarkTrack;
  status: "Ready" | "Forming";
  categories: BalancedSampleCategory[];
  sampleSize: number;
  selectedRounds: RegimeRound[];
  missingSummary: string;
  leaderboard: BalancedSampleLeaderboardRow[];
};

type DirectionModelRow = {
  modelId: string;
  provider: string;
  label: string;
  providerName: string;
  logoSrc: string | undefined;
  score: number | undefined;
  averageReturn: number | undefined;
  averageSp500Return: number | undefined;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  tests: number;
};

type EnvironmentPerformanceCard = RegimeCoverage & {
  track: BenchmarkTrack;
  modelRows: DirectionModelRow[];
  best: DirectionModelRow | undefined;
  worst: DirectionModelRow | undefined;
};

type EnvironmentMatrixRow = {
  modelId: string;
  label: string;
  providerName: string;
  logoSrc: string | undefined;
  averageReturn: number | undefined;
  cells: Array<{
    key: RegimeKey;
    label: string;
    value: number | undefined;
    rank: number | undefined;
    width: number;
  }>;
};

type DirectionPerformanceCard = {
  track: BenchmarkTrack;
  key: "negative" | "positive";
  label: string;
  rangeLabel: string;
  rounds: RegimeRound[];
  averageSp500Return: number | undefined;
  status: "Ready" | "Forming";
  best: DirectionModelRow | undefined;
  worst: DirectionModelRow | undefined;
};

type DirectionBucket = SampleCategoryDefinition & {
  track: BenchmarkTrack;
  rounds: RegimeRound[];
  status: "Ready" | "Forming";
  averageSp500Return: number | undefined;
  modelRows: DirectionModelRow[];
};

type MarketInsightCard = {
  key: string;
  eyebrow: string;
  title: string;
  tone: "down" | "flat" | "up" | "steady" | "split";
  status: "Ready" | "Forming";
  model?: {
    label: string;
    providerName: string;
    logoSrc: string | undefined;
  };
  metricValue: string;
  metricLabel: string;
  detail: string;
  stats: Array<{
    label: string;
    value: string;
  }>;
};

type ChartValueFormat = "percent" | "score" | "count";

type RawChartPoint = {
  label: string;
  value: number;
};

type RawChartSeries = {
  key: string;
  label: string;
  color: string;
  points: RawChartPoint[];
  isLead?: boolean;
};

type LineChart = {
  id: string;
  title: string;
  description: string;
  minLabel: string;
  maxLabel: string;
  series: Array<{
    key: string;
    label: string;
    color: string;
    points: Array<{
      x: number;
      y: number;
      label: string;
      valueLabel: string;
    }>;
    pointsAttr: string;
    isLead?: boolean;
  }>;
  baseline?: {
    label: string;
    y: number;
  };
  threshold?: {
    label: string;
    y: number;
  };
};

const marketEnvironment: any = apiReadModel.market_environment ?? { thresholds: {}, definitions: {}, tracks: {} };
const READY_ROUND_THRESHOLD = Number(marketEnvironment.thresholds?.environment_rounds ?? 3);
const BALANCED_SAMPLE_THRESHOLD = Number(marketEnvironment.thresholds?.balanced_sample_per_direction ?? 3);
const CHART_WIDTH = 640;
const CHART_HEIGHT = 190;
const CHART_LEFT = 42;
const CHART_RIGHT = 30;
const CHART_TOP = 30;
const CHART_BOTTOM = 32;

function mapRegimeDefinition(row: any): RegimeDefinition {
  return {
    key: row.key,
    label: row.label,
    rangeLabel: row.range_label,
    direction: row.direction
  };
}

function mapSampleDefinition(row: any): SampleCategoryDefinition {
  return { key: row.key, label: row.label, rangeLabel: row.range_label };
}

const regimeDefinitions: Record<BenchmarkTrack, RegimeDefinition[]> = {
  weekly: (marketEnvironment.definitions?.weekly?.environments ?? []).map(mapRegimeDefinition),
  monthly: (marketEnvironment.definitions?.monthly?.environments ?? []).map(mapRegimeDefinition)
};

const sampleCategoryDefinitions: Record<BenchmarkTrack, SampleCategoryDefinition[]> = {
  weekly: (marketEnvironment.definitions?.weekly?.directions ?? []).map(mapSampleDefinition),
  monthly: (marketEnvironment.definitions?.monthly?.directions ?? []).map(mapSampleDefinition)
};

function finiteNumber(value: number | null | undefined): value is number {
  return typeof value === "number" && Number.isFinite(value);
}


function scoreText(value: number | undefined): string {
  return finiteNumber(value) ? value.toFixed(1) : "n/a";
}

function signedPctText(value: number | undefined): string {
  if (!finiteNumber(value)) return "n/a";
  const formatted = pct(value);
  return value > 0 ? `+${formatted}` : formatted;
}

function valueTone(value: number | undefined): "positive" | "negative" | "neutral" {
  if (!finiteNumber(value) || value === 0) return "neutral";
  return value > 0 ? "positive" : "negative";
}

function performanceBarWidth(index: number, total: number): number {
  if (total <= 1) return 100;
  const minWidth = 34;
  return Math.round(100 - index / (total - 1) * (100 - minWidth));
}

function environmentReturnBarWidth(environment: EnvironmentPerformanceCard, value: number | undefined): number {
  if (!finiteNumber(value)) return 0;
  const values = [environment.averageSp500Return, ...environment.modelRows.map((row) => row.averageReturn)]
    .filter(finiteNumber)
    .sort((left, right) => right - left);
  if (values.length <= 1) return 100;
  const index = values.findIndex((item) => item === value);
  return performanceBarWidth(index >= 0 ? index : values.length - 1, values.length);
}


function chartValueText(value: number, format: ChartValueFormat): string {
  if (format === "percent") {
    const sign = value > 0 ? "+" : "";
    return `${sign}${value.toFixed(1)}%`;
  }
  if (format === "count") return Math.round(value).toString();
  return value.toFixed(1);
}

function chartY(value: number, min: number, max: number): number {
  if (max === min) return CHART_TOP + (CHART_HEIGHT - CHART_TOP - CHART_BOTTOM) / 2;
  const usableHeight = CHART_HEIGHT - CHART_TOP - CHART_BOTTOM;
  return CHART_TOP + (max - value) / (max - min) * usableHeight;
}

function chartBounds(values: number[], options?: { includeZero?: boolean; threshold?: number; floorZero?: boolean }) {
  const boundedValues = values.slice();
  if (options?.includeZero) boundedValues.push(0);
  if (finiteNumber(options?.threshold)) boundedValues.push(options.threshold);

  let min = boundedValues.length ? Math.min(...boundedValues) : 0;
  let max = boundedValues.length ? Math.max(...boundedValues) : 1;
  if (options?.floorZero) min = Math.min(0, min);

  if (min === max) {
    min -= 1;
    max += 1;
  } else if (!options?.floorZero) {
    const padding = (max - min) * 0.12;
    min -= padding;
    max += padding;
  } else {
    max += Math.max(1, (max - min) * 0.16);
  }

  return { min, max };
}

function buildLineChart(options: {
  id: string;
  title: string;
  description: string;
  format: ChartValueFormat;
  series: RawChartSeries[];
  includeZero?: boolean;
  threshold?: { value: number; label: string };
  floorZero?: boolean;
}): LineChart {
  const values = options.series.flatMap((series) => series.points.map((point) => point.value)).filter(finiteNumber);
  const bounds = chartBounds(values, {
    includeZero: options.includeZero,
    threshold: options.threshold?.value,
    floorZero: options.floorZero
  });
  const xSpan = CHART_WIDTH - CHART_LEFT - CHART_RIGHT;

  return {
    id: options.id,
    title: options.title,
    description: options.description,
    minLabel: chartValueText(bounds.min, options.format),
    maxLabel: chartValueText(bounds.max, options.format),
    series: options.series.map((series) => {
      const denominator = Math.max(1, series.points.length - 1);
      const points = series.points.map((point, index) => ({
        x: CHART_LEFT + (index / denominator) * xSpan,
        y: chartY(point.value, bounds.min, bounds.max),
        label: point.label,
        valueLabel: chartValueText(point.value, options.format)
      }));
      return {
        ...series,
        points,
        pointsAttr: points.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(" ")
      };
    }),
    baseline:
      options.includeZero && bounds.min <= 0 && bounds.max >= 0
        ? { label: "0", y: chartY(0, bounds.min, bounds.max) }
        : undefined,
    threshold: options.threshold
      ? { label: options.threshold.label, y: chartY(options.threshold.value, bounds.min, bounds.max) }
      : undefined
  };
}

function statusClass(status: string): string {
  return status.toLowerCase().replaceAll(" ", "-");
}

function trackLabel(track: BenchmarkTrack): string {
  return track === "weekly" ? "Weekly" : "Monthly";
}

const regimeTrackOrder = ["monthly", "weekly"] as BenchmarkTrack[];
const defaultRegimeTrack = regimeTrackOrder[0];

function statusLabel(status: RegimeStatus | "Ready" | "Forming"): string {
  if (status === "Ready") return "Counts now";
  if (status === "Forming") return "Needs more rounds";
  return "No rounds yet";
}

function roundSortKey(round: RoundRecord): string {
  return `${round.exit_date ?? ""}:${round.decision_deadline_utc ?? ""}:${round.round_id}`;
}

function artifactStatus(value: string): RegimeStatus | "Ready" | "Forming" {
  if (value === "ready") return "Ready";
  if (value === "forming") return "Forming";
  return "No data yet";
}

function trackArtifact(track: BenchmarkTrack): any {
  return marketEnvironment.tracks?.[track] ?? {
    confidence: { label: "No counting environments", detail: "No resolved data is available.", status: "empty" },
    rounds: [],
    environments: [],
    directions: [],
    regime_leaderboard: [],
    balanced_sample: { status: "forming", categories: [], selected_round_ids: [], leaderboard: [] },
    signals: []
  };
}

function trackConfidence(track: BenchmarkTrack): { label: string; detail: string; className: string } {
  const confidence = trackArtifact(track).confidence ?? {};
  return {
    label: confidence.label ?? "No counting environments",
    detail: confidence.detail ?? "No resolved data is available.",
    className: confidence.status ?? "empty"
  };
}

function mapModelRow(row: any): DirectionModelRow {
  return {
    modelId: row.model_id,
    provider: row.provider,
    label: row.model_label ?? modelLabel(row.model_id),
    providerName: providerLabel(row.provider),
    logoSrc: providerLogoSrc(row.provider),
    score: row.score,
    averageReturn: row.average_return,
    averageSp500Return: row.average_sp500_return,
    averageAlpha: row.average_alpha,
    hitRate: row.hit_rate,
    tests: Number(row.tests ?? 0)
  };
}

const roundRows = staticRoundRecords().filter((round) => /^CB-\d{4}-\d{2}-\d{2}-(1W|1M)$/.test(round.round_id));
const roundById = new Map(roundRows.map((round) => [round.round_id, round]));
const regimeRounds = regimeTrackOrder
  .flatMap((track) =>
    (trackArtifact(track).rounds ?? []).map((row: any): RegimeRound | null => {
      const round = roundById.get(row.round_id);
      const regime = regimeDefinitions[track].find((definition) => definition.key === row.environment_key);
      if (!round || !regime) return null;
      return {
        round,
        track,
        regime,
        directionKey: row.direction_key,
        sp500Return: row.sp500_return,
        maxPossibleReturn: row.max_possible_return,
        averageAlpha: row.average_alpha,
        hitRate: row.hit_rate,
        modelCount: Number(row.model_count ?? 0)
      };
    })
  )
  .filter((round): round is RegimeRound => round !== null);
const regimeRoundById = new Map(regimeRounds.map((round) => [round.round.round_id, round]));

function mapCoverage(track: BenchmarkTrack, row: any): RegimeCoverage {
  const definition = regimeDefinitions[track].find((item) => item.key === row.key) ?? mapRegimeDefinition(row);
  return {
    ...definition,
    count: Number(row.count ?? 0),
    averageSp500Return: row.average_sp500_return,
    status: artifactStatus(row.status) as RegimeStatus,
    rounds: (row.round_ids ?? []).map((roundId: string) => regimeRoundById.get(roundId)).filter(Boolean)
  };
}

const coverageByTrack: Record<BenchmarkTrack, RegimeCoverage[]> = {
  weekly: (trackArtifact("weekly").environments ?? []).map((row: any) => mapCoverage("weekly", row)),
  monthly: (trackArtifact("monthly").environments ?? []).map((row: any) => mapCoverage("monthly", row))
};

function mapEnvironment(track: BenchmarkTrack, row: any): EnvironmentPerformanceCard {
  const coverage = mapCoverage(track, row);
  const modelRows = (row.comparison?.model_rows ?? []).map(mapModelRow);
  return {
    ...coverage,
    track,
    status: row.status === "no_data" ? "No data yet" : row.comparison?.status === "ready" ? "Ready" : "Forming",
    modelRows,
    best: modelRows[0],
    worst: modelRows.at(-1)
  };
}

const environmentPerformance: Record<BenchmarkTrack, EnvironmentPerformanceCard[]> = {
  weekly: (trackArtifact("weekly").environments ?? []).map((row: any) => mapEnvironment("weekly", row)),
  monthly: (trackArtifact("monthly").environments ?? []).map((row: any) => mapEnvironment("monthly", row))
};

function buildEnvironmentMatrix(track: BenchmarkTrack): EnvironmentMatrixRow[] {
  const environments = environmentPerformance[track];
  const models = new Map<string, { model: DirectionModelRow; returns: number[] }>();
  for (const environment of environments) {
    for (const modelRow of environment.modelRows) {
      const existing = models.get(modelRow.modelId);
      if (existing) {
        if (finiteNumber(modelRow.averageReturn)) existing.returns.push(modelRow.averageReturn);
      } else {
        models.set(modelRow.modelId, {
          model: modelRow,
          returns: finiteNumber(modelRow.averageReturn) ? [modelRow.averageReturn] : []
        });
      }
    }
  }
  return Array.from(models.values())
    .map(({ model, returns }) => ({
      modelId: model.modelId,
      label: model.label,
      providerName: model.providerName,
      logoSrc: model.logoSrc,
      averageReturn: returns.length ? returns.reduce((total, value) => total + value, 0) / returns.length : undefined,
      cells: environments.map((environment) => {
        const modelIndex = environment.modelRows.findIndex((row) => row.modelId === model.modelId);
        const modelRow = modelIndex >= 0 ? environment.modelRows[modelIndex] : undefined;
        return {
          key: environment.key,
          label: environment.label,
          value: modelRow?.averageReturn,
          rank: modelRow ? modelIndex + 1 : undefined,
          width: modelRow ? environmentReturnBarWidth(environment, modelRow.averageReturn) : 0
        };
      })
    }))
    .sort(
      (left, right) =>
        (right.averageReturn ?? Number.NEGATIVE_INFINITY) - (left.averageReturn ?? Number.NEGATIVE_INFINITY) ||
        left.label.localeCompare(right.label)
    );
}

const environmentMatrices: Record<BenchmarkTrack, EnvironmentMatrixRow[]> = {
  weekly: buildEnvironmentMatrix("weekly"),
  monthly: buildEnvironmentMatrix("monthly")
};

function mapDirectionBucket(track: BenchmarkTrack, row: any): DirectionBucket {
  const definition = sampleCategoryDefinitions[track].find((item) => item.key === row.key) ?? mapSampleDefinition(row);
  return {
    ...definition,
    track,
    rounds: (row.comparison?.round_ids ?? []).map((roundId: string) => regimeRoundById.get(roundId)).filter(Boolean),
    status: row.comparison?.status === "ready" ? "Ready" : "Forming",
    averageSp500Return: row.comparison?.model_rows?.[0]?.average_sp500_return,
    modelRows: (row.comparison?.model_rows ?? []).map(mapModelRow)
  };
}

const directionBuckets: Record<BenchmarkTrack, Record<SampleCategoryKey, DirectionBucket>> = {
  weekly: Object.fromEntries(
    (trackArtifact("weekly").directions ?? []).map((row: any) => [row.key, mapDirectionBucket("weekly", row)])
  ) as Record<SampleCategoryKey, DirectionBucket>,
  monthly: Object.fromEntries(
    (trackArtifact("monthly").directions ?? []).map((row: any) => [row.key, mapDirectionBucket("monthly", row)])
  ) as Record<SampleCategoryKey, DirectionBucket>
};

function directionSummary(track: BenchmarkTrack, direction: "down" | "up"): DirectionPerformanceCard {
  const bucket = directionBuckets[track][direction];
  return {
    track,
    key: direction === "down" ? "negative" : "positive",
    label: direction === "down" ? "Down environments" : "Up environments",
    rangeLabel: bucket.rangeLabel,
    rounds: bucket.rounds,
    averageSp500Return: bucket.averageSp500Return,
    status: bucket.status,
    best: bucket.modelRows[0],
    worst: bucket.modelRows.at(-1)
  };
}

const directionalPerformance: Record<BenchmarkTrack, DirectionPerformanceCard[]> = {
  weekly: [directionSummary("weekly", "down"), directionSummary("weekly", "up")],
  monthly: [directionSummary("monthly", "down"), directionSummary("monthly", "up")]
};

function mapRegimeLeaderboardRow(row: any): RegimeLeaderboardRow {
  return {
    modelId: row.model_id,
    provider: row.provider,
    label: row.model_label ?? modelLabel(row.model_id),
    providerName: providerLabel(row.provider),
    logoSrc: providerLogoSrc(row.provider),
    averageReturn: row.average_return,
    averageSp500Return: row.average_sp500_return,
    regimeBalancedScore: row.regime_balanced_score,
    sp500RegimeScore: row.sp500_regime_score,
    allRoundScore: row.all_round_score,
    averageAlpha: row.average_alpha,
    hitRate: row.hit_rate,
    testsIncluded: Number(row.tests_included ?? 0),
    readyRegimesCovered: Number(row.ready_environments_covered ?? 0),
    readyRegimesRequired: Number(row.ready_environments_required ?? 0),
    status: row.status === "ready" ? "Ready" : "Forming",
    regimeScores: (row.environment_scores ?? []).map((score: any) => ({
      key: score.key,
      label: score.label,
      score: score.score,
      averageReturn: score.average_return,
      averageSp500Return: score.average_sp500_return,
      tests: Number(score.tests ?? 0)
    }))
  };
}

const leaderboards: Record<BenchmarkTrack, RegimeLeaderboardRow[]> = {
  weekly: (trackArtifact("weekly").regime_leaderboard ?? []).map(mapRegimeLeaderboardRow),
  monthly: (trackArtifact("monthly").regime_leaderboard ?? []).map(mapRegimeLeaderboardRow)
};

function mapBalancedSample(track: BenchmarkTrack): BalancedSampleTrack {
  const sample = trackArtifact(track).balanced_sample ?? {};
  const categories = (sample.categories ?? []).map((row: any) => ({
    ...mapSampleDefinition(row),
    count: Number(row.count ?? 0),
    missing: Number(row.missing ?? 0),
    selectedCount: Number(row.selected_count ?? 0)
  }));
  const missingParts = categories
    .filter((category: BalancedSampleCategory) => category.missing > 0)
    .map(
      (category: BalancedSampleCategory) =>
        `${category.missing} more ${category.label.toLowerCase()} ${track} round${category.missing === 1 ? "" : "s"}`
    );
  return {
    track,
    status: sample.status === "ready" ? "Ready" : "Forming",
    categories,
    sampleSize: Number(sample.sample_size ?? 0),
    selectedRounds: (sample.selected_round_ids ?? [])
      .map((roundId: string) => regimeRoundById.get(roundId))
      .filter(Boolean),
    missingSummary: missingParts.length ? `Needs ${missingParts.join(" and ")}.` : "Ready to rank models.",
    leaderboard: (sample.leaderboard ?? []).map((row: any) => ({
      modelId: row.model_id,
      provider: row.provider,
      label: row.model_label ?? modelLabel(row.model_id),
      providerName: providerLabel(row.provider),
      logoSrc: providerLogoSrc(row.provider),
      score: row.score,
      averageAlpha: row.average_alpha,
      hitRate: row.hit_rate,
      testsIncluded: Number(row.tests_included ?? 0),
      testsRequired: Number(row.tests_required ?? 0),
      status: row.status === "ready" ? "Ready" : "Forming"
    }))
  };
}

const balancedSamples: Record<BenchmarkTrack, BalancedSampleTrack> = {
  weekly: mapBalancedSample("weekly"),
  monthly: mapBalancedSample("monthly")
};

function pluralizeRound(count: number): string {
  return `${count} round${count === 1 ? "" : "s"}`;
}

function modelCard(row: any): MarketInsightCard["model"] {
  if (!row) return undefined;
  return {
    label: row.model_label ?? modelLabel(row.model_id),
    providerName: providerLabel(row.provider),
    logoSrc: providerLogoSrc(row.provider)
  };
}

function directionInsightCard(signal: any): MarketInsightCard {
  const direction = signal.direction as SampleCategoryKey;
  const model = signal.model;
  const copy = {
    down: { adjective: "negative", noun: "down environments", tone: "down" as const },
    flat: { adjective: "flat", noun: "flat environments", tone: "flat" as const },
    up: { adjective: "positive", noun: "up environments", tone: "up" as const }
  }[direction];
  const status = signal.maturity === "ready" ? "Ready" : "Forming";
  if (!model) {
    return {
      key: signal.key,
      eyebrow: `${trackLabel(signal.track)} ${copy.noun}`,
      title: `No ${trackLabel(signal.track).toLowerCase()} ${copy.noun} leader yet.`,
      tone: copy.tone,
      status,
      metricValue: "n/a",
      metricLabel: "avg model return",
      detail: "No shared round cohort is large enough for a fair model comparison yet.",
      stats: [
        { label: "Rounds", value: pluralizeRound(Number(signal.environment_round_count ?? 0)) },
        { label: "Range", value: signal.range_label }
      ]
    };
  }
  return {
    key: signal.key,
    eyebrow: `${trackLabel(signal.track)} ${copy.noun}`,
    title: `${model.model_label ?? modelLabel(model.model_id)} leads when the S&P 500 is ${copy.adjective}.`,
    tone: copy.tone,
    status,
    model: modelCard(model),
    metricValue: signedPctText(model.average_return),
    metricLabel: "avg model return",
    detail:
      status === "Ready"
        ? `Based on ${pluralizeRound(signal.comparison_round_count)} shared by ${signal.eligible_model_count} eligible models. ${String(signal.confidence).replace(/^./, (value: string) => value.toUpperCase())} confidence.`
        : `Current signal only: ${signal.comparison_round_count}/${signal.environment_round_count} rounds form a shared cohort.`,
    stats: [
      { label: "S&P avg", value: signedPctText(signal.average_sp500_return) },
      { label: "Leader margin", value: signedPctText(signal.comparison?.leader_margin) },
      {
        label: "Stability",
        value: finiteNumber(signal.comparison?.leave_one_out_stability)
          ? `${(signal.comparison.leave_one_out_stability * 100).toFixed(0)}%`
          : "n/a"
      }
    ]
  };
}

function consistencyInsightCard(signal: any): MarketInsightCard {
  const candidate = signal.candidate;
  const status = signal.maturity === "ready" ? "Ready" : "Forming";
  if (!candidate?.model) {
    return {
      key: signal.key,
      eyebrow: `${trackLabel(signal.track)} consistency`,
      title: "Consistency insight is still forming.",
      tone: "steady",
      status,
      metricValue: "n/a",
      metricLabel: "avg model return",
      detail: "At least two tested S&P 500 environments are needed before comparing model consistency.",
      stats: []
    };
  }
  return {
    key: signal.key,
    eyebrow: `${trackLabel(signal.track)} consistency`,
    title: `${candidate.model.model_label ?? modelLabel(candidate.model.model_id)} has the strongest score floor.`,
    tone: "steady",
    status,
    model: modelCard(candidate.model),
    metricValue: signedPctText(candidate.average_return),
    metricLabel: "avg model return",
    detail: `Lowest score across ${candidate.directions_covered} tested environments; average score ${scoreText(candidate.average_score)}.`,
    stats: [
      { label: "S&P avg", value: signedPctText(candidate.average_sp500_return) },
      { label: "Score floor", value: scoreText(candidate.floor_score) },
      { label: "Ready types", value: `${candidate.ready_directions}/${candidate.directions_covered}` }
    ]
  };
}

function splitInsightCard(signal: any): MarketInsightCard {
  const candidate = signal.candidate;
  const status = signal.maturity === "ready" ? "Ready" : "Forming";
  if (!candidate?.model) {
    return {
      key: signal.key,
      eyebrow: `${trackLabel(signal.track)} up/down split`,
      title: "Up/down split is still forming.",
      tone: "split",
      status,
      metricValue: "n/a",
      metricLabel: "avg return gap",
      detail: "Both negative and positive S&P 500 samples are needed before measuring directional split.",
      stats: []
    };
  }
  return {
    key: signal.key,
    eyebrow: `${trackLabel(signal.track)} up/down split`,
    title: `${candidate.model.model_label ?? modelLabel(candidate.model.model_id)} changes most between up and down environments.`,
    tone: "split",
    status,
    model: modelCard(candidate.model),
    metricValue: `${(Math.abs(candidate.return_gap) * 100).toFixed(1)} pts`,
    metricLabel: "avg return gap",
    detail: `${scoreText(candidate.up_score)} in up environments versus ${scoreText(candidate.down_score)} in down environments.`,
    stats: [
      { label: "Down avg", value: signedPctText(candidate.down_return) },
      { label: "Up avg", value: signedPctText(candidate.up_return) },
      { label: "Model tests", value: `${candidate.down_tests}/${candidate.up_tests}` }
    ]
  };
}

function insightCard(signal: any): MarketInsightCard | null {
  if (signal.kind === "direction_leader") return directionInsightCard(signal);
  if (signal.kind === "consistency") return consistencyInsightCard(signal);
  if (signal.kind === "split") return splitInsightCard(signal);
  return null;
}

const marketInsightTracks = regimeTrackOrder.map((track) => ({
  track,
  label: trackLabel(track),
  cards: (trackArtifact(track).signals ?? []).map(insightCard).filter(Boolean) as MarketInsightCard[]
}));

const sampleCategoryColors: Record<SampleCategoryKey, string> = {
  down: "#b45335",
  flat: "#64748b",
  up: "#006b5f"
};

function chronologicalRounds(track: BenchmarkTrack): RegimeRound[] {
  return regimeRounds
    .filter((round) => round.track === track)
    .slice()
    .sort((left, right) => roundSortKey(left.round).localeCompare(roundSortKey(right.round)));
}

function roundChartLabel(round: RegimeRound): string {
  return dateOnly(round.round.exit_date) || round.round.round_id;
}

function buildBalancedProgressChart(track: BenchmarkTrack): LineChart {
  const rounds = chronologicalRounds(track);
  const counts = new Map<SampleCategoryKey, number>(sampleCategoryDefinitions[track].map((category) => [category.key, 0]));
  const pointsByCategory = new Map<SampleCategoryKey, RawChartPoint[]>(
    sampleCategoryDefinitions[track].map((category) => [category.key, []])
  );

  for (const round of rounds) {
    counts.set(round.directionKey, (counts.get(round.directionKey) ?? 0) + 1);
    const label = roundChartLabel(round);
    for (const definition of sampleCategoryDefinitions[track]) {
      pointsByCategory.get(definition.key)?.push({
        label,
        value: counts.get(definition.key) ?? 0
      });
    }
  }

  return buildLineChart({
    id: `${track}-balanced-sample-progress`,
    title: `${trackLabel(track)} sample balance progress`,
    description: "Shows how many down, flat, and up rounds are available.",
    format: "count",
    floorZero: true,
    threshold: {
      value: BALANCED_SAMPLE_THRESHOLD,
      label: `${BALANCED_SAMPLE_THRESHOLD} needed`
    },
    series: sampleCategoryDefinitions[track].map((category) => ({
      key: category.key,
      label: category.label,
      color: sampleCategoryColors[category.key],
      points: pointsByCategory.get(category.key) ?? []
    }))
  });
}

const balancedProgressCharts = {
  weekly: buildBalancedProgressChart("weekly"),
  monthly: buildBalancedProgressChart("monthly")
};

const trackSummaries = regimeTrackOrder.map((track) => {
  const coverage = coverageByTrack[track];
  const readyCount = coverage.filter((item) => item.status === "Ready").length;
  const totalRounds = regimeRounds.filter((round) => round.track === track).length;
  const confidence = trackConfidence(track);
  return {
    track,
    label: trackLabel(track),
    readyCount,
    totalRounds,
    confidence
  };
});

const weeklySummary = trackSummaries.find((item) => item.track === "weekly");
const monthlySummary = trackSummaries.find((item) => item.track === "monthly");
const regimeIntroCards = regimeDefinitions.weekly.map((weeklyDefinition) => {
  const monthlyDefinition = regimeDefinitions.monthly.find((definition) => definition.key === weeklyDefinition.key);
  const weeklyEnvironment = environmentPerformance.weekly.find((environment) => environment.key === weeklyDefinition.key);
  const monthlyEnvironment = environmentPerformance.monthly.find((environment) => environment.key === weeklyDefinition.key);

  return {
    ...weeklyDefinition,
    weeklyRange: weeklyDefinition.rangeLabel.replace("S&P ", ""),
    monthlyRange: monthlyDefinition?.rangeLabel.replace("S&P ", "") ?? "n/a",
    weeklyCount: weeklyEnvironment?.count ?? 0,
    monthlyCount: monthlyEnvironment?.count ?? 0
  };
});

const auditRows = regimeRounds
  .slice()
  .sort(
    (left, right) =>
      (right.round.exit_date ?? "").localeCompare(left.round.exit_date ?? "") ||
      right.round.round_id.localeCompare(left.round.round_id)
  );
const visibleAuditRows = auditRows.slice(0, 10);
const hiddenAuditRows = auditRows.slice(10);
