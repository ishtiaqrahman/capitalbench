            <label><span>Track</span><select data-mrb-audit-track><option value="all">All tracks</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></label>
            <label><span>Environment</span><select data-mrb-audit-environment><option value="all">All environments</option>{thresholdCards.map((environment) => <option value={environment.key}>{environment.label}</option>)}</select></label>
            <a class="mrb-data-link" href="/api/v1/market-environments?track=all">Open JSON data</a>
          </div>
          <p class="mrb-audit-count" data-mrb-audit-count>Showing 10 of {auditRows.length} rounds</p>
