      .mrb-benchmark-definition > div + div { border-top: 1px solid var(--line); border-left: 0; }
      .mrb-direction-table th,
      .mrb-direction-table td { padding-inline: 7px; }
      .mrb-reference-banner { align-items: start; }
    }
  </style>

  <script is:inline>
    (() => {
      const trackButtons = Array.from(document.querySelectorAll("[data-mrb-track]"));
      const trackPanels = Array.from(document.querySelectorAll("[data-mrb-track-panel]"));
      const announcement = document.querySelector("[data-mrb-track-announcement]");
      const disclosureRoots = Array.from(document.querySelectorAll("details"));

      function syncDisclosure(details) {
        Array.from(details.children).forEach((child) => {
          if (child.tagName === "SUMMARY") return;
          child.inert = !details.open;
          child.setAttribute("aria-hidden", details.open ? "false" : "true");
        });
      }

      disclosureRoots.forEach((details) => {
        syncDisclosure(details);
        details.addEventListener("toggle", () => syncDisclosure(details));
      });

      function trackFromHash() {
        const match = window.location.hash.match(/market-environment-insight-(weekly|monthly)-/);
        return match?.[1];
      }

      function selectTrack(track, updateUrl = true) {
        if (!['monthly', 'weekly'].includes(track)) return;
        document.documentElement.dataset.marketRegimeTrack = track;
        trackButtons.forEach((button) => {
          const active = button.dataset.mrbTrack === track;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", active ? "true" : "false");
        });
        trackPanels.forEach((panel) => {
          panel.hidden = panel.dataset.mrbTrackPanel !== track;
        });
        if (announcement) announcement.textContent = `${track === 'weekly' ? 'Weekly' : 'Monthly'} results selected`;
        if (updateUrl) {
          const url = new URL(window.location.href);
          url.searchParams.set("track", track);
          window.history.replaceState({}, "", url);
        }
      }

      trackButtons.forEach((button, index) => {
        button.addEventListener("click", () => selectTrack(button.dataset.mrbTrack));
        button.addEventListener("keydown", (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const nextIndex = event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? trackButtons.length - 1
              : event.key === 'ArrowRight'
                ? (index + 1) % trackButtons.length
                : (index - 1 + trackButtons.length) % trackButtons.length;
          const next = trackButtons[nextIndex];
          next?.focus();
          selectTrack(next?.dataset.mrbTrack);
        });
      });

      function activateHash() {
        const hashTrack = trackFromHash();
        if (hashTrack) selectTrack(hashTrack, false);
        const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
        if (target) {
          const details = target.closest("details");
          details?.setAttribute("open", "");
          if (details) syncDisclosure(details);
          window.requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
        }
      }

      const requestedTrack = trackFromHash() || new URL(window.location.href).searchParams.get("track") || "monthly";
      selectTrack(requestedTrack, false);
      if (window.location.hash) activateHash();
      window.addEventListener("hashchange", activateHash);

      const search = document.querySelector("[data-mrb-audit-search]");
      const trackFilter = document.querySelector("[data-mrb-audit-track]");
      const environmentFilter = document.querySelector("[data-mrb-audit-environment]");
      const auditRows = Array.from(document.querySelectorAll("[data-audit-row]"));
      const auditCount = document.querySelector("[data-mrb-audit-count]");
      const auditEmpty = document.querySelector("[data-mrb-audit-empty]");
      const showMore = document.querySelector("[data-mrb-audit-more]");
      let expanded = false;

      function applyAuditFilters() {
        const query = String(search?.value || "").trim().toLowerCase();
        const track = String(trackFilter?.value || "all");
        const environment = String(environmentFilter?.value || "all");
        const filtering = Boolean(query || track !== "all" || environment !== "all");
        let matched = 0;
        let visible = 0;
        auditRows.forEach((row) => {
          const matches = (!query || row.dataset.round.includes(query)) &&
            (track === "all" || row.dataset.track === track) &&
            (environment === "all" || row.dataset.environment === environment);
          if (matches) matched += 1;
          const show = matches && (filtering || expanded || Number(row.dataset.index) < 10);
          row.hidden = !show;
          row.inert = !show;
          row.setAttribute("aria-hidden", show ? "false" : "true");
          if (show) visible += 1;
        });
        if (auditCount) auditCount.textContent = `Showing ${visible} of ${matched} matching tests`;
        if (auditEmpty) auditEmpty.hidden = matched !== 0;
        if (showMore) {
          showMore.hidden = filtering || expanded || matched <= 10;
          showMore.textContent = `Show all ${matched} tests`;
        }
      }

      search?.addEventListener("input", applyAuditFilters);
      trackFilter?.addEventListener("change", applyAuditFilters);
      environmentFilter?.addEventListener("change", applyAuditFilters);
      showMore?.addEventListener("click", () => { expanded = true; applyAuditFilters(); });
      applyAuditFilters();
    })();
  </script>
</BaseLayout>
