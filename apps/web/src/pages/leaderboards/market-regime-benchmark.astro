            {auditRows.map((row: any, index: number) => (
              <div
                class="mrb-audit-row"
                role="row"
                data-audit-row
                data-index={index}
                data-track={row.track}
                data-environment={row.environmentKey}
                data-round={String(row.round_id).toLowerCase()}
              >
                <span role="cell" data-label="Round"><a href={`/rounds/${row.round_id}`}>{row.round_id}</a></span>
                <span role="cell" data-label="Track">{trackLabel(row.track)}</span>
                <span role="cell" data-label="Window">{dateOnly(row.entry_date)} to {dateOnly(row.exit_date)}</span>
                <span role="cell" data-label="S&P" class:list={[`is-${valueTone(row.sp500_return)}`]}>{signedPctText(row.sp500_return)}</span>
                <span role="cell" data-label="Environment">{row.environmentLabel}</span>
                <span role="cell" data-label="Model alpha" class:list={[`is-${valueTone(row.average_alpha)}`]}>{pointText(row.average_alpha, true)}</span>
                <span role="cell" data-label="Models">{row.model_count}</span>
              </div>
            ))}
          </div>
          <p class="mrb-empty-state" data-mrb-audit-empty hidden>No rounds match these filters.</p>
          <button type="button" class="mrb-show-more" data-mrb-audit-more>Show all {auditRows.length} rounds</button>
        </div>
      </details>
    </section>
