                    <th scope="row"><span class="mrb-sp500-mark">S&amp;P</span><span>S&amp;P 500<small>Market reference</small></span></th>
                    {view.environments.map((environment: any) => (
                      <td>
                        <strong class:list={[`is-${valueTone(environment.sharedSp500Return ?? environment.average_sp500_return)}`]}>
                          {signedPctText(environment.sharedSp500Return ?? environment.average_sp500_return)}
                        </strong>
                        <small>{finiteNumber(environment.sharedSp500Return) ? "shared reference" : "all resolved rounds"}</small>
                      </td>
                    ))}
                  </tr>
                  {view.matrixRows.map((row: any, index: number) => (
                    <tr class:list={[!row.comparable && "mrb-limited-row"]}>
                      <th scope="row">
                        <span class="mrb-row-rank">{row.comparable ? index + 1 : "-"}</span>
                        {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                        <span>{row.label}<small>{row.comparable ? `${row.covered}/${row.required} counting` : "Limited shared history"}</small></span>
                      </th>
                      {row.cells.map((cell: any) => (
                        <td>
                          {finiteNumber(cell.returnValue) ? (
                            <>
                              <strong class:list={[`is-${valueTone(cell.returnValue)}`]}>{signedPctText(cell.returnValue)}</strong>
                              <small class:list={[`is-${valueTone(cell.alpha)}`]}>{pointText(cell.alpha, true)} vs S&amp;P</small>
                            </>
                          ) : (
                            <><strong>n/a</strong><small>No shared cohort</small></>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="mrb-environment-details">
              {view.environments.map((environment: any) => (
                <details class:list={[`is-${environment.key}`]}>
                  <summary>
                    <span class="mrb-environment-swatch" aria-hidden="true"></span>
                    <span><strong>{environment.label}</strong><small>{environment.range_label}</small></span>
                    <span><strong>{environment.sharedCount}/{environment.rawCount}</strong><small>shared / raw</small></span>
                    <span class:list={["mrb-evidence", `is-${environment.confidence}`]}>{confidenceLabel(environment.confidence)}</span>
                  </summary>
                  <div class="mrb-environment-detail-body">
                    {environment.modelRows.length ? (
                      <>
                        <p>{comparisonStatement(environment.modelRows[0], environment.label.toLowerCase())}</p>
                        <div class="mrb-environment-chart">
                          <BenchmarkBarChart
                            rows={view.environmentChartRows[environment.key]}
                            domain={view.environmentDomain}
                            format="percent"
                            orientation="horizontal"
                            compact={true}
                            ariaLabel={`${view.label} ${environment.label} model and S&P 500 returns`}
                          />
                          <p class="mrb-chart-scale-note">All {view.label.toLowerCase()} environment drill-downs share this zero-centred scale.</p>
                        </div>
                        <dl class="mrb-evidence-stats">
                          <div><dt>Models compared</dt><dd>{environment.eligibleModelCount}</dd></div>
                          <div><dt>Leader stability</dt><dd>{stabilityText(environment.stability)}</dd></div>
                          <div><dt>Leader margin</dt><dd>{pointText(environment.leaderMargin, true)}</dd></div>
                          <div><dt>Leader return 95% CI</dt><dd>{finiteNumber(environment.leaderCiLow) ? `${signedPctText(environment.leaderCiLow)} to ${signedPctText(environment.leaderCiHigh)}` : "n/a"}</dd></div>
                        </dl>
                      </>
                    ) : (
                      <p>
                        {environment.rawCount === 0
                          ? "No resolved rounds have landed in this environment yet."
                          : `${environment.rawCount} raw round${environment.rawCount === 1 ? " is" : "s are"} available; ${Math.max(0, READY_ROUND_THRESHOLD - environment.rawCount)} more needed before this environment can count.`}
                      </p>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </div>
        );
      })}
    </section>

