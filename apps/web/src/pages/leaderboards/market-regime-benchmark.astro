      .mrb-question-title { max-width: 100%; gap: 7px; }
      .mrb-info-tip { flex: 0 0 auto; }
      .mrb-answer-grid { grid-template-columns: minmax(0, 1fr); }
      .mrb-answer-card-leader { grid-column: auto; }
      .mrb-chart-panel { padding: 15px; }
      .mrb-chart-panel > header,
      .mrb-exact-results-head { display: grid; align-items: center; justify-items: center; }
      .mrb-exact-results-head { margin-top: 16px; }
      .mrb-reading-guide { grid-template-columns: minmax(0, 1fr); }
      .mrb-reading-guide > div { padding-inline: 20px; }
      .mrb-reading-guide > div + div { border-top: 1px solid #cbd9e8; border-left: 0; }
      .mrb-direction-panel { padding: 15px; }
      .mrb-direction-panel > header { display: grid; }
      .mrb-evidence { justify-self: center; }
      .mrb-evidence-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .mrb-threshold-strip { margin-inline: -20px; padding-inline: 20px; scroll-snap-type: x proximity; }
      .mrb-threshold-strip article { scroll-snap-align: start; }
      .mrb-data-scroll { margin-inline: -20px; border-right: 0; border-left: 0; border-radius: 0; }
      .mrb-matrix-table thead th:first-child,
      .mrb-matrix-table tbody th { min-width: 175px; }
      .mrb-environment-details { grid-template-columns: minmax(0, 1fr); }
      .mrb-environment-details summary { grid-template-columns: 10px minmax(0, 1fr) auto; }
      .mrb-environment-details summary .mrb-evidence { grid-column: 2 / -1; }
      .mrb-reference-banner { grid-template-columns: auto minmax(0, 1fr); }
      .mrb-reference-banner > span:last-child { grid-column: 2; }
      .mrb-insight { grid-template-columns: minmax(0, 1fr); }
      .mrb-insight-metric { text-align: center; }
