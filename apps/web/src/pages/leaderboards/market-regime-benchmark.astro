    <section id="benchmark-evidence" class="mrb-section mrb-evidence-section" aria-labelledby="evidence-title">
      <div class="mrb-section-head">
        <span class="panel-kicker">Evidence and audit</span>
        <h2 id="evidence-title">Inspect the calculation, robustness check, and every included round</h2>
      </div>

      <details class="mrb-disclosure">
        <summary><span>How to read the benchmark</span><strong>Definitions and calculation</strong><em>Shared cohorts, equal weighting, and metric definitions</em></summary>
        <div class="mrb-method-body">
          <div class="mrb-method-steps">
            <article><span>1</span><h3>Resolve official rounds</h3><p>Only completed official results enter this analysis.</p></article>
            <article><span>2</span><h3>Classify the market</h3><p>Each round is grouped by the S&amp;P 500 return over the same scoring window.</p></article>
            <article><span>3</span><h3>Build a shared cohort</h3><p>Models are compared only on rounds available to every model in that comparison.</p></article>
            <article><span>4</span><h3>Weight environments equally</h3><p>Every environment with at least {READY_ROUND_THRESHOLD} rounds receives the same weight.</p></article>
          </div>
          <dl class="mrb-metric-dictionary">
            <div><dt>Return</dt><dd>Average model portfolio return on the displayed shared rounds.</dd></div>
            <div><dt>vs S&amp;P</dt><dd>Model return minus S&amp;P 500 return on those same rounds.</dd></div>
            <div><dt>Equal-environment return</dt><dd>Average of the model's per-environment returns across all counting environments.</dd></div>
            <div><dt>CapitalBench Score</dt><dd>The official round score relative to the benchmark and best available option. <a href="/scoring">Scoring details</a>.</dd></div>
            <div><dt>Hit rate</dt><dd>Share of included model tests where the model beat the S&amp;P 500.</dd></div>
            <div><dt>Stability</dt><dd>How often the same leader remains first when one shared round is removed.</dd></div>
          </dl>
          <p class="mrb-method-note">
            Weekly and monthly scoring windows can overlap. They should not be interpreted as independent trades or
            combined into a cumulative return series. Confidence labels are descriptive evidence checks, not investment certainty.
          </p>
        </div>
      </details>

      <details class="mrb-disclosure">
        <summary><span>Robustness check</span><strong>Strict equal-sample benchmark</strong><em>Uses the same number of down, flat, and up rounds</em></summary>
        <div class="mrb-disclosure-body">
          {TRACKS.map((track) => {
            const view = trackViews[track];
            const sample = view.balancedSample;
            return (
              <div data-mrb-track-panel={track} hidden={track !== DEFAULT_TRACK}>
                <div class="mrb-sample-head">
                  <div><span>{view.label} robustness check</span><h3>{sample.status === "ready" ? `${sample.sampleSize} rounds selected per direction` : "The equal sample is still building"}</h3></div>
                  <strong class:list={["mrb-evidence", sample.status === "ready" ? "is-medium" : "is-low"]}>{sample.status === "ready" ? "Ready to compare" : "Not ranked yet"}</strong>
                </div>
                <div class="mrb-sample-progress">
                  {sample.categories.map((category: any) => (
                    <article class:list={[`is-${category.key}`]}>
                      <span>{category.label}</span>
                      <strong>{category.count}</strong>
                      <small>{sample.status === "ready" ? `${category.selectedCount} selected` : category.missing ? `${category.missing} more needed` : "Requirement met"}</small>
                      <i style={`--sample-width:${Math.min(100, (category.count / BALANCED_SAMPLE_THRESHOLD) * 100)}%`}></i>
                    </article>
                  ))}
                </div>
                {sample.status === "ready" ? (
                  <>
                    <div class="mrb-data-scroll" tabindex="0">
                      <table class="mrb-ranking-table">
                        <thead><tr><th>Strict rank and model</th><th>Balanced score</th><th>vs S&amp;P</th><th>Hit rate</th><th>Tests</th><th>vs main rank</th></tr></thead>
                        <tbody>
                          {sample.comparableRows.map((row: any, index: number) => (
                            <tr>
                              <th scope="row"><span class="mrb-row-rank">{index + 1}</span>{row.logoSrc && <img src={row.logoSrc} alt="" />}<span>{row.label}<small>{row.providerName}</small></span></th>
                              <td>{scoreText(row.score)}</td><td>{pointText(row.averageAlpha, true)}</td><td>{finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}</td><td>{row.testsIncluded}/{row.testsRequired}</td><td>{rankChange(view, row.modelId, index + 1)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    {sample.limitedRows.length > 0 && <p class="mrb-method-note">{sample.limitedRows.length} model{sample.limitedRows.length === 1 ? " has" : "s have"} insufficient shared history for this strict comparison and {sample.limitedRows.length === 1 ? "receives" : "receive"} no rank.</p>}
                    <details class="mrb-selected-rounds">
                      <summary>View {sample.selectedRoundIds.length} selected rounds</summary>
                      <div>{sample.selectedRoundIds.map((roundId: string) => <a href={`/rounds/${roundId}`}>{roundId}</a>)}</div>
                    </details>
                  </>
                ) : (
                  <p class="mrb-empty-state">
                    This view waits for at least {BALANCED_SAMPLE_THRESHOLD} down, {BALANCED_SAMPLE_THRESHOLD} flat,
                    and {BALANCED_SAMPLE_THRESHOLD} up rounds before assigning ranks.
                  </p>
                )}
              </div>
            );
          })}
        </div>
      </details>

      <details class="mrb-disclosure">
        <summary><span>Round audit</span><strong>Included official rounds</strong><em>{auditRows.length} resolved rounds with filters and source links</em></summary>
        <div class="mrb-disclosure-body">
          <div class="mrb-audit-tools">
