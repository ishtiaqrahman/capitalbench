---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarketRegimeLineChart from "../../components/MarketRegimeLineChart.astro";
import PageHeader from "../../components/PageHeader.astro";
import { modelLabel, providerLabel, type LeaderboardRecord, type RoundRecord } from "../../data/fallback";
import { cumulativeCapitalBenchScore } from "../../lib/capitalBenchScore.js";
import { dateOnly, pct } from "../../lib/format";
import {
  staticRoundLeaderboard,
  staticRoundRecords,
  staticRoundReturns,
  type ResultReturnRecord
} from "../../lib/localRoundRecords";
import { providerLogoSrc } from "../../lib/scoreReturnChart";
import { buildTrackScorecard } from "../../lib/trackScorecard";
import { roundTrack, type BenchmarkTrack } from "../../lib/tracks";

type RegimeKey = "sharp_down" | "down" | "flat" | "up" | "sharp_up";
type RegimeDirection = "down" | "flat" | "up";
type RegimeStatus = "Ready" | "Forming" | "No data yet";
type SampleCategoryKey = "down" | "flat" | "up";

type RegimeDefinition = {
  key: RegimeKey;
  label: string;
  rangeLabel: string;
  direction: RegimeDirection;
};

type RegimeRound = {
  round: RoundRecord;
  track: BenchmarkTrack;
  regime: RegimeDefinition;
  leaderboard: LeaderboardRecord[];
  sp500Return: number;
  maxPossibleReturn: number;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  modelCount: number;
};

type RegimeCoverage = RegimeDefinition & {
  count: number;
  averageSp500Return: number | undefined;
  status: RegimeStatus;
  rounds: RegimeRound[];
};

type ModelRegimeStats = {
  returns: number[];
  maxReturns: number[];
  alphas: number[];
  hits: boolean[];
  rounds: string[];
};

type SampleCategoryDefinition = {
  key: SampleCategoryKey;
  label: string;
  rangeLabel: string;
};

type RegimeLeaderboardRow = {
  modelId: string;
  provider: string;
  label: string;
  providerName: string;
  logoSrc: string | undefined;
  regimeBalancedScore: number | undefined;
  allRoundScore: number | undefined;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  testsIncluded: number;
  readyRegimesCovered: number;
  readyRegimesRequired: number;
  status: "Ready" | "Forming";
  regimeScores: Array<{
    key: RegimeKey;
    label: string;
    score: number | undefined;
    tests: number;
  }>;
};

type BalancedSampleCategory = SampleCategoryDefinition & {
  count: number;
  missing: number;
  selectedCount: number;
};

type BalancedSampleLeaderboardRow = {
  modelId: string;
  provider: string;
  label: string;
  providerName: string;
  logoSrc: string | undefined;
  score: number | undefined;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  testsIncluded: number;
  testsRequired: number;
  status: "Ready" | "Forming";
};

type BalancedSampleTrack = {
  track: BenchmarkTrack;
  status: "Ready" | "Forming";
  categories: BalancedSampleCategory[];
  sampleSize: number;
  selectedRounds: RegimeRound[];
  missingSummary: string;
  leaderboard: BalancedSampleLeaderboardRow[];
};

type DirectionModelRow = {
  modelId: string;
  provider: string;
  label: string;
  providerName: string;
  logoSrc: string | undefined;
  score: number | undefined;
  averageAlpha: number | undefined;
  hitRate: number | undefined;
  tests: number;
};

type DirectionBucket = SampleCategoryDefinition & {
  track: BenchmarkTrack;
  rounds: RegimeRound[];
  status: "Ready" | "Forming";
  modelRows: DirectionModelRow[];
};

type MarketInsightCard = {
  key: string;
  eyebrow: string;
  title: string;
  tone: "down" | "flat" | "up" | "steady" | "split";
  status: "Ready" | "Forming";
  model?: {
    label: string;
    providerName: string;
    logoSrc: string | undefined;
  };
  metricValue: string;
  metricLabel: string;
  detail: string;
  stats: Array<{
    label: string;
    value: string;
  }>;
};

type ChartValueFormat = "percent" | "score" | "count";

type RawChartPoint = {
  label: string;
  value: number;
};

type RawChartSeries = {
  key: string;
  label: string;
  color: string;
  points: RawChartPoint[];
  isLead?: boolean;
};

type LineChart = {
  id: string;
  title: string;
  description: string;
  minLabel: string;
  maxLabel: string;
  series: Array<{
    key: string;
    label: string;
    color: string;
    points: Array<{
      x: number;
      y: number;
      label: string;
      valueLabel: string;
    }>;
    pointsAttr: string;
    isLead?: boolean;
  }>;
  baseline?: {
    label: string;
    y: number;
  };
  threshold?: {
    label: string;
    y: number;
  };
};

const READY_ROUND_THRESHOLD = 3;
const BALANCED_SAMPLE_THRESHOLD = 3;
const CHART_WIDTH = 640;
const CHART_HEIGHT = 190;
const CHART_LEFT = 42;
const CHART_RIGHT = 30;
const CHART_TOP = 30;
const CHART_BOTTOM = 32;

const regimeDefinitions: Record<BenchmarkTrack, RegimeDefinition[]> = {
  weekly: [
    { key: "sharp_down", label: "Sharp Down", rangeLabel: "S&P <= -2.0%", direction: "down" },
    { key: "down", label: "Down", rangeLabel: "-2.0% to -0.5%", direction: "down" },
    { key: "flat", label: "Flat", rangeLabel: "-0.5% to +0.5%", direction: "flat" },
    { key: "up", label: "Up", rangeLabel: "+0.5% to +2.0%", direction: "up" },
    { key: "sharp_up", label: "Sharp Up", rangeLabel: "S&P >= +2.0%", direction: "up" }
  ],
  monthly: [
    { key: "sharp_down", label: "Sharp Down", rangeLabel: "S&P <= -3.0%", direction: "down" },
    { key: "down", label: "Down", rangeLabel: "-3.0% to -1.0%", direction: "down" },
    { key: "flat", label: "Flat", rangeLabel: "-1.0% to +1.0%", direction: "flat" },
    { key: "up", label: "Up", rangeLabel: "+1.0% to +3.0%", direction: "up" },
    { key: "sharp_up", label: "Sharp Up", rangeLabel: "S&P >= +3.0%", direction: "up" }
  ]
};

const sampleCategoryDefinitions: Record<BenchmarkTrack, SampleCategoryDefinition[]> = {
  weekly: [
    { key: "down", label: "Down", rangeLabel: "S&P < -0.5%" },
    { key: "flat", label: "Flat", rangeLabel: "-0.5% to +0.5%" },
    { key: "up", label: "Up", rangeLabel: "S&P > +0.5%" }
  ],
  monthly: [
    { key: "down", label: "Down", rangeLabel: "S&P < -1.0%" },
    { key: "flat", label: "Flat", rangeLabel: "-1.0% to +1.0%" },
    { key: "up", label: "Up", rangeLabel: "S&P > +1.0%" }
  ]
};

function finiteNumber(value: number | null | undefined): value is number {
  return typeof value === "number" && Number.isFinite(value);
}

function average(values: number[]): number | undefined {
  if (values.length === 0) return undefined;
  return values.reduce((total, value) => total + value, 0) / values.length;
}

function leaderboardReturn(row: LeaderboardRecord): number | undefined {
  return row.portfolio_return ?? row.selected_asset_return;
}

function bestUniverseReturn(rows: ResultReturnRecord[]): number | undefined {
  return rows
    .filter((row) => finiteNumber(row.return))
    .sort((left, right) => right.return - left.return)[0]?.return;
}

function classifyRegime(track: BenchmarkTrack, sp500Return: number): RegimeDefinition {
  const definitions = regimeDefinitions[track];
  if (track === "weekly") {
    if (sp500Return <= -0.02) return definitions[0];
    if (sp500Return < -0.005) return definitions[1];
    if (sp500Return <= 0.005) return definitions[2];
    if (sp500Return < 0.02) return definitions[3];
    return definitions[4];
  }

  if (sp500Return <= -0.03) return definitions[0];
  if (sp500Return < -0.01) return definitions[1];
  if (sp500Return <= 0.01) return definitions[2];
  if (sp500Return < 0.03) return definitions[3];
  return definitions[4];
}

function classifySampleCategory(track: BenchmarkTrack, sp500Return: number): SampleCategoryDefinition {
  const definitions = sampleCategoryDefinitions[track];
  if (track === "weekly") {
    if (sp500Return < -0.005) return definitions[0];
    if (sp500Return <= 0.005) return definitions[1];
    return definitions[2];
  }

  if (sp500Return < -0.01) return definitions[0];
  if (sp500Return <= 0.01) return definitions[1];
  return definitions[2];
}

function regimeStatus(count: number): RegimeStatus {
  if (count >= READY_ROUND_THRESHOLD) return "Ready";
  if (count > 0) return "Forming";
  return "No data yet";
}

function scoreText(value: number | undefined): string {
  return finiteNumber(value) ? value.toFixed(1) : "n/a";
}

function pctText(value: number | undefined): string {
  return finiteNumber(value) ? pct(value) : "n/a";
}

function signedPctText(value: number | undefined): string {
  if (!finiteNumber(value)) return "n/a";
  const formatted = pct(value);
  return value > 0 ? `+${formatted}` : formatted;
}

function chartValueText(value: number, format: ChartValueFormat): string {
  if (format === "percent") {
    const sign = value > 0 ? "+" : "";
    return `${sign}${value.toFixed(1)}%`;
  }
  if (format === "count") return Math.round(value).toString();
  return value.toFixed(1);
}

function chartY(value: number, min: number, max: number): number {
  if (max === min) return CHART_TOP + (CHART_HEIGHT - CHART_TOP - CHART_BOTTOM) / 2;
  const usableHeight = CHART_HEIGHT - CHART_TOP - CHART_BOTTOM;
  return CHART_TOP + (max - value) / (max - min) * usableHeight;
}

function chartBounds(values: number[], options?: { includeZero?: boolean; threshold?: number; floorZero?: boolean }) {
  const boundedValues = values.slice();
  if (options?.includeZero) boundedValues.push(0);
  if (finiteNumber(options?.threshold)) boundedValues.push(options.threshold);

  let min = boundedValues.length ? Math.min(...boundedValues) : 0;
  let max = boundedValues.length ? Math.max(...boundedValues) : 1;
  if (options?.floorZero) min = Math.min(0, min);

  if (min === max) {
    min -= 1;
    max += 1;
  } else if (!options?.floorZero) {
    const padding = (max - min) * 0.12;
    min -= padding;
    max += padding;
  } else {
    max += Math.max(1, (max - min) * 0.16);
  }

  return { min, max };
}

function buildLineChart(options: {
  id: string;
  title: string;
  description: string;
  format: ChartValueFormat;
  series: RawChartSeries[];
  includeZero?: boolean;
  threshold?: { value: number; label: string };
  floorZero?: boolean;
}): LineChart {
  const values = options.series.flatMap((series) => series.points.map((point) => point.value)).filter(finiteNumber);
  const bounds = chartBounds(values, {
    includeZero: options.includeZero,
    threshold: options.threshold?.value,
    floorZero: options.floorZero
  });
  const xSpan = CHART_WIDTH - CHART_LEFT - CHART_RIGHT;

  return {
    id: options.id,
    title: options.title,
    description: options.description,
    minLabel: chartValueText(bounds.min, options.format),
    maxLabel: chartValueText(bounds.max, options.format),
    series: options.series.map((series) => {
      const denominator = Math.max(1, series.points.length - 1);
      const points = series.points.map((point, index) => ({
        x: CHART_LEFT + (index / denominator) * xSpan,
        y: chartY(point.value, bounds.min, bounds.max),
        label: point.label,
        valueLabel: chartValueText(point.value, options.format)
      }));
      return {
        ...series,
        points,
        pointsAttr: points.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(" ")
      };
    }),
    baseline:
      options.includeZero && bounds.min <= 0 && bounds.max >= 0
        ? { label: "0", y: chartY(0, bounds.min, bounds.max) }
        : undefined,
    threshold: options.threshold
      ? { label: options.threshold.label, y: chartY(options.threshold.value, bounds.min, bounds.max) }
      : undefined
  };
}

function statusClass(status: string): string {
  return status.toLowerCase().replaceAll(" ", "-");
}

function trackLabel(track: BenchmarkTrack): string {
  return track === "weekly" ? "Weekly" : "Monthly";
}

function statusMeaning(status: RegimeStatus | "Ready" | "Forming"): string {
  if (status === "Ready") return "Included in score";
  if (status === "Forming") return "Shown, not counted yet";
  return "Not tested yet";
}

function statusLabel(status: RegimeStatus | "Ready" | "Forming"): string {
  if (status === "Ready") return "Counts now";
  if (status === "Forming") return "Needs more rounds";
  return "No rounds yet";
}

function roundSortKey(round: RoundRecord): string {
  return `${round.exit_date ?? ""}:${round.decision_deadline_utc ?? ""}:${round.round_id}`;
}

function roundRecencySort(left: RegimeRound, right: RegimeRound): number {
  return (
    (right.round.exit_date ?? "").localeCompare(left.round.exit_date ?? "") ||
    (right.round.decision_deadline_utc ?? "").localeCompare(left.round.decision_deadline_utc ?? "") ||
    right.round.round_id.localeCompare(left.round.round_id)
  );
}

const roundRows = staticRoundRecords().filter((round) => /^CB-\d{4}-\d{2}-\d{2}-(1W|1M)$/.test(round.round_id));
const scorecards = {
  weekly: buildTrackScorecard(roundRows, "weekly"),
  monthly: buildTrackScorecard(roundRows, "monthly")
};

const regimeRounds = roundRows
  .filter((round) => round.status === "resolved")
  .map((round): RegimeRound | null => {
    const track = roundTrack(round);
    if (track !== "weekly" && track !== "monthly") return null;

    const leaderboard = staticRoundLeaderboard(round.round_id, round.official_run_id);
    const sp500Return = leaderboard.find((row) => finiteNumber(row.sp500_return))?.sp500_return;
    const maxPossibleReturn = bestUniverseReturn(staticRoundReturns(round.round_id, round.official_run_id));
    if (!finiteNumber(sp500Return) || !finiteNumber(maxPossibleReturn) || leaderboard.length === 0) return null;

    const modelRows = leaderboard.filter((row) => finiteNumber(leaderboardReturn(row)));
    const alphas = modelRows.map((row) => row.alpha_vs_sp500).filter(finiteNumber);
    const hits = modelRows.filter((row) => finiteNumber(row.alpha_vs_sp500) && row.alpha_vs_sp500 > 0).length;

    return {
      round,
      track,
      regime: classifyRegime(track, sp500Return),
      leaderboard,
      sp500Return,
      maxPossibleReturn,
      averageAlpha: average(alphas),
      hitRate: modelRows.length ? hits / modelRows.length : undefined,
      modelCount: modelRows.length
    };
  })
  .filter((round): round is RegimeRound => round !== null);

function buildCoverage(track: BenchmarkTrack): RegimeCoverage[] {
  const trackRounds = regimeRounds.filter((round) => round.track === track);
  return regimeDefinitions[track].map((definition) => {
    const rounds = trackRounds.filter((round) => round.regime.key === definition.key);
    return {
      ...definition,
      count: rounds.length,
      averageSp500Return: average(rounds.map((round) => round.sp500Return)),
      status: regimeStatus(rounds.length),
      rounds
    };
  });
}

const coverageByTrack = {
  weekly: buildCoverage("weekly"),
  monthly: buildCoverage("monthly")
};

function trackConfidence(track: BenchmarkTrack): { label: string; detail: string; className: string } {
  const coverage = coverageByTrack[track];
  const ready = coverage.filter((item) => item.status === "Ready");
  const hasReadyDown = ready.some((item) => item.direction === "down");
  const hasReadyUp = ready.some((item) => item.direction === "up");

  if (ready.length === 0) {
    return {
      label: "No counting types",
      detail: "The page will update after resolved rounds exist.",
      className: "empty"
    };
  }

  if (hasReadyDown && hasReadyUp) {
    return {
      label: "More balanced",
      detail: `${ready.length} market types count now, including up and down markets.`,
      className: "ready"
    };
  }

  return {
    label: "Still one-sided",
    detail: `${ready.length} market type${ready.length === 1 ? "" : "s"} count now; more market variety is needed.`,
    className: "forming"
  };
}

function allRoundScore(track: BenchmarkTrack, modelId: string): number | undefined {
  const row = scorecards[track]?.normalizedRows.find((item) => item.kind === "model" && item.key === modelId);
  return row?.averageScore;
}

function buildRegimeLeaderboard(track: BenchmarkTrack): RegimeLeaderboardRow[] {
  const readyRegimes = coverageByTrack[track].filter((item) => item.status === "Ready");
  const accumulators = new Map<
    string,
    {
      modelId: string;
      provider: string;
      regimes: Map<RegimeKey, ModelRegimeStats>;
    }
  >();

  for (const regime of readyRegimes) {
    for (const regimeRound of regime.rounds) {
      for (const row of regimeRound.leaderboard) {
        const returnValue = leaderboardReturn(row);
        if (!finiteNumber(returnValue)) continue;

        const existing = accumulators.get(row.model_id) ?? {
          modelId: row.model_id,
          provider: row.provider,
          regimes: new Map<RegimeKey, ModelRegimeStats>()
        };
        const stats = existing.regimes.get(regime.key) ?? {
          returns: [],
          maxReturns: [],
          alphas: [],
          hits: [],
          rounds: []
        };

        stats.returns.push(returnValue);
        stats.maxReturns.push(regimeRound.maxPossibleReturn);
        if (finiteNumber(row.alpha_vs_sp500)) stats.alphas.push(row.alpha_vs_sp500);
        stats.hits.push(finiteNumber(row.alpha_vs_sp500) && row.alpha_vs_sp500 > 0);
        stats.rounds.push(regimeRound.round.round_id);
        existing.regimes.set(regime.key, stats);
        accumulators.set(row.model_id, existing);
      }
    }
  }

  return Array.from(accumulators.values())
    .map((item) => {
      const regimeScores = readyRegimes.map((regime) => {
        const stats = item.regimes.get(regime.key);
        return {
          key: regime.key,
          label: regime.label,
          score: stats ? cumulativeCapitalBenchScore(stats.returns, stats.maxReturns) ?? undefined : undefined,
          tests: stats?.returns.length ?? 0
        };
      });
      const includedScores = regimeScores.map((row) => row.score).filter(finiteNumber);
      const allStats = Array.from(item.regimes.values());
      const alphas = allStats.flatMap((stats) => stats.alphas);
      const hits = allStats.flatMap((stats) => stats.hits);
      const testsIncluded = allStats.reduce((total, stats) => total + stats.returns.length, 0);
      const readyRegimesCovered = regimeScores.filter((row) => finiteNumber(row.score)).length;
      const status: "Ready" | "Forming" =
        readyRegimes.length > 0 && readyRegimesCovered === readyRegimes.length ? "Ready" : "Forming";

      return {
        modelId: item.modelId,
        provider: item.provider,
        label: modelLabel(item.modelId),
        providerName: providerLabel(item.provider),
        logoSrc: providerLogoSrc(item.provider),
        regimeBalancedScore: average(includedScores),
        allRoundScore: allRoundScore(track, item.modelId),
        averageAlpha: average(alphas),
        hitRate: hits.length ? hits.filter(Boolean).length / hits.length : undefined,
        testsIncluded,
        readyRegimesCovered,
        readyRegimesRequired: readyRegimes.length,
        status,
        regimeScores
      };
    })
    .sort(
      (left, right) =>
        Number(right.status === "Ready") - Number(left.status === "Ready") ||
        (right.regimeBalancedScore ?? Number.NEGATIVE_INFINITY) -
          (left.regimeBalancedScore ?? Number.NEGATIVE_INFINITY) ||
        left.label.localeCompare(right.label)
    );
}

const leaderboards = {
  weekly: buildRegimeLeaderboard("weekly"),
  monthly: buildRegimeLeaderboard("monthly")
};

function buildBalancedSampleLeaderboard(selectedRounds: RegimeRound[]): BalancedSampleLeaderboardRow[] {
  if (selectedRounds.length === 0) return [];

  const accumulators = new Map<
    string,
    {
      modelId: string;
      provider: string;
      returns: number[];
      maxReturns: number[];
      alphas: number[];
      hits: boolean[];
    }
  >();

  for (const sampleRound of selectedRounds) {
    for (const row of sampleRound.leaderboard) {
      const returnValue = leaderboardReturn(row);
      if (!finiteNumber(returnValue)) continue;

      const existing = accumulators.get(row.model_id) ?? {
        modelId: row.model_id,
        provider: row.provider,
        returns: [],
        maxReturns: [],
        alphas: [],
        hits: []
      };

      existing.returns.push(returnValue);
      existing.maxReturns.push(sampleRound.maxPossibleReturn);
      if (finiteNumber(row.alpha_vs_sp500)) existing.alphas.push(row.alpha_vs_sp500);
      existing.hits.push(finiteNumber(row.alpha_vs_sp500) && row.alpha_vs_sp500 > 0);
      accumulators.set(row.model_id, existing);
    }
  }

  return Array.from(accumulators.values())
    .map((item) => {
      const status: "Ready" | "Forming" = item.returns.length === selectedRounds.length ? "Ready" : "Forming";
      return {
        modelId: item.modelId,
        provider: item.provider,
        label: modelLabel(item.modelId),
        providerName: providerLabel(item.provider),
        logoSrc: providerLogoSrc(item.provider),
        score: cumulativeCapitalBenchScore(item.returns, item.maxReturns) ?? undefined,
        averageAlpha: average(item.alphas),
        hitRate: item.hits.length ? item.hits.filter(Boolean).length / item.hits.length : undefined,
        testsIncluded: item.returns.length,
        testsRequired: selectedRounds.length,
        status
      };
    })
    .sort(
      (left, right) =>
        Number(right.status === "Ready") - Number(left.status === "Ready") ||
        (right.score ?? Number.NEGATIVE_INFINITY) - (left.score ?? Number.NEGATIVE_INFINITY) ||
        left.label.localeCompare(right.label)
    );
}

function buildBalancedSample(track: BenchmarkTrack): BalancedSampleTrack {
  const trackRounds = regimeRounds.filter((round) => round.track === track);
  const categories = sampleCategoryDefinitions[track].map((definition) => {
    const rounds = trackRounds.filter((round) => classifySampleCategory(track, round.sp500Return).key === definition.key);
    return {
      ...definition,
      count: rounds.length,
      missing: Math.max(0, BALANCED_SAMPLE_THRESHOLD - rounds.length),
      selectedCount: 0
    };
  });
  const status: "Ready" | "Forming" = categories.every((category) => category.count >= BALANCED_SAMPLE_THRESHOLD)
    ? "Ready"
    : "Forming";
  const sampleSize = status === "Ready" ? Math.min(...categories.map((category) => category.count)) : 0;
  const selectedRounds =
    status === "Ready"
      ? categories.flatMap((category) =>
          trackRounds
            .filter((round) => classifySampleCategory(track, round.sp500Return).key === category.key)
            .sort(roundRecencySort)
            .slice(0, sampleSize)
        )
      : [];
  const selectedCountByCategory = new Map<SampleCategoryKey, number>();
  for (const round of selectedRounds) {
    const key = classifySampleCategory(track, round.sp500Return).key;
    selectedCountByCategory.set(key, (selectedCountByCategory.get(key) ?? 0) + 1);
  }
  const categoriesWithSelection = categories.map((category) => ({
    ...category,
    selectedCount: selectedCountByCategory.get(category.key) ?? 0
  }));
  const missingParts = categoriesWithSelection
    .filter((category) => category.missing > 0)
    .map(
      (category) =>
        `${category.missing} more ${category.label.toLowerCase()} ${track} round${category.missing === 1 ? "" : "s"}`
    );

  return {
    track,
    status,
    categories: categoriesWithSelection,
    sampleSize,
    selectedRounds,
    missingSummary: missingParts.length ? `Needs ${missingParts.join(" and ")}.` : "Ready to rank models.",
    leaderboard: buildBalancedSampleLeaderboard(selectedRounds)
  };
}

const balancedSamples = {
  weekly: buildBalancedSample("weekly"),
  monthly: buildBalancedSample("monthly")
};

function pluralizeRound(count: number): string {
  return `${count} round${count === 1 ? "" : "s"}`;
}

function missingRoundText(count: number): string {
  return count > 0 ? `Needs ${pluralizeRound(count)} more.` : "Ready for scoring.";
}

function buildDirectionBucket(track: BenchmarkTrack, direction: SampleCategoryKey): DirectionBucket {
  const definition = sampleCategoryDefinitions[track].find((item) => item.key === direction) ?? sampleCategoryDefinitions[track][0];
  const rounds = regimeRounds.filter(
    (round) => round.track === track && classifySampleCategory(track, round.sp500Return).key === direction
  );
  const accumulators = new Map<
    string,
    {
      modelId: string;
      provider: string;
      returns: number[];
      maxReturns: number[];
      alphas: number[];
      hits: boolean[];
    }
  >();

  for (const round of rounds) {
    for (const row of round.leaderboard) {
      const returnValue = leaderboardReturn(row);
      if (!finiteNumber(returnValue)) continue;

      const existing = accumulators.get(row.model_id) ?? {
        modelId: row.model_id,
        provider: row.provider,
        returns: [],
        maxReturns: [],
        alphas: [],
        hits: []
      };

      existing.returns.push(returnValue);
      existing.maxReturns.push(round.maxPossibleReturn);
      if (finiteNumber(row.alpha_vs_sp500)) existing.alphas.push(row.alpha_vs_sp500);
      existing.hits.push(finiteNumber(row.alpha_vs_sp500) && row.alpha_vs_sp500 > 0);
      accumulators.set(row.model_id, existing);
    }
  }

  const modelRows = Array.from(accumulators.values())
    .map((item) => ({
      modelId: item.modelId,
      provider: item.provider,
      label: modelLabel(item.modelId),
      providerName: providerLabel(item.provider),
      logoSrc: providerLogoSrc(item.provider),
      score: cumulativeCapitalBenchScore(item.returns, item.maxReturns) ?? undefined,
      averageAlpha: average(item.alphas),
      hitRate: item.hits.length ? item.hits.filter(Boolean).length / item.hits.length : undefined,
      tests: item.returns.length
    }))
    .sort(
      (left, right) =>
        (right.score ?? Number.NEGATIVE_INFINITY) - (left.score ?? Number.NEGATIVE_INFINITY) ||
        left.label.localeCompare(right.label)
    );

  return {
    ...definition,
    track,
    rounds,
    status: rounds.length >= READY_ROUND_THRESHOLD ? "Ready" : "Forming",
    modelRows
  };
}

const directionBuckets = {
  weekly: {
    down: buildDirectionBucket("weekly", "down"),
    flat: buildDirectionBucket("weekly", "flat"),
    up: buildDirectionBucket("weekly", "up")
  },
  monthly: {
    down: buildDirectionBucket("monthly", "down"),
    flat: buildDirectionBucket("monthly", "flat"),
    up: buildDirectionBucket("monthly", "up")
  }
};

const directionCopy: Record<SampleCategoryKey, { adjective: string; noun: string; tone: "down" | "flat" | "up" }> = {
  down: { adjective: "negative", noun: "down markets", tone: "down" },
  flat: { adjective: "flat", noun: "flat markets", tone: "flat" },
  up: { adjective: "positive", noun: "up markets", tone: "up" }
};

function buildDirectionLeaderInsight(track: BenchmarkTrack, direction: SampleCategoryKey): MarketInsightCard {
  const bucket = directionBuckets[track][direction];
  const leader = bucket.modelRows.find((row) => finiteNumber(row.score));
  const copy = directionCopy[direction];
  const missing = Math.max(0, READY_ROUND_THRESHOLD - bucket.rounds.length);

  if (!leader) {
    return {
      key: `${track}-${direction}-leader`,
      eyebrow: `${trackLabel(track)} ${copy.noun}`,
      title: `No ${trackLabel(track).toLowerCase()} ${copy.noun} leader yet.`,
      tone: copy.tone,
      status: "Forming",
      metricValue: "n/a",
      metricLabel: "benchmark score",
      detail: `No resolved ${trackLabel(track).toLowerCase()} rounds have landed in this market type yet.`,
      stats: [
        { label: "Rounds", value: pluralizeRound(bucket.rounds.length) },
        { label: "Range", value: bucket.rangeLabel }
      ]
    };
  }

  return {
    key: `${track}-${direction}-leader`,
    eyebrow: `${trackLabel(track)} ${copy.noun}`,
    title: `${leader.label} leads when the S&P 500 is ${copy.adjective}.`,
    tone: copy.tone,
    status: bucket.status,
    model: {
      label: leader.label,
      providerName: leader.providerName,
      logoSrc: leader.logoSrc
    },
    metricValue: scoreText(leader.score),
    metricLabel: "benchmark score",
    detail:
      bucket.status === "Ready"
        ? `Based on ${pluralizeRound(bucket.rounds.length)} where the S&P 500 was ${copy.adjective}.`
        : `Current signal only. ${missingRoundText(missing)}`,
    stats: [
      { label: "Avg alpha", value: signedPctText(leader.averageAlpha) },
      { label: "Hit rate", value: finiteNumber(leader.hitRate) ? pct(leader.hitRate) : "n/a" },
      { label: "Tests", value: `${leader.tests}/${bucket.rounds.length}` }
    ]
  };
}

function directionRowForModel(bucket: DirectionBucket, modelId: string): DirectionModelRow | undefined {
  return bucket.modelRows.find((row) => row.modelId === modelId);
}

function buildConsistencyInsight(track: BenchmarkTrack): MarketInsightCard {
  const buckets = sampleCategoryDefinitions[track]
    .map((definition) => directionBuckets[track][definition.key])
    .filter((bucket) => bucket.rounds.length > 0);
  const modelIds = Array.from(new Set(buckets.flatMap((bucket) => bucket.modelRows.map((row) => row.modelId))));
  const candidates = modelIds
    .map((modelId) => {
      const rows = buckets.map((bucket) => directionRowForModel(bucket, modelId)).filter((row): row is DirectionModelRow => !!row && finiteNumber(row.score));
      if (rows.length < 2) return null;
      const scores = rows.map((row) => row.score).filter(finiteNumber);
      const first = rows[0];
      return {
        modelId,
        label: first.label,
        providerName: first.providerName,
        logoSrc: first.logoSrc,
        floorScore: Math.min(...scores),
        averageScore: average(scores),
        directionsCovered: rows.length,
        averageAlpha: average(rows.map((row) => row.averageAlpha).filter(finiteNumber)),
        hitRate: average(rows.map((row) => row.hitRate).filter(finiteNumber))
      };
    })
    .filter((item): item is NonNullable<typeof item> => item !== null)
    .sort(
      (left, right) =>
        right.floorScore - left.floorScore ||
        right.directionsCovered - left.directionsCovered ||
        left.label.localeCompare(right.label)
    );
  const leader = candidates[0];
  const allReady = buckets.length >= 2 && buckets.every((bucket) => bucket.status === "Ready");

  if (!leader) {
    return {
      key: `${track}-steady`,
      eyebrow: `${trackLabel(track)} consistency`,
      title: "Consistency insight is still forming.",
      tone: "steady",
      status: "Forming",
      metricValue: "n/a",
      metricLabel: "score floor",
      detail: "At least two tested market types are needed before comparing model consistency.",
      stats: [
        { label: "Types tested", value: `${buckets.length}/3` },
        { label: "Ready types", value: `${buckets.filter((bucket) => bucket.status === "Ready").length}/3` }
      ]
    };
  }

  return {
    key: `${track}-steady`,
    eyebrow: `${trackLabel(track)} consistency`,
    title: `${leader.label} has the strongest score floor.`,
    tone: "steady",
    status: allReady ? "Ready" : "Forming",
    model: {
      label: leader.label,
      providerName: leader.providerName,
      logoSrc: leader.logoSrc
    },
    metricValue: scoreText(leader.floorScore),
    metricLabel: "lowest tested score",
    detail: `Lowest score across ${leader.directionsCovered} tested market types; average score ${scoreText(leader.averageScore)}.`,
    stats: [
      { label: "Avg alpha", value: signedPctText(leader.averageAlpha) },
      { label: "Avg hit rate", value: finiteNumber(leader.hitRate) ? pct(leader.hitRate) : "n/a" },
      { label: "Types", value: `${leader.directionsCovered}/3` }
    ]
  };
}

function buildSplitInsight(track: BenchmarkTrack): MarketInsightCard {
  const downBucket = directionBuckets[track].down;
  const upBucket = directionBuckets[track].up;
  const modelIds = Array.from(
    new Set([...downBucket.modelRows.map((row) => row.modelId), ...upBucket.modelRows.map((row) => row.modelId)])
  );
  const candidates = modelIds
    .map((modelId) => {
      const down = directionRowForModel(downBucket, modelId);
      const up = directionRowForModel(upBucket, modelId);
      if (!down || !up || !finiteNumber(down.score) || !finiteNumber(up.score)) return null;
      const gap = up.score - down.score;
      return {
        modelId,
        label: up.label,
        providerName: up.providerName,
        logoSrc: up.logoSrc,
        downScore: down.score,
        upScore: up.score,
        gap,
        absGap: Math.abs(gap)
      };
    })
    .filter((item): item is NonNullable<typeof item> => item !== null)
    .sort((left, right) => right.absGap - left.absGap || left.label.localeCompare(right.label));
  const leader = candidates[0];
  const allReady = downBucket.status === "Ready" && upBucket.status === "Ready";

  if (!leader) {
    return {
      key: `${track}-split`,
      eyebrow: `${trackLabel(track)} up/down split`,
      title: "Up/down split is still forming.",
      tone: "split",
      status: "Forming",
      metricValue: "n/a",
      metricLabel: "score gap",
      detail: "Both negative and positive S&P 500 samples are needed before measuring directional split.",
      stats: [
        { label: "Down rounds", value: pluralizeRound(downBucket.rounds.length) },
        { label: "Up rounds", value: pluralizeRound(upBucket.rounds.length) }
      ]
    };
  }

  const stronger = leader.gap >= 0 ? "up markets" : "down markets";
  const weaker = leader.gap >= 0 ? "down markets" : "up markets";

  return {
    key: `${track}-split`,
    eyebrow: `${trackLabel(track)} up/down split`,
    title: `${leader.label} changes most between up and down markets.`,
    tone: "split",
    status: allReady ? "Ready" : "Forming",
    model: {
      label: leader.label,
      providerName: leader.providerName,
      logoSrc: leader.logoSrc
    },
    metricValue: `${leader.absGap.toFixed(1)} pts`,
    metricLabel: `${stronger} over ${weaker}`,
    detail: `${scoreText(leader.upScore)} in up markets versus ${scoreText(leader.downScore)} in down markets.`,
    stats: [
      { label: "Down score", value: scoreText(leader.downScore) },
      { label: "Up score", value: scoreText(leader.upScore) },
      { label: "Samples", value: `${downBucket.rounds.length}/${upBucket.rounds.length}` }
    ]
  };
}

const marketInsightTracks = (["weekly", "monthly"] as BenchmarkTrack[]).map((track) => ({
  track,
  label: trackLabel(track),
  cards: [
    buildDirectionLeaderInsight(track, "down"),
    buildDirectionLeaderInsight(track, "flat"),
    buildDirectionLeaderInsight(track, "up"),
    buildConsistencyInsight(track),
    buildSplitInsight(track)
  ]
}));

const scorePathColors = ["#006b5f", "#1e476f", "#b45335", "#80520a"];
const sampleCategoryColors: Record<SampleCategoryKey, string> = {
  down: "#b45335",
  flat: "#64748b",
  up: "#006b5f"
};

function chronologicalRounds(track: BenchmarkTrack): RegimeRound[] {
  return regimeRounds
    .filter((round) => round.track === track)
    .slice()
    .sort((left, right) => roundSortKey(left.round).localeCompare(roundSortKey(right.round)));
}

function roundChartLabel(round: RegimeRound): string {
  return dateOnly(round.round.exit_date) || round.round.round_id;
}

function buildSp500MovementChart(track: BenchmarkTrack): LineChart {
  const rounds = chronologicalRounds(track);
  return buildLineChart({
    id: `${track}-sp500-regime-path`,
    title: `${trackLabel(track)} S&P 500 movement`,
    description: "Each point is one scored round. The S&P 500 move decides the market type.",
    format: "percent",
    includeZero: true,
    series: [
      {
        key: "sp500",
        label: "S&P 500 return",
        color: "#006b5f",
        points: rounds.map((round) => ({
          label: roundChartLabel(round),
          value: round.sp500Return * 100
        }))
      }
    ]
  });
}

function buildLeaderboardScorePathChart(track: BenchmarkTrack): LineChart {
  const rounds = chronologicalRounds(track);
  const topRows = leaderboards[track].filter((row) => finiteNumber(row.regimeBalancedScore)).slice(0, 4);
  return buildLineChart({
    id: `${track}-regime-score-path`,
    title: `${trackLabel(track)} top score path`,
    description: "Cumulative score movement for the current top market-type models.",
    format: "score",
    includeZero: true,
    series: topRows.map((row, index) => {
      const returns: number[] = [];
      const maxReturns: number[] = [];
      const points: RawChartPoint[] = [];

      for (const round of rounds) {
        const modelRound = round.leaderboard.find((item) => item.model_id === row.modelId);
        const returnValue = modelRound ? leaderboardReturn(modelRound) : undefined;
        if (!finiteNumber(returnValue)) continue;

        returns.push(returnValue);
        maxReturns.push(round.maxPossibleReturn);
        const score = cumulativeCapitalBenchScore(returns, maxReturns);
        if (finiteNumber(score)) {
          points.push({
            label: roundChartLabel(round),
            value: score
          });
        }
      }

      return {
        key: row.modelId,
        label: row.label,
        color: scorePathColors[index % scorePathColors.length],
        points,
        isLead: index === 0
      };
    })
  });
}

function buildBalancedProgressChart(track: BenchmarkTrack): LineChart {
  const rounds = chronologicalRounds(track);
  const counts = new Map<SampleCategoryKey, number>(sampleCategoryDefinitions[track].map((category) => [category.key, 0]));
  const pointsByCategory = new Map<SampleCategoryKey, RawChartPoint[]>(
    sampleCategoryDefinitions[track].map((category) => [category.key, []])
  );

  for (const round of rounds) {
    const category = classifySampleCategory(track, round.sp500Return);
    counts.set(category.key, (counts.get(category.key) ?? 0) + 1);
    const label = roundChartLabel(round);
    for (const definition of sampleCategoryDefinitions[track]) {
      pointsByCategory.get(definition.key)?.push({
        label,
        value: counts.get(definition.key) ?? 0
      });
    }
  }

  return buildLineChart({
    id: `${track}-balanced-sample-progress`,
    title: `${trackLabel(track)} sample balance progress`,
    description: "Shows how many down, flat, and up rounds are available.",
    format: "count",
    floorZero: true,
    threshold: {
      value: BALANCED_SAMPLE_THRESHOLD,
      label: `${BALANCED_SAMPLE_THRESHOLD} needed`
    },
    series: sampleCategoryDefinitions[track].map((category) => ({
      key: category.key,
      label: category.label,
      color: sampleCategoryColors[category.key],
      points: pointsByCategory.get(category.key) ?? []
    }))
  });
}

const sp500MovementCharts = {
  weekly: buildSp500MovementChart("weekly"),
  monthly: buildSp500MovementChart("monthly")
};

const leaderboardScorePathCharts = {
  weekly: buildLeaderboardScorePathChart("weekly"),
  monthly: buildLeaderboardScorePathChart("monthly")
};

const balancedProgressCharts = {
  weekly: buildBalancedProgressChart("weekly"),
  monthly: buildBalancedProgressChart("monthly")
};

const trackSummaries = (["weekly", "monthly"] as BenchmarkTrack[]).map((track) => {
  const coverage = coverageByTrack[track];
  const readyCount = coverage.filter((item) => item.status === "Ready").length;
  const totalRounds = regimeRounds.filter((round) => round.track === track).length;
  const confidence = trackConfidence(track);
  return {
    track,
    label: trackLabel(track),
    readyCount,
    totalRounds,
    confidence
  };
});

const weeklySummary = trackSummaries.find((item) => item.track === "weekly");
const monthlySummary = trackSummaries.find((item) => item.track === "monthly");
const topLeaders = {
  weekly: leaderboards.weekly.find((row) => finiteNumber(row.regimeBalancedScore)),
  monthly: leaderboards.monthly.find((row) => finiteNumber(row.regimeBalancedScore))
};

function leaderContext(track: BenchmarkTrack, leader: RegimeLeaderboardRow | undefined): string {
  if (!leader) return "No market type has enough resolved rounds to rank models yet.";
  const represented = `${leader.readyRegimesCovered}/${leader.readyRegimesRequired} counting market types represented.`;
  const confidence = trackConfidence(track);
  if (confidence.className === "ready") return `${represented} Up and down markets both count.`;
  if (confidence.className === "forming") return `${represented} More market variety is needed.`;
  return represented;
}

const auditRows = regimeRounds
  .slice()
  .sort(
    (left, right) =>
      (right.round.exit_date ?? "").localeCompare(left.round.exit_date ?? "") ||
      right.round.round_id.localeCompare(left.round.round_id)
  );
const visibleAuditRows = auditRows.slice(0, 10);
const hiddenAuditRows = auditRows.slice(10);
