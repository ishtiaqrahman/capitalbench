            <div class="regime-leaderboard-head">
              <div>
                <span class="panel-kicker">{trackLabel(track)} benchmark</span>
                  <h3>{trackLabel(track)} equal-environment scores</h3>
              </div>
              <span class:list={["regime-confidence", `regime-confidence-${trackConfidence(track).className}`]}>
                {trackConfidence(track).label}
              </span>
            </div>
            {leaderboards[track].length ? (
              <div class="regime-rank-list" aria-label={`${trackLabel(track)} equal-environment model rankings`}>
                {leaderboards[track].map((row, index) => (
                  <article class:list={["regime-rank-row", index === 0 && "regime-rank-row-leader"]}>
                    <span class="environment-rank">{index + 1}</span>
                    <div class="regime-rank-model">
                      {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                      <div>
                        <strong>{row.label}</strong>
                        <em>{row.providerName}</em>
                      </div>
                    </div>
                    <div class="regime-rank-primary">
                      <span>Avg return</span>
                      <strong class:list={["return-value", `return-value-${valueTone(row.averageReturn)}`]}>
                        {signedPctText(row.averageReturn)}
                      </strong>
                      <em>{row.readyRegimesCovered}/{row.readyRegimesRequired} counting environments</em>
                    </div>
                    <div class="regime-rank-stat regime-rank-score">
                      <span>Benchmark score</span>
                      <strong>{scoreText(row.regimeBalancedScore)}</strong>
                      <em>Higher is better</em>
                    </div>
                    <div class="regime-rank-stat regime-rank-context">
                      <span>S&amp;P 500 context</span>
                      <strong class:list={["return-value", `return-value-${valueTone(row.averageSp500Return)}`]}>
                        {signedPctText(row.averageSp500Return)}
                      </strong>
                      <em>S&amp;P score {scoreText(row.sp500RegimeScore)}</em>
                    </div>
                    <div class="regime-rank-strip" aria-label={`${row.label} environment returns`}>
                      {row.regimeScores.map((score) => (
                        <span>
                          <b>{score.label}</b>
                          <em class:list={["return-value", `return-value-${valueTone(score.averageReturn)}`]}>
                            {signedPctText(score.averageReturn)}
                          </em>
                        </span>
                      ))}
                    </div>
                    <div class="regime-rank-meta">
                      <span>
                        <b>{scoreText(row.allRoundScore)}</b>
                        <em>all-round score</em>
                      </span>
                      <span>
                        <b>{signedPctText(row.averageAlpha)}</b>
                        <em>avg alpha vs S&amp;P</em>
                      </span>
                      <span title="Share of included model tests where this model beat the S&P 500 return.">
                        <b>{finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}</b>
                        <em>hit rate</em>
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="environment-empty-ranking">No environments count yet.</div>
            )}
            <div class="regime-rank-card-grid" aria-label={`${trackLabel(track)} top equal-environment models`}>
              {leaderboards[track].slice(0, 3).map((row, index) => (
                <article class:list={["regime-rank-card", index === 0 && "regime-rank-card-leader"]}>
                  <span class="environment-rank">{index + 1}</span>
                  {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                  <div>
                    <strong>{row.label}</strong>
                    <em>{row.providerName}</em>
                  </div>
                  <b class:list={["return-value", `return-value-${valueTone(row.averageReturn)}`]}>
                    {signedPctText(row.averageReturn)}
                  </b>
                  <small>Score {scoreText(row.regimeBalancedScore)} · S&amp;P {signedPctText(row.averageSp500Return)}</small>
                </article>
              ))}
            </div>
            <div class="table-shell regime-table-shell">
              <table>
                <thead>
                  <tr>
                    <th>Model</th>
                    <th>Avg return</th>
                    <th>Benchmark score</th>
                    <th>S&amp;P 500 context</th>
                    <th>Environment returns</th>
                    <th>All-round score</th>
                    <th>Avg alpha vs S&amp;P</th>
                    <th>Hit rate</th>
                  </tr>
                </thead>
                <tbody>
                  {leaderboards[track].length ? (
                    leaderboards[track].map((row, index) => (
                      <tr>
                        <td data-label="Model">
                          <div class="regime-model-cell">
                            <span>{index + 1}</span>
                            {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                            <div>
                              <strong>{row.label}</strong>
                              <em>{row.providerName}</em>
                            </div>
                          </div>
                        </td>
                        <td class="regime-score-value" data-label="Avg return">
                          <strong class:list={["return-value", `return-value-${valueTone(row.averageReturn)}`]}>
                            {signedPctText(row.averageReturn)}
                          </strong>
                          <span>{row.readyRegimesCovered}/{row.readyRegimesRequired} counting environments</span>
                        </td>
                        <td class="regime-score-value" data-label="Benchmark score">
                          <strong>{scoreText(row.regimeBalancedScore)}</strong>
                          <span>higher is better</span>
                        </td>
                        <td class="regime-score-value" data-label="S&P 500 context">
                          <strong class:list={["return-value", `return-value-${valueTone(row.averageSp500Return)}`]}>
                            {signedPctText(row.averageSp500Return)}
                          </strong>
                          <span>S&amp;P score {scoreText(row.sp500RegimeScore)}</span>
                        </td>
                        <td data-label="Environment returns">
                          <div class="regime-score-strip">
                            {row.regimeScores.map((score) => (
                              <span>
                                <b>{score.label}</b>
                                <em class:list={["return-value", `return-value-${valueTone(score.averageReturn)}`]}>
                                  {signedPctText(score.averageReturn)}
                                </em>
                              </span>
                            ))}
                          </div>
                        </td>
                        <td data-label="All-round score">{scoreText(row.allRoundScore)}</td>
                        <td data-label="Avg alpha vs S&P">{signedPctText(row.averageAlpha)}</td>
                        <td data-label="Hit rate">
                          <span title="Share of included model tests where this model beat the S&P 500 return.">
                            {finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}
                          </span>
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colspan="8">No environments count yet.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="regime-section market-insights-section" aria-labelledby="market-insights-title">
      <div class="regime-section-head">
        <span class="panel-kicker">Calculated insights</span>
        <h2 id="market-insights-title">What changes when the market moves differently?</h2>
        <p>
          These cards compare model behavior inside down, flat, and up S&amp;P 500 environments, including environments
          that still need more resolved rounds.
        </p>
      </div>

      <div
        class="market-regime-track-tab-shell"
        data-market-regime-tabs
        data-active-track={defaultRegimeTrack}
        aria-label="Monthly and weekly calculated insights"
      >
        <div class="track-scorecard-tabs" role="tablist" aria-label="Choose calculated insight horizon">
          {marketInsightTracks.map((insightTrack) => {
            const active = insightTrack.track === defaultRegimeTrack;
            const tabId = `market-insights-tab-${insightTrack.track}`;
            const panelId = `market-insights-panel-${insightTrack.track}`;
            return (
              <button
                id={tabId}
                class:list={["track-scorecard-tab", active && "is-active"]}
                type="button"
                role="tab"
                aria-selected={active ? "true" : "false"}
                aria-controls={panelId}
                tabindex={active ? "0" : "-1"}
                data-market-regime-tab={insightTrack.track}
              >
                <strong>{insightTrack.label}</strong>
                <span>{trackConfidence(insightTrack.track).label}</span>
              </button>
            );
          })}
        </div>

        <div class="track-scorecard-tab-panels market-regime-tab-panels">
          {marketInsightTracks.map((insightTrack) => {
            const active = insightTrack.track === defaultRegimeTrack;
            const tabId = `market-insights-tab-${insightTrack.track}`;
            const panelId = `market-insights-panel-${insightTrack.track}`;
            return (
              <div
                id={panelId}
                class="track-scorecard-tab-panel market-regime-tab-panel"
                role="tabpanel"
                aria-labelledby={tabId}
                data-market-regime-panel={insightTrack.track}
                hidden={!active}
              >
                <article class="market-insight-track" id={`market-environment-insight-${insightTrack.track}-synthesis`}>
                  <div class="market-insight-track-head">
                    <div>
                      <span class="panel-kicker">{insightTrack.label} insights</span>
                      <h3>{insightTrack.label} model behavior</h3>
                    </div>
                    <span class:list={["regime-confidence", `regime-confidence-${trackConfidence(insightTrack.track).className}`]}>
                      {trackConfidence(insightTrack.track).label}
                    </span>
                  </div>

                  <div class="market-insight-grid">
                    {insightTrack.cards.map((card) => (
                      <article
                        id={`market-environment-insight-${card.key}`}
                        class:list={["market-insight-card", `market-insight-card-${card.tone}`, `market-insight-card-${statusClass(card.status)}`]}
                      >
                        <header>
                          <span class="panel-kicker">{card.eyebrow}</span>
                          <span class:list={["regime-status", `regime-status-${statusClass(card.status)}`]}>
                            {statusLabel(card.status)}
                          </span>
                        </header>
                        <h4>{card.title}</h4>
                        {card.model && (
                          <div class="market-insight-model">
                            {card.model.logoSrc && <img src={card.model.logoSrc} alt="" loading="lazy" />}
                            <div>
                              <strong>{card.model.label}</strong>
                              <em>{card.model.providerName}</em>
                            </div>
                          </div>
                        )}
                        <div class="market-insight-metric">
                          <strong>{card.metricValue}</strong>
                          <span>{card.metricLabel}</span>
                        </div>
                        <p>{card.detail}</p>
                        <dl>
                          {card.stats.map((stat) => (
                            <div>
                              <dt>{stat.label}</dt>
                              <dd>{stat.value}</dd>
                            </div>
                          ))}
                        </dl>
                      </article>
                    ))}
                  </div>
                </article>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="regime-section" aria-labelledby="regime-method-title">
      <div class="regime-method-panel">
        <div>
          <span class="panel-kicker">Method</span>
          <h2 id="regime-method-title">How the equal-environment score works.</h2>
          <p>
            An environment is the S&amp;P 500 move during a scored round. This view checks whether models perform across
            different environments instead of being helped by one dominant environment.
          </p>
        </div>
        <dl>
          <div>
            <dt>Counting rule</dt>
            <dd>{READY_ROUND_THRESHOLD}+ rounds</dd>
          </div>
          <div>
            <dt>Main score</dt>
            <dd>Average of counting environments</dd>
          </div>
          <div>
            <dt>Scope</dt>
            <dd>Resolved official rounds only</dd>
          </div>
        </dl>
        <ol class="regime-method-flow" aria-label="Market environment benchmark process">
          <li>
            <span>1</span>
            <strong>Use completed rounds</strong>
            <em>Only resolved official results enter this page.</em>
          </li>
          <li>
            <span>2</span>
            <strong>Group by S&amp;P 500 move</strong>
            <em>Each round becomes one S&amp;P 500 environment.</em>
          </li>
          <li>
            <span>3</span>
            <strong>Average counting environments equally</strong>
            <em>Every counting environment carries the same weight.</em>
          </li>
        </ol>
        <div class="regime-method-example">
          <span class="panel-kicker">Example</span>
          <p>
          If a model scores 20 in up environments and -10 in down environments, its equal-environment score is 5. That
          keeps a large pile of up rounds from drowning out the down-environment result.
          </p>
        </div>
      </div>
    </section>

    <details class="regime-advanced-details">
      <summary>
        <span>Advanced check</span>
        <strong>Strict equal-sample benchmark</strong>
        <em>Waits for the same number of down, flat, and up rounds before ranking.</em>
      </summary>

      <section class="regime-section" aria-labelledby="balanced-sample-title">
        <div class="regime-section-head">
          <span class="panel-kicker">Strict equal-sample check</span>
        <h2 id="balanced-sample-title">What happens when down, flat, and up each have the same sample size?</h2>
          <p>
            This stricter benchmark waits for at least {BALANCED_SAMPLE_THRESHOLD} down, {BALANCED_SAMPLE_THRESHOLD} flat,
            and {BALANCED_SAMPLE_THRESHOLD} up rounds. When ready, it compares the same number from each type.
          </p>
        </div>

        <div
          class="market-regime-track-tab-shell"
          data-market-regime-tabs
          data-active-track={defaultRegimeTrack}
          aria-label="Monthly and weekly strict equal-sample checks"
        >
          <div class="track-scorecard-tabs" role="tablist" aria-label="Choose strict equal-sample horizon">
            {regimeTrackOrder.map((track) => {
              const active = track === defaultRegimeTrack;
              const tabId = `balanced-sample-tab-${track}`;
              const panelId = `balanced-sample-panel-${track}`;
              return (
                <button
                  id={tabId}
                  class:list={["track-scorecard-tab", active && "is-active"]}
                  type="button"
                  role="tab"
                  aria-selected={active ? "true" : "false"}
                  aria-controls={panelId}
                  tabindex={active ? "0" : "-1"}
                  data-market-regime-tab={track}
                >
                  <strong>{trackLabel(track)}</strong>
                  <span>{statusLabel(balancedSamples[track].status)}</span>
                </button>
              );
            })}
          </div>

          <div class="track-scorecard-tab-panels market-regime-tab-panels">
            {regimeTrackOrder.map((track) => {
              const active = track === defaultRegimeTrack;
              const sample = balancedSamples[track];
              const tabId = `balanced-sample-tab-${track}`;
              const panelId = `balanced-sample-panel-${track}`;
              return (
                <div
                  id={panelId}
                  class="track-scorecard-tab-panel market-regime-tab-panel"
                  role="tabpanel"
                  aria-labelledby={tabId}
                  data-market-regime-panel={track}
                  hidden={!active}
                >
                  <div class="balanced-sample-panel">
                <div class="balanced-sample-head">
                  <div>
                    <span class="panel-kicker">{trackLabel(track)} equal sample</span>
                    <h3>{trackLabel(track)} down / flat / up benchmark</h3>
                    <p>{sample.missingSummary}</p>
                  </div>
                  <span class:list={["regime-confidence", sample.status === "Ready" ? "regime-confidence-ready" : "regime-confidence-forming"]}>
                    {statusLabel(sample.status)}
                  </span>
                </div>
                <MarketRegimeLineChart chart={balancedProgressCharts[track]} />

                <div class="balanced-sample-counts" aria-label={`${trackLabel(track)} balanced sample category counts`}>
                  {sample.categories.map((category) => (
                    <article>
                      <span>{category.label}</span>
                      <strong>
                        {category.count}<small>/{BALANCED_SAMPLE_THRESHOLD}</small>
                      </strong>
                      <i
                        class="balanced-sample-progress"
                        style={`--sample-progress: ${Math.min(100, (category.count / BALANCED_SAMPLE_THRESHOLD) * 100)}%;`}
                        aria-hidden="true"
                      ></i>
                      <em>{category.rangeLabel}</em>
                      <p>
                        {sample.status === "Ready"
                          ? `${category.selectedCount} selected for the balanced sample.`
                          : category.missing > 0
                            ? `${category.missing} more needed.`
                            : "Requirement met."}
                      </p>
                    </article>
                  ))}
                </div>

                {sample.status === "Ready" ? (
                  <div class="balanced-sample-ready">
                    <div class="balanced-sample-summary">
                      <span>
                        <strong>{sample.sampleSize}</strong>
                        <em>rounds per category</em>
                      </span>
                      <span>
                        <strong>{sample.selectedRounds.length}</strong>
                        <em>total selected rounds</em>
                      </span>
                    </div>
                    <div class="table-shell regime-table-shell">
                      <table>
                        <thead>
                          <tr>
                            <th>Model</th>
                            <th>Balanced sample score</th>
                            <th>Avg alpha vs S&amp;P</th>
                            <th>Hit rate</th>
                            <th>Tests</th>
                            <th>Status</th>
                          </tr>
                        </thead>
                        <tbody>
                          {sample.leaderboard.map((row, index) => (
                            <tr>
                              <td data-label="Model">
                                <div class="regime-model-cell">
                                  <span>{index + 1}</span>
                                  {row.logoSrc && <img src={row.logoSrc} alt="" loading="lazy" />}
                                  <div>
                                    <strong>{row.label}</strong>
                                    <em>{row.providerName}</em>
                                  </div>
                                </div>
                              </td>
                              <td class="regime-score-value" data-label="Balanced sample score">
                                <strong>{scoreText(row.score)}</strong>
                                <span>Equal down / flat / up sample</span>
                              </td>
                              <td data-label="Avg alpha vs S&P">{signedPctText(row.averageAlpha)}</td>
                              <td data-label="Hit rate">{finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}</td>
                              <td data-label="Tests">
                                {row.testsIncluded}/{row.testsRequired}
                              </td>
                              <td data-label="Status">
                                <span class:list={["regime-status", `regime-status-${statusClass(row.status)}`]}>
                                  {statusLabel(row.status)}
                                </span>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                ) : (
                  <div class="balanced-sample-forming">
                    <strong>Not ranked yet</strong>
                    <p>
                      The {trackLabel(track).toLowerCase()} sample is still forming, so this benchmark is shown as a
                      readiness check rather than a leaderboard.
                    </p>
                  </div>
                )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    </details>

    <details class="regime-advanced-details">
      <summary>
        <span>Audit table</span>
        <strong>Included rounds</strong>
        <em>{auditRows.length} resolved official rounds feed this benchmark.</em>
      </summary>

      <section class="regime-section" aria-labelledby="regime-rounds-title">
        <div class="regime-section-head">
          <span class="panel-kicker">Audit table</span>
          <h2 id="regime-rounds-title">Which rounds are included?</h2>
          <p>Showing the latest 10 resolved official rounds. Open the full audit for every included round.</p>
        </div>

        <div class="table-shell regime-table-shell">
          <table>
            <thead>
              <tr>
                <th>Round</th>
                <th>Track</th>
                <th>Window</th>
                <th>S&amp;P 500 return</th>
                <th>Environment</th>
                <th>Avg model alpha</th>
                <th>Hit rate</th>
                <th>Models</th>
              </tr>
            </thead>
            <tbody>
              {visibleAuditRows.map((row) => (
                <tr>
                  <td data-label="Round">
                    <a href={`/rounds/${row.round.round_id}`}>{row.round.round_id}</a>
                  </td>
                  <td data-label="Track">{trackLabel(row.track)}</td>
                  <td data-label="Window">{dateOnly(row.round.entry_date)} to {dateOnly(row.round.exit_date)}</td>
                  <td data-label="S&P 500 return">{signedPctText(row.sp500Return)}</td>
                  <td data-label="Environment">{row.regime.label}</td>
                  <td data-label="Avg model alpha">{signedPctText(row.averageAlpha)}</td>
                  <td data-label="Hit rate">{finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}</td>
                  <td data-label="Models">{row.modelCount}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {hiddenAuditRows.length > 0 && (
          <details class="regime-audit-details">
            <summary>View full audit table <span>{auditRows.length} rounds</span></summary>
            <div class="table-shell regime-table-shell">
              <table>
                <thead>
                  <tr>
                    <th>Round</th>
                    <th>Track</th>
                    <th>Window</th>
                    <th>S&amp;P 500 return</th>
                    <th>Environment</th>
                    <th>Avg model alpha</th>
                    <th>Hit rate</th>
                    <th>Models</th>
                  </tr>
                </thead>
                <tbody>
                  {hiddenAuditRows.map((row) => (
                    <tr>
                      <td data-label="Round">
                        <a href={`/rounds/${row.round.round_id}`}>{row.round.round_id}</a>
                      </td>
                      <td data-label="Track">{trackLabel(row.track)}</td>
                      <td data-label="Window">{dateOnly(row.round.entry_date)} to {dateOnly(row.round.exit_date)}</td>
                      <td data-label="S&P 500 return">{signedPctText(row.sp500Return)}</td>
                      <td data-label="Environment">{row.regime.label}</td>
                      <td data-label="Avg model alpha">{signedPctText(row.averageAlpha)}</td>
                      <td data-label="Hit rate">{finiteNumber(row.hitRate) ? pct(row.hitRate) : "n/a"}</td>
                      <td data-label="Models">{row.modelCount}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}
      </section>
    </details>

    <script is:inline>
      if (!window.__capitalbenchMarketRegimeTabs) {
        window.__capitalbenchMarketRegimeTabs = true;

        function setupMarketRegimeTabs(root) {
          const tabs = Array.from(root.querySelectorAll("[data-market-regime-tab]"));
          const panels = Array.from(root.querySelectorAll("[data-market-regime-panel]"));

          function selectTrack(track) {
            if (!track) return;
            root.dataset.activeTrack = track;
            tabs.forEach((tab) => {
              const active = tab.dataset.marketRegimeTab === track;
              tab.classList.toggle("is-active", active);
              tab.setAttribute("aria-selected", active ? "true" : "false");
              tab.setAttribute("tabindex", active ? "0" : "-1");
            });

            panels.forEach((panel) => {
              panel.hidden = panel.dataset.marketRegimePanel !== track;
            });
          }

          tabs.forEach((tab, index) => {
            tab.addEventListener("click", () => selectTrack(tab.dataset.marketRegimeTab));
            tab.addEventListener("keydown", (event) => {
              if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
              event.preventDefault();
              const nextIndex =
                event.key === "Home"
                  ? 0
                  : event.key === "End"
                    ? tabs.length - 1
                    : event.key === "ArrowRight"
                      ? (index + 1) % tabs.length
                      : (index - 1 + tabs.length) % tabs.length;
              tabs[nextIndex]?.focus();
              selectTrack(tabs[nextIndex]?.dataset.marketRegimeTab);
            });
          });

          selectTrack(root.dataset.activeTrack || tabs[0]?.dataset.marketRegimeTab);
        }

        function activateMarketRegimeHash() {
          const id = decodeURIComponent(window.location.hash.slice(1));
          if (!id.startsWith("market-environment-insight-")) return;
          const target = document.getElementById(id);
          const panel = target?.closest("[data-market-regime-panel]");
          const root = panel?.closest("[data-market-regime-tabs]");
          const track = panel?.dataset.marketRegimePanel;
          const tab = root?.querySelector(`[data-market-regime-tab="${track}"]`);
          tab?.click();
          window.requestAnimationFrame(() => target?.scrollIntoView({ block: "start" }));
        }

        document.querySelectorAll("[data-market-regime-tabs]").forEach(setupMarketRegimeTabs);
        activateMarketRegimeHash();
        window.addEventListener("hashchange", activateMarketRegimeHash);
      }
    </script>
  </section>
</BaseLayout>
