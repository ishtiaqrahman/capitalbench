---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BenchmarkEvidencePanel from "../../components/BenchmarkEvidencePanel.astro";
import InsightStrip from "../../components/InsightStrip.astro";
import ModelLiveHoldings from "../../components/ModelLiveHoldings";
import ModelPortfolioPattern from "../../components/ModelPortfolioPattern.astro";
import TrackScorecard from "../../components/TrackScorecard.astro";
import apiReadModel from "../../generated/apiReadModel.js";
import { staticAllWeeklyPerformance } from "../../lib/localRoundRecords";
import { benchmarkSetToScorecard, benchmarkSetsForModel } from "../../lib/benchmarkSets";
import { signedBarBorderRadius } from "../../lib/benchmarkBars.js";
import { insightsForModel } from "../../lib/insights.js";
import { siteConfig } from "../../lib/seo";
import type { TrackScorecardData } from "../../lib/trackScorecard";
import { staticModelProfiles, type ModelResultRow, type ModelTrackScore } from "../../lib/modelProfiles";

export function getStaticPaths() {
  return staticModelProfiles().map((profile) => ({
    params: { model_id: profile.modelId },
    props: { profile }
  }));
}

const { profile } = Astro.props;
const repoRoot = `${siteConfig.githubUrl}/tree/main`;
const repoBlob = `${siteConfig.githubUrl}/blob/main`;
const modelInsights = insightsForModel(apiReadModel, {
  modelId: profile.modelId,
  modelName: profile.label,
  limit: 3,
  includeFallback: false
});
const behavior = profile.behavior;
const modelLabelById = new Map(apiReadModel.models.map((model: any) => [model.model_id, model.label]));
const closestPeerLabel = behavior?.peer?.closest_peer?.peer_model_id
  ? modelLabelById.get(behavior.peer.closest_peer.peer_model_id) ?? behavior.peer.closest_peer.peer_model_id
  : null;
const resultRows = [...profile.allResults].sort((a, b) => a.entryDate.localeCompare(b.entryDate));
const maxAlphaPct = Math.max(1, ...resultRows.map((row) => Math.abs((row.alphaVsSp500 ?? 0) * 100)));
const liveMarkRows = latestLiveMarkRows(profile.modelId);
const liveMarkTrackRows = (["weekly", "monthly"] as const).map((track) => {
  const rows = liveMarkRows.filter((row) => row.track === track);
  return {
    track,
    rows,
    averageReturn: averageDecimal(rows.map((row) => row.model_return)),
    averageSp500: averageDecimal(rows.map((row) => row.sp500_return)),
    averageAlpha: averageDecimal(rows.map((row) => row.alpha_vs_sp500))
  };
});
const modelBenchmarkSets = benchmarkSetsForModel(apiReadModel, profile.modelId);
const modelBenchmarkSetCards = modelBenchmarkSets.map((set: any) => ({
  set,
  status: benchmarkSetStatus(set),
  scorecard: benchmarkSetToScorecard(set) as TrackScorecardData | null,
  modelRow: set.model_row ?? null
}));
const modelBenchmarkFilters = [
  { key: "all", label: "All", count: modelBenchmarkSetCards.length },
  { key: "weekly", label: "Weekly", count: modelBenchmarkSetCards.filter((item: any) => item.set.track === "weekly").length },
  { key: "monthly", label: "Monthly", count: modelBenchmarkSetCards.filter((item: any) => item.set.track === "monthly").length },
  {
    key: "active",
    label: "Current/Qualified",
    count: modelBenchmarkSetCards.filter((item: any) => item.set.is_current || item.set.is_qualified).length
  }
];

function pctDecimal(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  const scaled = value * 100;
  return `${scaled > 0 ? "+" : ""}${scaled.toFixed(2)}%`;
}

function ppDecimal(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  const scaled = value * 100;
  return `${scaled > 0 ? "+" : ""}${scaled.toFixed(2)} pp`;
}

function pctValue(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  if (Math.abs(value) >= 10) return `${value.toFixed(1)}%`;
  if (Math.abs(value) >= 1) return `${value.toFixed(1)}%`;
  return `${value.toFixed(2)}%`;
}

function numberValue(value: number | null | undefined, digits = 1): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  return value.toFixed(digits);
}

function plural(count: number, singular: string, pluralLabel = `${singular}s`): string {
  return `${count} ${count === 1 ? singular : pluralLabel}`;
}

function averageDecimal(values: number[]): number | null {
  const finite = values.filter((value) => Number.isFinite(value));
  return finite.length ? finite.reduce((total, value) => total + value, 0) / finite.length : null;
}

function latestLiveMarkRows(modelId: string) {
  const rows = staticAllWeeklyPerformance().filter(
    (row) =>
      row.model_id === modelId &&
      row.status === "pending" &&
      row.published !== false &&
      row.days_elapsed > 0 &&
      row.target_date > row.entry_date &&
      row.target_date < row.exit_date
  );
  const latestByRound = new Map<string, (typeof rows)[number]>();
  for (const row of rows) {
    const key = `${row.round_id}:${row.run_id}:${row.model_id}`;
    const existing = latestByRound.get(key);
    if (!existing || row.target_date > existing.target_date || (row.target_date === existing.target_date && row.price_date > existing.price_date)) {
      latestByRound.set(key, row);
    }
  }
  return Array.from(latestByRound.values()).sort((a, b) => b.exit_date.localeCompare(a.exit_date) || b.round_id.localeCompare(a.round_id));
}

function scorecardLabel(scorecard: ModelTrackScore): string {
  if (scorecard.completedTests === 0) return "No completed rounds";
  return `${scorecard.wins} wins / ${scorecard.completedTests} completed`;
}

function benchmarkSetStatus(set: any): string {
  if (set.is_current) return "Current";
  if (set.is_qualified) return "Qualified";
  if (set.comparison.comparison_round_count > 0) return "Forming";
  return "Waiting";
}

function benchmarkSetTitle(set: any): string {
  return String(set.label).replace(/^(Weekly|Monthly) Set:\s*/, "");
}

function benchmarkSetTrackLabel(track: string): string {
  return track === "weekly" ? "Weekly" : "Monthly";
}

function modelSetRankLabel(row: any): string {
  return row?.rank ? `#${row.rank}` : "n/a";
}

function modelSetScoreLabel(row: any): string {
  return typeof row?.capitalbench_score === "number" && Number.isFinite(row.capitalbench_score)
    ? row.capitalbench_score.toFixed(1)
    : "n/a";
}

function modelSetReturnLabel(row: any): string {
  return typeof row?.total_portfolio_return_pct === "number" && Number.isFinite(row.total_portfolio_return_pct)
    ? pctValue(row.total_portfolio_return_pct)
    : "n/a";
}

function alphaBarStyle(row: ModelResultRow): string {
  const alphaPct = (row.alphaVsSp500 ?? 0) * 100;
  const width = Math.min(50, (Math.abs(alphaPct) / maxAlphaPct) * 50);
  const left = alphaPct >= 0 ? 50 : 50 - width;
  return `left: ${left}%; width: ${width}%; border-radius: ${signedBarBorderRadius(alphaPct, "horizontal")};`;
}
---

<BaseLayout
  title={`${profile.label} AI Portfolio Profile`}
  description={`${profile.label} live holdings, weekly and monthly CapitalBench results, allocation patterns, and public audit packets.`}
>
  <section class={`model-profile-hero model-profile-${profile.provider}`} aria-labelledby="model-title">
    <div class="model-profile-identity">
      <span class="panel-kicker">{profile.providerLabel}</span>
      <div class="model-profile-name-row">
        <span class="model-logo-shell large">
          {profile.logoSrc && <img src={profile.logoSrc} alt={profile.providerLabel} loading="lazy" />}
        </span>
        <h1 id="model-title">{profile.label}</h1>
      </div>
      <p class="mono">{profile.modelId}</p>
      {profile.lifecycleStatus === "retired" && (
        <p class="model-retirement-note">
          Retired from new benchmark rounds. Historical portfolios and scores remain part of the public record.
        </p>
      )}
      {behavior && (
        <a class="model-hero-pattern" href="#model-fingerprint">
          <span>Portfolio pattern</span>
          <strong>{behavior.archetype.label}</strong>
          <em>{behavior.archetype.description}</em>
        </a>
      )}
      <div class="round-meta-row compact">
        <span class:list={[
          "model-live-indicator",
          profile.lifecycleStatus === "retired" ? "is-retired" : profile.live.all.portfolioCount > 0 ? "is-live" : "is-idle"
        ]}>
          <i aria-hidden="true"></i>
          {profile.lifecycleStatus === "retired" ? "Retired from new rounds" : profile.live.all.portfolioCount > 0 ? "Live portfolios" : "No live portfolios"}
        </span>
        {profile.tracksEntered.map((track) => <span>{track === "weekly" ? "Weekly" : "Monthly"}</span>)}
        {profile.firstDecisionDate && <span>First run {profile.firstDecisionDate}</span>}
      </div>
    </div>

    <div class="model-profile-stats" aria-label={`${profile.label} headline statistics`}>
      <div>
        <span>Live portfolios</span>
        <strong>{profile.live.all.portfolioCount}</strong>
        <small>{plural(profile.live.all.roundCount, "open round")}</small>
      </div>
      <div>
        <span>Completed rounds</span>
        <strong>{profile.allResults.length}</strong>
        <small>scored rounds</small>
      </div>
      <div>
        <span>Beat S&amp;P 500</span>
        <strong>
          {profile.allResults.length > 0
            ? pctValue((profile.allResults.filter((row) => (row.alphaVsSp500 ?? 0) > 0).length / profile.allResults.length) * 100)
            : "n/a"}
        </strong>
        <small>all completed tracks</small>
      </div>
      <div>
        <span>Portfolio Minus S&amp;P 500</span>
        <strong>
          {profile.allResults.length > 0
            ? ppDecimal(profile.allResults.reduce((total, row) => total + (row.alphaVsSp500 ?? 0), 0) / profile.allResults.length)
            : "n/a"}
        </strong>
        <small>completed average</small>
      </div>
    </div>
  </section>

  <nav class="model-page-nav" aria-label={`${profile.label} profile sections`}>
    <a href="#model-fingerprint">Portfolio pattern</a>
    <a href="#live-holdings">Current holdings</a>
    <a href="#model-results">Results</a>
    {modelInsights.length > 0 && <a href="#model-insights">Insights</a>}
    <a href="#model-history">Round history</a>
  </nav>

  <ModelPortfolioPattern profile={profile} closestPeerLabel={closestPeerLabel} />

  <section class="section model-section" id="live-holdings" aria-labelledby="live-holdings-title">
    <div class="model-section-heading">
      <div>
        <span class="panel-kicker">Current portfolios</span>
        <h2 id="live-holdings-title">What Is This Model Holding Now?</h2>
      </div>
      <p>
        {plural(profile.live.all.portfolioCount, "open portfolio")} across weekly and monthly tests. Completed rounds are excluded.
      </p>
    </div>
    <ModelLiveHoldings client:visible scopes={profile.live} />
  </section>

  <section class="section model-section" id="live-performance" aria-labelledby="live-performance-title">
    <div class="model-section-heading">
      <div>
        <span class="panel-kicker">Still in progress</span>
        <h2 id="live-performance-title">How Are Its Open Portfolios Doing?</h2>
      </div>
      <p>Latest available close for live rounds only. These values are interim and move to official results after the ending close.</p>
    </div>

    {liveMarkRows.length > 0 ? (
      <div class="model-live-performance-card">
        <div class="model-live-performance-summary" aria-label={`${profile.label} live mark-to-market summary`}>
          {liveMarkTrackRows.map((item) => (
            <div>
              <span>{item.track === "weekly" ? "Weekly live" : "Monthly live"}</span>
              <dl>
                <div>
                  <dt>Portfolio</dt>
                  <dd>{pctDecimal(item.averageReturn)}</dd>
                </div>
                <div>
                  <dt>S&amp;P 500</dt>
                  <dd>{pctDecimal(item.averageSp500)}</dd>
                </div>
                <div>
                  <dt>Portfolio Minus S&amp;P 500</dt>
                  <dd>{ppDecimal(item.averageAlpha)}</dd>
                </div>
              </dl>
              <small>{item.rows.length} open {item.rows.length === 1 ? "test" : "tests"}</small>
            </div>
          ))}
        </div>
        <details class="model-live-round-details">
          <summary>See all {liveMarkRows.length} open round returns</summary>
          <div class="model-live-performance-list" aria-label={`${profile.label} live round returns`}>
            {liveMarkRows.map((row) => (
              <a href={`/rounds/${row.round_id}/#performance`}>
                <span>
                  <strong>{row.round_id}</strong>
                  <small>{row.track} / close {row.price_date}</small>
                </span>
                <span>
                  <em>Portfolio</em>
                  <b>{pctDecimal(row.model_return)}</b>
                </span>
                <span>
                  <em>S&amp;P 500</em>
                  <b>{pctDecimal(row.sp500_return)}</b>
                </span>
                <span>
                  <em>Portfolio Minus S&amp;P 500</em>
                  <b>{ppDecimal(row.alpha_vs_sp500)}</b>
                </span>
              </a>
            ))}
          </div>
        </details>
      </div>
    ) : (
      <div class="model-empty-panel">
        <strong>No live price snapshot yet.</strong>
        <span>Live returns appear after a market close inside one of this model's open test windows.</span>
      </div>
    )}
  </section>

  <section class="section model-scorecards" id="model-results" aria-labelledby="model-scorecards-title">
    <div class="model-section-heading">
      <div>
        <span class="panel-kicker">Completed results</span>
        <h2 id="model-scorecards-title">How Has This Model Performed?</h2>
      </div>
      <p>Weekly and monthly results stay separate because the holding periods are different.</p>
    </div>
    {(["weekly", "monthly"] as const).map((track) => {
      const card = profile.scorecards[track];
      return (
        <article class={`model-scorecard scorecard-${track}`}>
          <div>
            <span class="metric-label">{track === "weekly" ? "Weekly record" : "Monthly record"}</span>
            <h3>{scorecardLabel(card)}</h3>
          </div>
          <div class="model-scorecard-grid">
            <div>
              <span>Avg return</span>
              <strong>{pctDecimal(card.averageReturn)}</strong>
            </div>
            <div>
              <span>S&amp;P 500</span>
              <strong>{pctDecimal(card.averageSp500Return)}</strong>
            </div>
            <div>
              <span>Avg Portfolio Minus S&amp;P 500</span>
              <strong>{ppDecimal(card.averageAlpha)}</strong>
            </div>
            <div>
              <span>Hit rate</span>
              <strong>{card.hitRate === null ? "n/a" : pctValue(card.hitRate * 100)}</strong>
            </div>
            <div>
              <span>Avg rank</span>
              <strong>{numberValue(card.averageRank)}</strong>
            </div>
            <div>
              <span>Best round</span>
              <strong>{card.bestRound?.roundId ?? "n/a"}</strong>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <section class="section model-performance-panel" aria-labelledby="model-performance-title">
    <div class="model-section-heading">
      <div>
        <span class="panel-kicker">Round by round</span>
        <h2 id="model-performance-title">When Did It Beat The S&amp;P 500?</h2>
      </div>
      <p>Bars to the right beat the S&amp;P 500. Bars to the left trailed it.</p>
    </div>

    {resultRows.length > 0 ? (
      <div class="model-alpha-chart" aria-label={`${profile.label} portfolio minus S&P 500 by round`}>
        {resultRows.map((row) => (
          <a class="model-alpha-row" href={`/rounds/${row.roundId}/`}>
            <span><strong>{row.roundId}</strong><small>{row.track} / rank {row.modelRank} of {row.modelCount}</small></span>
            <em class="model-alpha-track" aria-hidden="true">
              <i class={row.alphaVsSp500 && row.alphaVsSp500 >= 0 ? "is-positive" : "is-negative"} style={alphaBarStyle(row)} />
            </em>
            <b>{ppDecimal(row.alphaVsSp500)}</b>
          </a>
        ))}
      </div>
    ) : (
      <div class="model-empty-panel"><strong>No completed score yet.</strong><span>This chart appears after at least one test has ending prices.</span></div>
    )}
  </section>

  {modelBenchmarkSetCards.length > 0 && (
    <section class="section model-benchmark-sets" id="benchmark-sets" aria-labelledby="model-benchmark-sets-title" data-model-benchmark-sets>
      <div class="model-section-heading">
        <div>
          <span class="panel-kicker">Ranking context</span>
          <h2 id="model-benchmark-sets-title">Where Does It Rank Against Comparable Models?</h2>
        </div>
        <p>Each group uses only rounds completed by every included model.</p>
      </div>

      <details class="model-benchmark-details">
        <summary>
          <span>See every comparison group</span>
          <strong>{modelBenchmarkSetCards.length}</strong>
        </summary>
        <div class="model-benchmark-set-shell">
        <div class="model-benchmark-set-controls">
          <div class="model-benchmark-set-filters" aria-label="Filter benchmark sets for this model">
            {modelBenchmarkFilters.map((filter) => (
              <button
                class:list={["model-benchmark-filter", filter.key === "all" && "is-active"]}
                type="button"
                data-model-set-filter={filter.key}
                aria-pressed={filter.key === "all" ? "true" : "false"}
                disabled={filter.count === 0}
              >
                <span>{filter.label}</span>
                <strong>{filter.count}</strong>
              </button>
            ))}
          </div>

          <div class="model-benchmark-set-tabs" role="tablist" aria-label={`${profile.label} benchmark sets`}>
            {modelBenchmarkSetCards.map((item: any, index: number) => (
              <button
                id={`model-set-tab-${item.set.set_id}`}
                class:list={["model-benchmark-set-tab", index === 0 && "is-active"]}
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`model-set-panel-${item.set.set_id}`}
                tabindex={index === 0 ? "0" : "-1"}
                data-model-set-tab={item.set.set_id}
                data-track={item.set.track}
                data-status={item.set.status}
              >
                <span>{benchmarkSetTrackLabel(item.set.track)} · {item.status}</span>
                <strong>{benchmarkSetTitle(item.set)}</strong>
                <em>{item.set.comparison.comparison_round_count} shared {item.set.comparison.comparison_round_count === 1 ? "round" : "rounds"}</em>
              </button>
            ))}
          </div>
        </div>

        <div class="model-benchmark-set-panels">
          {modelBenchmarkSetCards.map((item: any, index: number) => (
            <article
              id={`model-set-panel-${item.set.set_id}`}
              class="model-benchmark-set-panel"
              role="tabpanel"
              aria-labelledby={`model-set-tab-${item.set.set_id}`}
              data-model-set-panel={item.set.set_id}
              data-track={item.set.track}
              data-status={item.set.status}
              hidden={index !== 0}
            >
              <div class="model-benchmark-set-panel-head">
                <div>
                  <span class={`model-benchmark-status model-benchmark-status-${item.set.status}`}>
                    {benchmarkSetTrackLabel(item.set.track)} · {item.status}
                  </span>
                  <h3>{benchmarkSetTitle(item.set)} roster</h3>
                  <p>{item.set.description}</p>
                </div>
                <a class="small-button" href={`/leaderboards/benchmark-sets/${item.set.set_id}/`}>Open full set</a>
              </div>

              <BenchmarkEvidencePanel
                evidence={apiReadModel.benchmark_evidence}
                track={item.set.track}
                benchmarkSet={item.set}
                compact
                title="Evidence Behind This Comparison"
              />

              <div class="model-benchmark-set-metrics" aria-label={`${profile.label} ${item.set.label} metrics`}>
                <span>
                  <strong>{modelSetRankLabel(item.modelRow)}</strong>
                  <em>Rank in set</em>
                </span>
                <span>
                  <strong>{modelSetScoreLabel(item.modelRow)}</strong>
                  <em>CapitalBench Score</em>
                </span>
                <span>
                  <strong>{modelSetReturnLabel(item.modelRow)}</strong>
                  <em>Total return</em>
                </span>
                <span>
                  <strong>{item.set.comparison.comparison_round_count}</strong>
                  <em>Shared rounds</em>
                </span>
              </div>

              {item.scorecard ? (
                <TrackScorecard scorecard={item.scorecard} compact focusModelId={profile.modelId} />
              ) : (
                <div class="model-benchmark-empty">
                  <strong>This set is waiting for its first shared resolved round.</strong>
                  <span>
                    The chart appears after every model in the {item.set.models.length}-model roster has an official result in the same {benchmarkSetTrackLabel(item.set.track).toLowerCase()} round.
                  </span>
                </div>
              )}
            </article>
          ))}
        </div>
        </div>

      <script is:inline>
        if (!window.__capitalbenchModelBenchmarkSets) {
          window.__capitalbenchModelBenchmarkSets = true;

          function setupModelBenchmarkSets(root) {
            const filters = Array.from(root.querySelectorAll("[data-model-set-filter]"));
            const tabs = Array.from(root.querySelectorAll("[data-model-set-tab]"));
            const panels = Array.from(root.querySelectorAll("[data-model-set-panel]"));

            function matchesFilter(element, filter) {
              if (filter === "all") return true;
              if (filter === "weekly" || filter === "monthly") return element.dataset.track === filter;
              if (filter === "active") return element.dataset.status === "current" || element.dataset.status === "qualified";
              return true;
            }

            function selectSet(setId) {
              if (!setId) return;
              tabs.forEach((tab) => {
                const active = tab.dataset.modelSetTab === setId;
                tab.classList.toggle("is-active", active);
                tab.setAttribute("aria-selected", active ? "true" : "false");
                tab.setAttribute("tabindex", active ? "0" : "-1");
              });
              panels.forEach((panel) => {
                panel.hidden = panel.dataset.modelSetPanel !== setId;
              });
            }

            function applyFilter(filter) {
              let firstVisibleTab = null;
              filters.forEach((button) => {
                const active = button.dataset.modelSetFilter === filter;
                button.classList.toggle("is-active", active);
                button.setAttribute("aria-pressed", active ? "true" : "false");
              });
              tabs.forEach((tab) => {
                const visible = matchesFilter(tab, filter);
                tab.hidden = !visible;
                if (visible && !firstVisibleTab) firstVisibleTab = tab;
              });
              panels.forEach((panel) => {
                panel.dataset.filterHidden = matchesFilter(panel, filter) ? "false" : "true";
              });
              const activeTab = tabs.find((tab) => tab.classList.contains("is-active") && !tab.hidden);
              selectSet(activeTab?.dataset.modelSetTab || firstVisibleTab?.dataset.modelSetTab);
            }

            tabs.forEach((tab) => {
              tab.addEventListener("click", () => selectSet(tab.dataset.modelSetTab));
              tab.addEventListener("keydown", (event) => {
                if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
                event.preventDefault();
                const visibleTabs = tabs.filter((item) => !item.hidden);
                const currentIndex = visibleTabs.indexOf(tab);
                const nextIndex =
                  event.key === "Home"
                    ? 0
                    : event.key === "End"
                      ? visibleTabs.length - 1
                      : event.key === "ArrowRight"
                        ? (currentIndex + 1) % visibleTabs.length
                        : (currentIndex - 1 + visibleTabs.length) % visibleTabs.length;
                visibleTabs[nextIndex]?.focus();
                selectSet(visibleTabs[nextIndex]?.dataset.modelSetTab);
              });
            });

            filters.forEach((button) => {
              button.addEventListener("click", () => applyFilter(button.dataset.modelSetFilter || "all"));
            });
          }

          document.querySelectorAll("[data-model-benchmark-sets]").forEach(setupModelBenchmarkSets);
        }
        </script>
      </details>
    </section>
  )}

  {modelInsights.length > 0 && (
    <InsightStrip
      id="model-insights"
      kicker="Model-specific findings"
      title={`What Has CapitalBench Learned About ${profile.label}?`}
      description="Findings tied directly to this model's decisions or completed results."
      insights={modelInsights}
      viewAllHref="/insights"
      viewAllLabel="All insights"
    />
  )}

  <section class="section model-history" id="model-history" aria-labelledby="model-history-title" data-model-history>
    <div class="model-section-heading">
      <div>
        <span class="panel-kicker">Decision history</span>
        <h2 id="model-history-title">What Did It Choose In Each Round?</h2>
      </div>
      <p>Open a row to see the full portfolio, rationale, and audit files.</p>
    </div>

    <div class="model-history-table" role="table" aria-label={`${profile.label} round history`}>
      <div class="model-history-head" role="row">
        <span>Round</span>
        <span>Track</span>
        <span>Window</span>
        <span>Portfolio</span>
        <span>Result</span>
      </div>
      {profile.history.map((row, index) => (
        <details class="model-history-row" data-model-history-row hidden={index >= 10}>
          <summary>
            <span>
              <strong><a href={`/rounds/${row.roundId}/`}>{row.roundId}</a></strong>
              <small>{row.runId}</small>
            </span>
            <span>{row.track}</span>
            <span>{row.entryDate} to {row.exitDate}</span>
            <span class="model-history-holdings">
              {row.portfolioSummary.map((holding) => (
                <em><i class={holding.themeClass}></i>{holding.optionId} {pctValue(holding.allocationPct)}</em>
              ))}
            </span>
            <span>
              {row.result ? (
                <strong>{ppDecimal(row.result.alphaVsSp500)}</strong>
              ) : (
                <em>{row.status === "pending" ? "Pending" : "Not scored"}</em>
              )}
            </span>
          </summary>
          <div class="model-history-detail">
            <div>
              <span class="metric-label">Full portfolio</span>
              <div class="allocation-chip-row compact">
                {row.portfolioSummary.map((holding) => (
                  <span class="allocation-chip">
                    <i class={holding.themeClass}></i>
                    {holding.label} {pctValue(holding.allocationPct)}
                  </span>
                ))}
              </div>
            </div>
            <div>
              <span class="metric-label">Rationale</span>
              <p>{row.rationale || "No rationale text available."}</p>
            </div>
            <div>
              <span class="metric-label">Audit packets</span>
              <div class="model-proof-links">
                <a href={`${repoBlob}/${row.parsedPath}`} target="_blank" rel="noreferrer">Parsed submission</a>
                <a href={`${repoBlob}/${row.rawPath}`} target="_blank" rel="noreferrer">Raw submission</a>
                <a href={`${repoRoot}/rounds/${row.roundId}`} target="_blank" rel="noreferrer">Round files</a>
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
    {profile.history.length > 10 && (
      <button class="model-history-toggle" type="button" data-model-history-toggle data-total={profile.history.length}>
        Show all {profile.history.length} rounds
      </button>
    )}

    <script is:inline>
      document.querySelectorAll("[data-model-history]").forEach((root) => {
        const rows = Array.from(root.querySelectorAll("[data-model-history-row]"));
        const button = root.querySelector("[data-model-history-toggle]");
        if (!button) return;
        let expanded = false;
        button.addEventListener("click", () => {
          expanded = !expanded;
          rows.forEach((row, index) => { row.hidden = !expanded && index >= 10; });
          button.textContent = expanded ? "Show latest 10 rounds" : `Show all ${button.dataset.total} rounds`;
        });
      });
    </script>
  </section>

  <section class="section model-proof-drawer" aria-labelledby="model-proof-title">
    <details>
      <summary>
        <span>
          <span class="panel-kicker">Audit and data</span>
          <strong id="model-proof-title">Public Audit Packets For This Model</strong>
        </span>
      </summary>
      <div class="model-proof-grid">
        {profile.history.slice(0, 10).map((row) => (
          <div>
            <strong>{row.roundId}</strong>
            <a href={`${repoBlob}/${row.parsedPath}`} target="_blank" rel="noreferrer">Parsed JSON</a>
            <a href={`${repoBlob}/${row.rawPath}`} target="_blank" rel="noreferrer">Raw response</a>
            <a href={`/rounds/${row.roundId}/`}>Round page</a>
          </div>
        ))}
      </div>
    </details>
  </section>
</BaseLayout>
