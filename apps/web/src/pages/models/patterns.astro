---
import BaseLayout from "../../layouts/BaseLayout.astro";
import apiReadModel from "../../generated/apiReadModel.js";
import { providerLogoSrc } from "../../lib/scoreReturnChart";

type PatternRow = {
  model_id: string;
  label: string;
  provider: string;
  provider_label: string;
  lifecycle_status: string;
  archetype: { label: string; description: string; confidence?: string };
  sample_status: string;
  sample_caveat?: string | null;
  sample: Record<string, number | string | null>;
  behavior_summary: string;
  traits: Array<{ key: string; label: string; evidence: string; metric_keys: string[] }>;
  pills: Array<{ key: string; role: string; label: string; evidence: string; tone?: string; scope?: string }>;
  decision_process?: Record<string, number | null>;
  recent_winner?: any;
  key_numbers: Record<string, number | null>;
  top_assets: Array<{ display: string; average_allocation_pct?: number; frequency_pct?: number }>;
  closest_peer?: { label?: string; similarity_pct?: number | null } | null;
};

type PatternFinding = {
  key: string;
  title: string;
  body: string;
  model_ids: string[];
  supported_metric_keys: string[];
};

const modelBehavior: any = apiReadModel.model_behavior ?? {};
const report = modelBehavior.pattern_report ?? {
  rows: [],
  comparative_findings: [],
  summary: {},
  metric_definitions: [],
  sample_rules: {},
  generated_at: modelBehavior.generated_at,
  data_as_of: modelBehavior.data_as_of,
  llm_provenance: null
};
const rows = (Array.isArray(report.rows) ? report.rows : []) as PatternRow[];
const findings = (Array.isArray(report.comparative_findings) ? report.comparative_findings : []) as PatternFinding[];
const metricDefinitions = Array.isArray(report.metric_definitions) ? report.metric_definitions : [];
const behaviorMethod = report.methodology ?? modelBehavior.methodology ?? { rules: {}, dimensions: [], included_evidence: [], headline_exclusions: [] };
const signalFloors = Array.isArray(behaviorMethod.dimensions) ? behaviorMethod.dimensions : [];
const rowById = new Map(rows.map((row) => [row.model_id, row]));
const leaderCards = [
  ["Most risk-seeking", report.summary?.highest_risk_model_id, "Highest average risk-taking score"],
  ["Most concentrated", report.summary?.most_concentrated_model_id, "Highest concentration across saved portfolios"],
  ["Most defensive", report.summary?.most_defensive_model_id, "Largest defensive allocation"],
  ["Lowest turnover", report.summary?.lowest_turnover_model_id, "Smallest average portfolio turnover"],
  ["Closest to peers", report.summary?.most_consensus_aligned_model_id, "Highest average peer overlap"],
  ["Most distinctive", report.summary?.most_distinctive_model_id, "Lowest average peer overlap"]
]
  .map(([label, modelId, description]) => {
    const row = rowById.get(String(modelId ?? ""));
    return row ? { label, description, row } : null;
  })
  .filter(Boolean) as Array<{ label: string; description: string; row: PatternRow }>;

const recentWinnerTracks = ["combined", "monthly", "weekly"].map((track) => ({
  track,
  label: track === "combined" ? "Combined" : track === "monthly" ? "Monthly" : "Weekly",
  rows: rows
    .filter((row) => row.lifecycle_status !== "retired")
    .map((row) => ({
      row,
      summary:
        track === "combined"
          ? row.recent_winner?.current_methodology?.combined
          : row.recent_winner?.current_methodology?.tracks?.[track]
    }))
    .filter((item) => typeof item.summary?.average_tilt_score === "number")
    .sort((left, right) => right.summary.average_tilt_score - left.summary.average_tilt_score || left.row.label.localeCompare(right.row.label))
}));

const keyMetricColumns = [
  ["risk_taking_score", "Risk"],
  ["average_holding_count", "Holdings"],
  ["average_top_allocation_pct", "Top holding"],
  ["high_risk_pct", "High risk"],
  ["defensive_pct", "Defensive"],
  ["peer_similarity", "Peer overlap"],
  ["average_turnover_pct", "Turnover"]
];

function dateLabel(value: string | null | undefined) {
  if (!value) return "n/a";
  const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(value));
  if (!match) return String(value);
  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(
    new Date(`${match[1]}-${match[2]}-${match[3]}T00:00:00Z`)
  );
}

function dateTimeLabel(value: string | null | undefined) {
  if (!value) return "n/a";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return String(value);
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZone: "UTC",
    timeZoneName: "short"
  }).format(date);
}

function numberLabel(value: number | null | undefined, digits = 1) {
  if (typeof value !== "number" || !Number.isFinite(value)) return "n/a";
  return value.toFixed(digits);
}

function pctLabel(value: number | null | undefined, digits = 1) {
  if (typeof value !== "number" || !Number.isFinite(value)) return "n/a";
  return `${value.toFixed(digits)}%`;
}

function signedPoints(value: number | null | undefined) {
  if (typeof value !== "number" || !Number.isFinite(value)) return "n/a";
  return `${value > 0 ? "+" : ""}${value.toFixed(1)} vs peers`;
}

function scorePosition(value: number | null | undefined) {
  if (typeof value !== "number" || !Number.isFinite(value)) return "50%";
  return `${Math.min(100, Math.max(0, value)).toFixed(2)}%`;
}

function materialityFloorLabel(dimension: any) {
  const value = Number(dimension?.materiality_floor);
  if (!Number.isFinite(value)) return "n/a";
  if (dimension.unit === "score_100") return `${value} score points`;
  if (dimension.unit === "holdings") return `${value} holdings`;
  return `${value} percentage points`;
}

function metricValue(row: PatternRow, key: string) {
  const value = row.key_numbers?.[key];
  switch (key) {
    case "risk_taking_score":
      return `${numberLabel(value, 1)} / 100`;
    case "average_holding_count":
      return numberLabel(value, 2);
    case "average_rank":
      return numberLabel(value, 2);
    case "peer_similarity":
      return pctLabel(typeof value === "number" ? value * 100 : null, 1);
    case "first_last":
      return `${row.key_numbers?.first_place_count ?? 0} / ${row.key_numbers?.last_place_count ?? 0}`;
    case "beat_sp500_rate_pct":
      return `${row.key_numbers?.beat_sp500_count ?? 0}/${row.key_numbers?.resolved_round_count ?? 0}`;
    default:
      return pctLabel(value, 1);
  }
}

function modelList(ids: string[]) {
  return ids.map((id) => rowById.get(id)?.label).filter(Boolean).join(", ");
}

function rowLogoSrc(row: PatternRow) {
  return providerLogoSrc(row.provider);
}
---

<BaseLayout
  title="AI Model Behavior Patterns"
  description="Compare AI models by risk appetite, concentration, defensive ballast, overlap, turnover, and resolved performance profile."
>
  <section class="pattern-hero" aria-labelledby="pattern-title">
    <div class="pattern-hero-copy">
      <span class="panel-kicker">Model behavior patterns</span>
      <h1 id="pattern-title">How The AI Allocators Differ</h1>
      <p>
        A peer-normalized comparison of each model's typical allocation style across eligible official frozen portfolios,
        with current open positioning shown separately from historical behavior.
      </p>
    </div>
    <aside class="pattern-freshness" aria-label="Pattern report freshness">
      <div>
        <span>Data through</span>
        <strong>{dateLabel(report.data_as_of)}</strong>
      </div>
      <div>
        <span>Saved portfolios</span>
        <strong>{report.summary?.portfolio_count ?? rows.reduce((total, row) => total + Number(row.sample?.portfolio_count ?? 0), 0)}</strong>
      </div>
      <div>
        <span>Resolved results</span>
        <strong>{report.summary?.resolved_result_count ?? 0}</strong>
      </div>
      <div>
        <span>Generated</span>
        <strong>{dateTimeLabel(report.generated_at)}</strong>
      </div>
    </aside>
  </section>

  <section class="pattern-leaders" aria-label="Model behavior leaders">
    {leaderCards.map((card) => (
      <a href={`/models/${card.row.model_id}/#model-behavior`}>
        <span>{card.label}</span>
        <strong>{card.row.label}</strong>
        <small>{card.description}</small>
      </a>
    ))}
  </section>

  <section class="section pattern-section recent-winner-section" aria-labelledby="recent-winner-title" data-recent-winner-benchmark>
    <div class="home-section-heading recent-winner-heading">
      <span class="panel-kicker">Recent-winner tilt</span>
      <h2 id="recent-winner-title">Which Models Follow Recent Winners?</h2>
      <p>
        Higher scores mean the model placed more weight on assets that had already outperformed before its portfolio was frozen.
        The score measures behavior, not whether that decision was correct.
      </p>
    </div>

    <div class="recent-winner-tabs" role="tablist" aria-label="Recent-winner tilt time horizon">
      {recentWinnerTracks.map((item, index) => (
        <button
          type="button"
          role="tab"
          class:list={{ "is-active": index === 0 }}
          aria-selected={index === 0 ? "true" : "false"}
          data-recent-winner-tab={item.track}
        >
          {item.label}
        </button>
      ))}
    </div>

    {recentWinnerTracks.map((item, index) => (
      <div
        class:list={["recent-winner-panel", { "is-active": index === 0 }]}
        data-recent-winner-panel={item.track}
        hidden={index !== 0}
      >
        <div class="recent-winner-axis" aria-hidden="true">
          <span>Recent laggards</span>
          <span>Neutral</span>
          <span>Recent winners</span>
        </div>
        <div class="recent-winner-list">
          {item.rows.map(({ row, summary }) => {
            const logo = rowLogoSrc(row);
            return (
              <article class="recent-winner-row">
                <a class="recent-winner-model" href={`/models/${row.model_id}/#model-behavior`}>
                  <span>{logo ? <img src={logo} alt="" loading="lazy" /> : row.provider_label.slice(0, 1)}</span>
                  <strong>{row.label}</strong>
                </a>
                <div class="recent-winner-scale" style={`--recent-winner-position: ${scorePosition(summary.average_tilt_score)};`}>
                  <span class="recent-winner-midline" aria-hidden="true"></span>
                  <span class="recent-winner-marker" aria-hidden="true"></span>
                </div>
                <div class="recent-winner-score">
                  <strong>{numberLabel(summary.average_tilt_score, 1)}</strong>
                  <span>/ 100</span>
                </div>
                <div class="recent-winner-context">
                  <span>{signedPoints(summary.median_peer_delta_points)}</span>
                  <span>{pctLabel(summary.average_top_quintile_allocation_pct, 0)} in top 20%</span>
                  <span>{summary.observation_count} portfolios</span>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    ))}
    <p class="recent-winner-note">
      Combined gives monthly and weekly behavior equal weight. Monthly uses the prior 21 trading sessions; weekly uses
      the prior 5. S&amp;P 500 and cash receive the neutral score of 50.
    </p>
  </section>

  <section class="section pattern-section" aria-labelledby="comparison-title">
    <div class="home-section-heading home-section-heading-with-action">
      <div>
        <span class="panel-kicker">Comparison matrix</span>
        <h2 id="comparison-title">Distinct Behavior By Model</h2>
        <p>
          Every label, sentence, and pill comes from the same deterministic evidence record. Realized investment results
          are deliberately excluded from allocation-style classification.
        </p>
      </div>
      <a class="section-profile-link" href="#methodology">Calculation method</a>
    </div>

    <div class="pattern-matrix" role="table" aria-label="Model behavior comparison">
      <div class="pattern-matrix-head" role="row">
        <span role="columnheader">Model</span>
        <span role="columnheader">Distinct behavior</span>
        <span role="columnheader">Evidence</span>
        <span role="columnheader">Common exposures</span>
      </div>
      {rows.map((row) => (
        <article class="pattern-matrix-row" role="row">
          <div class="pattern-model-cell" role="cell">
            <span class="pattern-model-logo" aria-hidden="true">
              {rowLogoSrc(row) ? <img src={rowLogoSrc(row)} alt="" loading="lazy" /> : row.provider_label.slice(0, 1)}
            </span>
            <span class="pattern-model-copy">
              <a href={`/models/${row.model_id}/#model-behavior`}>{row.label}</a>
              <span>{row.provider_label}</span>
              <small>{row.sample_status}</small>
            </span>
          </div>
          <div class="pattern-summary-cell" role="cell">
            <strong>{row.archetype?.label}</strong>
            <p>{row.behavior_summary}</p>
            {row.sample_caveat && <em>{row.sample_caveat}</em>}
          </div>
          <div class="pattern-evidence-cell" role="cell">
            {(row.pills ?? []).slice(0, 4).map((pill) => (
              <span title={pill.evidence}>{pill.label}</span>
            ))}
            {typeof row.recent_winner?.current_methodology?.average_tilt_score === "number" && (
              <span
                class="is-recent-winner"
                title="Allocation-weighted percentile of pre-decision recent returns under the current methodology."
              >
                Recent winners {numberLabel(row.recent_winner.current_methodology.average_tilt_score, 0)}
              </span>
            )}
          </div>
          <div class="pattern-asset-cell" role="cell">
            {row.top_assets.slice(0, 3).map((asset) => (
              <span>
                <strong>{asset.display}</strong>
                <small>{pctLabel(asset.average_allocation_pct)} avg</small>
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll("[data-recent-winner-benchmark]").forEach((root) => {
      const tabs = Array.from(root.querySelectorAll("[data-recent-winner-tab]"));
      const panels = Array.from(root.querySelectorAll("[data-recent-winner-panel]"));
      const activate = (track) => {
        tabs.forEach((tab) => {
          const active = tab.dataset.recentWinnerTab === track;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((panel) => {
          const active = panel.dataset.recentWinnerPanel === track;
          panel.classList.toggle("is-active", active);
          panel.hidden = !active;
        });
      };
      tabs.forEach((tab) => tab.addEventListener("click", () => activate(tab.dataset.recentWinnerTab)));
    });
  </script>

  <section class="section pattern-section" aria-labelledby="numbers-title">
    <div class="home-section-heading">
      <span class="panel-kicker">Key numbers</span>
      <h2 id="numbers-title">Behavior Metrics In One Table</h2>
      <p>
        These are cumulative allocation-behavior measures across eligible official saved portfolios. Performance remains
        available on the weekly and monthly leaderboards, but does not determine these behavior labels.
      </p>
    </div>

    <div class="pattern-number-table-shell">
      <table class="pattern-number-table">
        <thead>
          <tr>
            <th>Model</th>
            {keyMetricColumns.map(([, label]) => <th>{label}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">
                <a class="pattern-table-model-link" href={`/models/${row.model_id}/#model-behavior`}>
                  <span class="pattern-table-logo" aria-hidden="true">
                    {rowLogoSrc(row) ? <img src={rowLogoSrc(row)} alt="" loading="lazy" /> : row.provider_label.slice(0, 1)}
                  </span>
                  <span>{row.label}</span>
                </a>
              </th>
              {keyMetricColumns.map(([key]) => <td>{metricValue(row, key)}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {findings.length > 0 && (
    <section class="section pattern-section pattern-findings" aria-labelledby="findings-title">
      <div class="home-section-heading">
        <span class="panel-kicker">Comparative findings</span>
        <h2 id="findings-title">What Stands Out</h2>
        <p>Each finding is tied to model IDs and metric keys in the generated report.</p>
      </div>

      <div class="pattern-finding-grid">
        {findings.map((finding) => (
          <article>
            <span>{modelList(finding.model_ids)}</span>
            <h3>{finding.title}</h3>
            <p>{finding.body}</p>
            <div>
              {finding.supported_metric_keys.slice(0, 4).map((key) => <small>{key.replaceAll("_", " ")}</small>)}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section id="methodology" class="section pattern-method" aria-labelledby="methodology-title">
    <div class="pattern-method-copy">
      <span class="panel-kicker">Methodology</span>
      <h2 id="methodology-title">How Behavior Labels And Pills Are Determined</h2>
      <p>
        The report is rebuilt from eligible official frozen portfolios during every publication build. No model receives
        a manually assigned caption, and the model's own descriptive wording cannot assign its label.
      </p>
      <p>
        For each model and round, CapitalBench subtracts the median behavior-metric value of the other models in that same round.
        A behavior signal must exceed its published materiality floor, point in the same direction in at least
        {` ${report.sample_rules?.persistence_rate_pct ?? 65}%`} of matched portfolios, and have at least
        {` ${report.sample_rules?.stable_behavior_min_portfolios ?? 8}`} matched portfolios across
        {` ${report.sample_rules?.stable_behavior_min_decision_dates ?? 6}`} independent decision dates.
      </p>
      <p>
        Qualifying signals are ordered by absolute median peer difference divided by their materiality floor, then by
        persistence and a stable metric key. The strongest exposure or risk signal supplies the label modifier;
        peer-normalized construction, turnover, or overlap supplies the allocation-style noun.
      </p>
      <p>
        Evidence is “established” only after {behaviorMethod.rules?.established_minimum_decision_dates ?? 16} decision
        dates and {behaviorMethod.rules?.established_persistence_rate_pct ?? 75}% persistence. Opposite material weekly
        and monthly signals are marked horizon-dependent; a sufficiently sampled reversal under the newest methodology
        is marked evolving. The four pills always report signature, construction, tempo, and current open positioning
        (or lifecycle for a retired model). “Typical” uses all eligible history; “Now” uses only currently open portfolios.
      </p>
      <p>
        Realized returns, ranks, ineligible or pilot runs, market-briefing prose, and free-form rationale wording are not
        classification inputs. Structured candidate-ledger, forecast, confidence, and key-risk fields are retained as
        decision-process context when coverage exists, but they do not override allocation evidence. Page-level “most”
        leader cards use active models only; retired profiles remain available as historical evidence.
      </p>
      <p>
        Recent-winner tilt is a separate behavior measure and does not change the archetype. Each eligible asset receives
        a 0–100 percentile from its return before the decision cutoff, and the model's portfolio weights produce one
        allocation-weighted score. Current weekly portfolios use 5 trading sessions relative to SPY; monthly portfolios
        use 21. S&amp;P 500 and cash are neutral at 50, and future returns never enter the calculation.
      </p>
      <p class="pattern-provenance">
        Method version: <strong>{behaviorMethod.version ?? modelBehavior.method_version ?? "n/a"}</strong><br />
        Peer baseline: <strong>{modelBehavior.profiles?.[0]?.behavior_v2?.methodology?.comparison_baseline ?? "same-round peer median"}</strong><br />
        Wording provenance: <strong>{report.llm_provenance?.status ?? "deterministic source of truth"}</strong><br />
        Prompt contract: <strong>{report.llm_provenance?.prompt_version ?? "n/a"}</strong>
      </p>
      <a class="section-profile-link" href="/methodology/">Read the full CapitalBench benchmark methodology</a>
    </div>
    <div class="pattern-definition-list">
      <article class="pattern-signal-floor-card">
        <span>Qualification thresholds</span>
        <strong>Published materiality floors</strong>
        <p>A median same-round peer difference must meet the relevant floor before persistence can qualify it.</p>
        <ul>
          {signalFloors.map((dimension: any) => (
            <li><span>{dimension.label}</span><b>≥ {materialityFloorLabel(dimension)}</b></li>
          ))}
        </ul>
      </article>
      {metricDefinitions.map((metric: any) => (
        <article>
          <span>{metric.unit}</span>
          <strong>{metric.label}</strong>
          <p>{metric.definition}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
