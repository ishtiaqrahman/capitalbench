---
import BaseLayout from "../layouts/BaseLayout.astro";
import BenchmarkEvidencePanel from "../components/BenchmarkEvidencePanel.astro";
import GitHubLogo from "../components/GitHubLogo.astro";
import InsightStrip from "../components/InsightStrip.astro";
import LatestOfficialResultsTabs from "../components/LatestOfficialResultsTabs.astro";
import MarketRegimePreview from "../components/MarketRegimePreview.astro";
import ModelRiskBenchmark from "../components/ModelRiskBenchmark.astro";
import TrackScorecardTabs from "../components/TrackScorecardTabs.astro";
import {
  ArrowRight,
  BarChart3,
  ClipboardCheck,
  Database,
  Info,
  Layers3,
  LineChart,
  LockKeyhole,
  TimerReset
} from "lucide-react";
import {
  providerLabel,
  rounds as fallbackRounds
} from "../data/fallback";
import apiReadModel from "../generated/apiReadModel.js";
import {
  decisionAllocations
} from "../lib/allocations";
import {
  currentRiskDateLabel,
  dateFromRoundId,
  pairedPulseDateLabel,
  shortMonthDay,
  signedPulseChangeLabel
} from "../lib/riskFormatting.js";
import {
  staticAllOfficialSubmissions,
  staticAllWeeklyPerformance,
  staticOfficialSubmissions,
  staticRoundRecords,
  staticUniverseOptions
} from "../lib/localRoundRecords";
import { providerLogoSrc } from "../lib/scoreReturnChart";
import { benchmarkSetToScorecard, featuredBenchmarkSet } from "../lib/benchmarkSets";
import type { TrackScorecardData } from "../lib/trackScorecard";
import { siteConfig } from "../lib/seo";
import { buildLatestOfficialResultTracks } from "../lib/latestOfficialResults";
import { insightsForSurface } from "../lib/insights.js";
import {
  latestRoundForTrack,
  roundTrack
} from "../lib/tracks";

const roundRows = staticRoundRecords();
const latestWeeklyRound = latestRoundForTrack(roundRows, "weekly");
const latestMonthlyRound = latestRoundForTrack(roundRows, "monthly");
const allOfficialSubmissions = staticAllOfficialSubmissions(roundRows);
const pendingRoundCount = roundRows.filter((round) => round.status === "pending").length;
const weeklyScorecard = benchmarkSetToScorecard(featuredBenchmarkSet(apiReadModel, "weekly")) as TrackScorecardData | null;
const monthlyScorecard = benchmarkSetToScorecard(featuredBenchmarkSet(apiReadModel, "monthly")) as TrackScorecardData | null;
const aggregateScorecards = [
  monthlyScorecard,
  weeklyScorecard
].filter((scorecard): scorecard is NonNullable<typeof scorecard> => scorecard !== null);

const latestOfficialResultTracks = buildLatestOfficialResultTracks(roundRows);
const activeExposureRounds = roundRows
  .filter((round) => round.status === "pending" && round.official_run_id)
  .map((round) => {
    const track = roundTrack(round);
    return {
      round,
      track,
      submissions: staticOfficialSubmissions(round.round_id, round.official_run_id),
      options: staticUniverseOptions(round.round_id)
    };
  })
  .filter((item) => (item.track === "weekly" || item.track === "monthly") && item.submissions.length > 0);
const livePerformanceRows = staticAllWeeklyPerformance(roundRows).filter((row) => row.status === "pending");
const openRoundCounts = {
  all: activeExposureRounds.length,
  weekly: activeExposureRounds.filter((item) => item.track === "weekly").length,
  monthly: activeExposureRounds.filter((item) => item.track === "monthly").length
};
const livePortfolioCount = activeExposureRounds.reduce((total, item) => total + item.submissions.length, 0);
const liveHeldAssetCount = new Set(
  activeExposureRounds.flatMap((item) =>
    item.submissions.flatMap((submission) => decisionAllocations(submission).map((allocation) => allocation.option_id))
  )
).size;
const latestLiveCloseDate = livePerformanceRows
  .map((row) => row.price_date)
  .filter(Boolean)
  .sort()
  .at(-1);
const nextLiveScoreDate = activeExposureRounds
  .map((item) => item.round.score_eta_utc || item.round.exit_date)
  .filter(Boolean)
  .sort()[0];
const liveRiskSnapshot = apiReadModel.risk_appetite;
const currentRiskPulse = liveRiskSnapshot.current_decision_pulse;
const outstandingBookRisk = liveRiskSnapshot.outstanding_live_book;
const riskPulseTopAssets = currentRiskPulse.top_assets.slice(0, 6);
const riskPulseRegimes = currentRiskPulse.regime_exposure.slice(0, 5);
const riskPositioningDateLabel = currentRiskDateLabel(currentRiskPulse, "Latest live portfolios");
const riskPreviousDateLabel = pairedPulseDateLabel(
  dateFromRoundId(currentRiskPulse.previous_round_ids?.weekly),
  dateFromRoundId(currentRiskPulse.previous_round_ids?.monthly)
);
const riskChangeLabel = riskPreviousDateLabel ? `Change vs ${riskPreviousDateLabel} portfolios` : "Change vs earlier portfolios";
const homeInsights = insightsForSurface(apiReadModel, "home", 3);
const modelBehavior: any = apiReadModel.model_behavior ?? { summary: {}, profiles: [], methodology_href: "/risk-appetite/#model-behavior-methodology" };
const modelPatternReport = modelBehavior.pattern_report ?? { rows: [], comparative_findings: [], summary: {} };
const modelPatternRows = Array.isArray(modelPatternReport.rows) ? modelPatternReport.rows : [];
const heroModelBehaviorRows = modelPatternRows.slice(0, 6);
const latestUniverseOptionCount = Math.max(
  latestMonthlyRound ? staticUniverseOptions(latestMonthlyRound.round_id).length : 0,
  latestWeeklyRound ? staticUniverseOptions(latestWeeklyRound.round_id).length : 0
);
const currentRound = latestMonthlyRound ?? latestWeeklyRound ?? roundRows[0] ?? fallbackRounds[0];
const currentUniverseOptionCount = latestUniverseOptionCount || staticUniverseOptions(currentRound.round_id).length;
const modelRoster = Array.from(new Map(allOfficialSubmissions.map((submission) => [submission.model_id, submission])).values())
  .sort((a, b) => providerLabel(a.provider).localeCompare(providerLabel(b.provider)));
const exploreLinks = [
  {
    href: "/leaderboards/latest",
    icon: BarChart3,
    label: "Latest benchmark results",
    description: "See which model performed best in completed rounds.",
    state: "Results"
  },
  {
    href: "/rounds",
    icon: Layers3,
    label: "All rounds",
    description: "Open reports, model portfolios, prices, and audit packets.",
    state: `${roundRows.length} rounds`
  },
  {
    href: "/methodology",
    icon: TimerReset,
    label: "Methodology",
    description: "Same report, same choices, frozen portfolios, real prices.",
    state: "Plain rules"
  }
];
const heroTestSteps = [
  {
    icon: ClipboardCheck,
    label: "1",
    title: "Same report",
    description: "Every model reads the same market report."
  },
  {
    icon: Database,
    label: "2",
    title: "Same choices",
    description: `Every model chooses from the same ${currentUniverseOptionCount} assets.`
  },
  {
    icon: LockKeyhole,
    label: "3",
    title: "First portfolio locks",
    description: "Each model's saved portfolio is frozen before results are known."
  },
  {
    icon: TimerReset,
    label: "4",
    title: "Fixed wait window",
    description: "The frozen portfolio sits untouched for 7 days or 1 month."
  },
  {
    icon: LineChart,
    label: "5",
    title: "Prices score it",
    description: "Real ending prices decide which model did best."
  }
];
function pctValue(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  if (Math.abs(value) >= 10) return `${value.toFixed(1)}%`;
  if (Math.abs(value) >= 1) return `${value.toFixed(1)}%`;
  return `${value.toFixed(2)}%`;
}

function assetLabelWithTicker(asset: { label?: string; ticker?: string; option_id?: string } | null | undefined): string {
  if (!asset) return "n/a";
  const label = asset.label || asset.option_id || "n/a";
  return asset.ticker ? `${label} (${asset.ticker})` : label;
}

function pulseScore(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "n/a";
  return value.toFixed(1);
}

function pulseScoreWithUnitText(value: number | null | undefined): string {
  const score = pulseScore(value);
  return score === "n/a" ? score : `${score}/100`;
}

function heroBehaviorEvidenceTone(label: string): string {
  const normalized = label.toLowerCase();
  if (normalized.includes("risk")) return "risk";
  if (normalized.includes("turnover") || normalized.includes("consensus") || normalized.includes("balanced")) return "stability";
  if (normalized.includes("tech")) return "technology";
  if (normalized.includes("international") || normalized.includes("defensive") || normalized.includes("real-asset")) return "diversifier";
  if (normalized.includes("concentrated") || normalized.includes("top holding")) return "conviction";
  if (normalized.includes("binary") || normalized.includes("different") || normalized.includes("distinctive")) return "distinctive";
  if (normalized.includes("early") || normalized.includes("sample")) return "sample";
  return "neutral";
}

function heroBehaviorEvidence(row: any): { label: string; evidence?: string; tone: string }[] {
  const traits = Array.isArray(row.traits) ? row.traits : [];
  const pills = traits
    .slice(0, 4)
    .map((trait: any) => {
      const label = String(trait.label ?? "").trim();
      return {
        label,
        evidence: trait.evidence,
        tone: heroBehaviorEvidenceTone(label)
      };
    })
    .filter((pill: { label: string }) => pill.label.length > 0);
  const keyNumbers = row.key_numbers ?? {};
  const fallbackPills = [
    {
      label: `Risk ${pulseScoreWithUnitText(keyNumbers.risk_taking_score)}`,
      evidence: "Average risk-taking score across official saved portfolios.",
      tone: "risk"
    },
    {
      label: `Top holding ${pctValue(keyNumbers.average_top_allocation_pct)}`,
      evidence: "Average largest holding in the model's saved portfolios.",
      tone: "conviction"
    },
    {
      label: `Tech tilt ${pctValue(keyNumbers.tech_pct)}`,
      evidence: "Average technology-linked allocation.",
      tone: "technology"
    },
    {
      label: `Turnover ${pctValue(keyNumbers.average_turnover_pct)}`,
      evidence: "Average portfolio turnover between comparable rounds.",
      tone: "stability"
    }
  ].filter((pill) => !pill.label.includes("n/a"));

  for (const pill of fallbackPills) {
    if (pills.length >= 4) break;
    if (!pills.some((existing: { label: string }) => existing.label.toLowerCase() === pill.label.toLowerCase())) {
      pills.push(pill);
    }
  }

  return pills.slice(0, 4);
}

function signedPulseChange(value: number | null | undefined): string {
  return signedPulseChangeLabel(value);
}

function riskWidth(value: number | null | undefined): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return "0%";
  return `${Math.min(100, Math.max(0, value)).toFixed(2)}%`;
}
---

<BaseLayout
  title="CapitalBench - AI Capital Allocation Benchmark"
  description="CapitalBench tracks live AI model portfolios, current AI positioning, risk appetite, and benchmark results scored against real market returns."
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="eyebrow">CapitalBench</p>
      <h1 id="home-title">The benchmark <span class="hero-title-bridge">for AI capital</span> <span class="hero-title-tail">allocation</span></h1>
      <p class="home-hero-lede">
        AI models get the same market brief and choose their own portfolios. We track how those portfolios perform in the real market.
      </p>
      <p class="home-hero-sublede hero-rotating-sublede">
        <span class="sr-only">
          See how AI models perform against each other, how they invest and take risk, and how they perform in the real market.
        </span>
        <span class="hero-rotating-copy" aria-hidden="true">
          <span class="hero-rotating-prefix">See how AI models</span>
          <span class="hero-rotating-window">
            <span class="hero-rotating-phrase">perform against each other.</span>
            <span class="hero-rotating-phrase">invest and take risk.</span>
            <span class="hero-rotating-phrase">perform in the real market.</span>
          </span>
        </span>
      </p>
      <a class="hero-manifesto-link" href="/manifesto">Read the CapitalBench Manifesto</a>

      <div class="home-hero-actions" aria-label="Project resources">
        <a class="action-link action-primary" href="/live/">
          Open Live Positions & Returns
          <ArrowRight size={15} aria-hidden="true" />
        </a>
        <a class="action-link" href="#score-alert-panel-home" data-score-alert-trigger>Get score alerts</a>
        <a class="action-link" href="/api">Request API access</a>
      </div>
    </div>

    {heroModelBehaviorRows.length > 0 && (
      <div class="home-hero-console hero-behavior-card hero-positioning-card-desktop" aria-label="Model behavior pattern snapshot">
        <div class="console-header">
          <div class="console-title">
            <img src="/benchmark-panel.svg" alt="" width="42" height="42" loading="eager" />
            <div>
              <span>Model behavior patterns</span>
              <strong>How do AI models allocate differently?</strong>
            </div>
          </div>
          <span class="hero-behavior-count">{heroModelBehaviorRows.length} models</span>
        </div>

        <div class="hero-behavior-list" aria-label="Model behavior summaries">
          {heroModelBehaviorRows.map((row: any) => {
            const logoSrc = providerLogoSrc(row.provider);
            return (
              <a class="hero-behavior-row" href={`/models/${row.model_id}/#model-behavior`}>
                <span class="hero-behavior-model">
                  <span class="hero-behavior-logo">
                    {logoSrc ? (
                      <img src={logoSrc} alt="" width="30" height="30" loading="lazy" />
                    ) : (
                      <span>{row.provider_label?.charAt(0) ?? row.label?.charAt(0) ?? "M"}</span>
                    )}
                  </span>
                  <span>
                    <strong>{row.label}</strong>
                    <small>{row.provider_label}</small>
                  </span>
                </span>
                <span class="hero-behavior-copy">
                  <strong>{row.archetype?.label ?? "Behavior profile"}</strong>
                  <span class="hero-behavior-pills">
                    {heroBehaviorEvidence(row).map((pill) => (
                      <em class:list={[`is-${pill.tone}`]} title={pill.evidence}>{pill.label}</em>
                    ))}
                  </span>
                </span>
              </a>
            );
          })}
        </div>

        <a class="hero-behavior-cta" href="/models/patterns/">
          See full behavior
          <ArrowRight size={15} aria-hidden="true" />
        </a>
      </div>
    )}
  </section>

  <TrackScorecardTabs scorecards={aggregateScorecards} />

  <LatestOfficialResultsTabs tracks={latestOfficialResultTracks} />

  {heroModelBehaviorRows.length > 0 && (
    <div class="home-hero-console hero-behavior-card hero-positioning-card-mobile" aria-label="Model behavior pattern snapshot">
      <div class="console-header">
        <div class="console-title">
          <img src="/benchmark-panel.svg" alt="" width="42" height="42" loading="lazy" />
          <div>
            <span>Model behavior patterns</span>
            <strong>How do AI models allocate differently?</strong>
          </div>
        </div>
        <span class="hero-behavior-count">{heroModelBehaviorRows.length} models</span>
      </div>

      <div class="hero-behavior-list" aria-label="Model behavior summaries">
        {heroModelBehaviorRows.map((row: any) => {
          const logoSrc = providerLogoSrc(row.provider);
          return (
            <a class="hero-behavior-row" href={`/models/${row.model_id}/#model-behavior`}>
              <span class="hero-behavior-model">
                <span class="hero-behavior-logo">
                  {logoSrc ? (
                    <img src={logoSrc} alt="" width="30" height="30" loading="lazy" />
                  ) : (
                    <span>{row.provider_label?.charAt(0) ?? row.label?.charAt(0) ?? "M"}</span>
                  )}
                </span>
                <span>
                  <strong>{row.label}</strong>
                  <small>{row.provider_label}</small>
                </span>
              </span>
              <span class="hero-behavior-copy">
                <strong>{row.archetype?.label ?? "Behavior profile"}</strong>
                <span class="hero-behavior-pills">
                  {heroBehaviorEvidence(row).map((pill) => (
                    <em class:list={[`is-${pill.tone}`]} title={pill.evidence}>{pill.label}</em>
                  ))}
                </span>
              </span>
            </a>
          );
        })}
      </div>

      <a class="hero-behavior-cta" href="/models/patterns/">
        See full behavior
        <ArrowRight size={15} aria-hidden="true" />
      </a>
    </div>
  )}

  <MarketRegimePreview />

  <section class="home-question-heading" id="ai-positioning" aria-labelledby="ai-positioning-title">
    <div>
      <span class="panel-kicker">AI positioning</span>
      <div class="home-question-title">
        <h2 id="ai-positioning-title">What are AI models doing <span class="no-orphan">right now?</span></h2>
        <span class="home-info-tip" tabindex="0" aria-label="Live positioning uses frozen portfolios that have not reached final scoring yet.">
          <Info size={15} aria-hidden="true" />
        </span>
      </div>
      <p>Live allocations before the next official score.</p>
    </div>
  </section>

  <section class="ai-positioning-summary" aria-label="Current AI positioning highlights">
    <span class="ai-positioning-summary-date">{riskPositioningDateLabel}</span>
    <article>
      <span>Current risk appetite</span>
      <span class="ai-positioning-date">{riskPositioningDateLabel}</span>
      <strong class="risk-score-with-unit">{pulseScore(currentRiskPulse.score)}<small>/100</small></strong>
      <em>{currentRiskPulse.label} / {currentRiskPulse.regime}</em>
    </article>
    <article>
      <span>Consensus allocation</span>
      <span class="ai-positioning-date">{riskPositioningDateLabel}</span>
      <strong>{riskPulseTopAssets[0] ? pctValue(riskPulseTopAssets[0].allocation_pct) : "No allocation"}</strong>
      <em>{riskPulseTopAssets[0] ? `${assetLabelWithTicker(riskPulseTopAssets[0])} average live weight` : "No live allocation"}</em>
    </article>
    <article>
      <span>Risk shift</span>
      <span class="ai-positioning-date">{riskPositioningDateLabel}</span>
      <strong class:list={{ "is-negative": Number(currentRiskPulse.change_from_previous) < 0 }}>
        {signedPulseChange(currentRiskPulse.change_from_previous)}
      </strong>
      <em>{riskChangeLabel}</em>
    </article>
    <article>
      <span>Model agreement</span>
      <span class="ai-positioning-date">{riskPositioningDateLabel}</span>
      <strong>{currentRiskPulse.agreement.label}</strong>
      <em>{pulseScore(currentRiskPulse.agreement.standard_deviation)} point dispersion</em>
    </article>
  </section>

  <section class="live-risk-pulse live-risk-pulse-compact" aria-label="Current AI risk appetite detail">
    <div class="live-risk-pulse-grid">
      <article class="live-risk-pulse-primary">
        <div class="live-risk-pulse-score">
          <span>Current risk appetite</span>
          <strong class="risk-score-with-unit">{pulseScore(currentRiskPulse.score)}<small>/100</small></strong>
          <em>{riskPositioningDateLabel} / {currentRiskPulse.label}</em>
        </div>

        <div class="live-risk-pulse-body">
          <div class="live-risk-pulse-regime">
            <span>{riskPositioningDateLabel}</span>
            <strong>{currentRiskPulse.regime}</strong>
            <small>Combined view of monthly and weekly model portfolios for this date.</small>
          </div>

          <div class="live-risk-scale" aria-label={`Current AI Risk Appetite ${pulseScore(currentRiskPulse.score)} out of 100`}>
            <div class="live-risk-scale-labels" aria-hidden="true">
              <span>Defensive</span>
              <span>Balanced</span>
              <span>Aggressive</span>
            </div>
            <div class="live-risk-pulse-meter">
              <span class="risk-pulse-band is-defensive"></span>
              <span class="risk-pulse-band is-cautious"></span>
              <span class="risk-pulse-band is-balanced"></span>
              <span class="risk-pulse-band is-seeking"></span>
              <span class="risk-pulse-band is-aggressive"></span>
              <i style={`--pulse-position: ${riskWidth(currentRiskPulse.score)}`} data-reveal-meter="true"></i>
            </div>
            <div class="live-risk-pulse-ticks" aria-hidden="true">
              <span>0</span>
              <span>50</span>
              <span>100</span>
            </div>
          </div>

          <div class="live-risk-pulse-compare">
            <span>Unscored portfolios</span>
            <strong class="risk-score-with-unit">{pulseScore(outstandingBookRisk.score)}<small>/100</small></strong>
            <em>Separate read across every open portfolio before official scoring.</em>
          </div>
        </div>
      </article>

      <div class="live-risk-pulse-detail">
        <div>
          <span class="metric-label">Largest current allocations</span>
          <div class="live-risk-driver-list">
            {riskPulseTopAssets.map((asset) => (
              <span>
                <strong>{assetLabelWithTicker(asset)}</strong>
                <em>{pctValue(asset.allocation_pct)}</em>
              </span>
            ))}
          </div>
        </div>
        <div>
          <span class="metric-label">Regime mix</span>
          <div class="live-risk-regime-list">
            {riskPulseRegimes.map((regime) => (
              <span>
                <strong>{regime.label}</strong>
                <i><b style={`width: ${riskWidth(regime.allocation_pct)}`} data-reveal-bar="horizontal"></b></i>
                <em>{pctValue(regime.allocation_pct)}</em>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="home-section-cta" aria-label="Current AI positioning links">
    <a class="home-primary-cta" href="/live/#live-positions">
      Inspect current frozen portfolios
      <ArrowRight size={16} aria-hidden="true" />
    </a>
    <a class="home-secondary-cta" href="/risk-appetite">View historical risk trend</a>
  </div>

  <ModelRiskBenchmark modelBehavior={modelBehavior} variant="home" />

  <InsightStrip
    id="benchmark-insights"
    kicker="Benchmark insights"
    title="What do the latest AI decisions suggest?"
    description="The clearest signals from current portfolios and completed tests."
    insights={homeInsights}
    viewAllHref="/insights"
    viewAllLabel="Open full insight feed"
    featured
  />

  <section class="benchmark-process-card benchmark-process-section benchmark-trust-section" id="how-it-works" aria-label="CapitalBench methodology and evidence summary">
    <div class="home-question-heading home-question-heading-in-panel">
      <div>
        <span class="panel-kicker">Trust and proof</span>
        <div class="home-question-title">
          <h2>How does CapitalBench keep <span class="no-orphan">scores comparable?</span></h2>
          <span class="home-info-tip" tabindex="0" aria-label="The benchmark controls the brief, asset menu, portfolio freeze, scoring window, and audit trail.">
            <Info size={15} aria-hidden="true" />
          </span>
        </div>
        <p>Same brief, same choices, frozen portfolios, real prices.</p>
      </div>
    </div>

    <ol class="benchmark-process-list">
      {heroTestSteps.map((step) => {
        const Icon = step.icon;
        return (
        <li>
          <span class="benchmark-process-node">
            <Icon size={20} aria-hidden="true" />
          </span>
          <div class="benchmark-process-copy">
            <span class="benchmark-process-index">Step {step.label}</span>
            <strong>{step.title}</strong>
            <p>{step.description}</p>
          </div>
        </li>
        );
      })}
    </ol>

    <aside class="benchmark-protocol-callout" aria-label="Single-turn non-agentic protocol">
      <div>
        <span class="panel-kicker">Protocol</span>
        <strong>Single-turn, non-agentic benchmark</strong>
        <p>Models do not run as agents. Each model receives the brief once, returns one portfolio, and does not browse, call tools, or revise its answer.</p>
      </div>
      <div class="benchmark-protocol-pills" aria-label="Protocol controls">
        <span>One model call</span>
        <span>No tools</span>
        <span>No follow-up</span>
        <span>One portfolio</span>
      </div>
    </aside>

    <BenchmarkEvidencePanel
      evidence={apiReadModel.benchmark_evidence}
      tracks={["monthly", "weekly"]}
      title="What evidence supports each score?"
      description="Equal-run rules, score scale, and audit context for monthly and weekly tracks."
      compact
      showMethodologyLink={false}
    />

    <div class="home-section-cta" aria-label="Benchmark methodology links">
      <a class="home-primary-cta" href="/methodology">
        Read full methodology
        <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a class="home-secondary-cta" href="/scoring/#capitalbench-score">See score methodology</a>
    </div>
  </section>

  <section class="current-setup-panel" aria-labelledby="current-setup-title">
    <div class="current-setup-head home-question-heading home-question-heading-in-panel">
      <span class="panel-kicker">Benchmark universe</span>
      <div class="home-question-title">
        <h2 id="current-setup-title">What can models <span class="no-orphan">choose from?</span></h2>
        <span class="home-info-tip" tabindex="0" aria-label="The universe summary shows the current model roster, asset menu, horizons, and open rounds.">
          <Info size={15} aria-hidden="true" />
        </span>
      </div>
      <p>The active roster, asset menu, horizons, and open rounds.</p>
    </div>

    <div class="current-setup-stat-row" aria-label="Current CapitalBench setup summary">
      <div>
        <span>Models</span>
        <strong data-count-token>{modelRoster.length}</strong>
      </div>
      <div>
        <span>Asset choices</span>
        <strong data-count-token>{currentUniverseOptionCount}</strong>
      </div>
      <div>
        <span>Round lengths</span>
        <strong data-count-token>2</strong>
      </div>
      <div>
        <span>Open rounds</span>
        <strong data-count-token>{pendingRoundCount}</strong>
      </div>
      <div class="current-setup-protocol-stat">
        <span>Protocol</span>
        <strong>Single-turn</strong>
        <em>Non-agentic calls</em>
      </div>
    </div>

    <div class="home-section-cta current-setup-actions" aria-label="Benchmark universe links">
      <a class="home-primary-cta" href="/models">
        Explore models
        <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a class="home-secondary-cta" href="/universe">View asset universe</a>
      <a class="home-secondary-cta" href="/live/">Open live dashboard</a>
    </div>
  </section>

  <section class="live-dashboard-promo" aria-labelledby="live-dashboard-promo-title">
    <div class="live-dashboard-promo-copy home-question-heading home-question-heading-in-panel">
      <span class="panel-kicker">Live dashboard</span>
      <div class="home-question-title">
        <h2 id="live-dashboard-promo-title">What is still <span class="no-orphan">in progress?</span></h2>
        <span class="home-info-tip" tabindex="0" aria-label="The live dashboard holds open portfolios, interim returns, and upcoming score dates.">
          <Info size={15} aria-hidden="true" />
        </span>
      </div>
      <p>Open portfolios, interim returns, and upcoming score dates.</p>
    </div>
    <div class="live-dashboard-promo-stats" aria-label="Live dashboard summary">
      <article>
        <span>Open rounds</span>
        <strong>{openRoundCounts.all}</strong>
        <em>{openRoundCounts.monthly} monthly / {openRoundCounts.weekly} weekly</em>
      </article>
      <article>
        <span>Frozen portfolios</span>
        <strong>{livePortfolioCount}</strong>
        <em>{liveHeldAssetCount} assets currently held</em>
      </article>
      <article>
        <span>Latest close</span>
        <strong>{shortMonthDay(latestLiveCloseDate)}</strong>
        <em>Live returns update before final scoring</em>
      </article>
      <article>
        <span>Next score</span>
        <strong>{shortMonthDay(nextLiveScoreDate)}</strong>
        <em>Official results publish after ending prices</em>
      </article>
    </div>
    <div class="home-section-cta live-dashboard-promo-actions" aria-label="Live dashboard links">
      <a class="home-primary-cta" href="/live/#live-positions">
        Open live positions and returns
        <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a class="home-secondary-cta" href="/live/#open-tests">Review open tests</a>
    </div>
  </section>

  <section class="audit-preview" id="proof-and-data" aria-labelledby="audit-preview-title">
    <div>
      <span class="panel-kicker">Audit packet</span>
      <div class="home-question-title">
        <h2 id="audit-preview-title">How can you verify <span class="no-orphan">the benchmark?</span></h2>
        <span class="home-info-tip" tabindex="0" aria-label="Audit packets expose reports, prompts, portfolios, prices, source reports, hashes, and result status.">
          <Info size={15} aria-hidden="true" />
        </span>
      </div>
      <p>Round packets expose the report, prompt, portfolios, prices, hashes, and result status.</p>
    </div>
    <div class="audit-preview-actions">
      {latestMonthlyRound && <a class="action-link action-primary" href={`/rounds/${latestMonthlyRound.round_id}/`}>Open monthly audit packet</a>}
      {latestWeeklyRound && <a class="action-link" href={`/rounds/${latestWeeklyRound.round_id}/`}>Open weekly audit packet</a>}
      <a class="action-link" href="/rounds">View all rounds</a>
      <a class="action-link" href={siteConfig.githubUrl} target="_blank" rel="noreferrer">
        <GitHubLogo size={15} />
        Repository
      </a>
    </div>
  </section>

  <nav class="view-switcher enhanced" aria-label="Explore CapitalBench">
    {exploreLinks.map((view) => {
      const Icon = view.icon;
      return (
        <a href={view.href}>
          <span class="view-icon" aria-hidden="true"><Icon size={18} /></span>
          <span class="view-copy">
            <strong>{view.label}</strong>
            <span>{view.description}</span>
          </span>
          <span class="view-state">{view.state}</span>
        </a>
      );
    })}
  </nav>

  <script>
    import "../scripts/homepageRevealAnimations";
  </script>

</BaseLayout>
